#!/usr/bin/env bash
#
# Единая точка запуска команд проекта. Сюда складываем всё, что гоняем руками.
#
# Как добавить команду: добавь ветку в case ниже. Строка `#:` после `)` —
# описание, оно само попадает в `./run help`.
#
set -euo pipefail
cd "$(dirname "$0")"

# Compose-файл выбираем по окружению — чтобы одна и та же `./run console ...`
# работала и на машине разработчика, и на проде без флагов:
#   • прод   — репо развёрнут в /var/www/… , поднят docker-compose.prod.yml;
#   • локаль — dev-стек docker-compose.yaml (docker compose берёт по умолчанию).
# Префикс прод-пути переопределяется переменной PROD_DIR_PREFIX.
COMPOSE=(docker compose)
if [[ "$PWD" == "${PROD_DIR_PREFIX:-/var/www}"/* ]]; then
  COMPOSE=(docker compose -f docker-compose.prod.yml)
fi

case "${1:-help}" in

  db-pull-prod) #: Снять полный дамп прод-БД и раскатать локально (флаги: ./run db-pull-prod -h)
    exec ./db-pull-prod.sh "${@:2}"
    ;;

  console) #: Symfony-консоль в php-fpm (авто локаль/прод): ./run console cache:clear
    exec "${COMPOSE[@]}" exec -w /app manager_php-fpm php bin/console "${@:2}"
    ;;

  help|-h|--help|"")
    echo "Использование: ./run <команда> [аргументы]"
    echo
    echo "Команды:"
    awk -F') #: ' '/^[[:space:]]+[a-z0-9:_-]+\) #: /{c=$1; sub(/^[[:space:]]+/,"",c); printf "  %-16s %s\n", c, $2}' "$0"
    ;;

  *)
    echo "Неизвестная команда: $1" >&2
    echo
    exec "$0" help
    ;;

esac
