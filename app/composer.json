{
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-redis": "*",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^3.3",
    "elasticsearch/elasticsearch": "^9.0",
    "gesdinet/jwt-refresh-token-bundle": "^2.2",
    "irazasyed/telegram-bot-sdk": "^3.15",
    "lexik/jwt-authentication-bundle": "^3.2",
    "longman/telegram-bot": "^0.83.1",
    "minishlink/web-push": "^10.0",
    "mpdf/mpdf": "^8.2",
    "nesbot/carbon": "^3.8",
    "oneup/flysystem-bundle": "^4.12",
    "phpoffice/phpspreadsheet": "^3.6",
    "phpoffice/phpword": "^1.2",
    "qossmic/deptrac-shim": "^1.0",
    "ramsey/uuid": "^4.9",
    "symfony/console": "8.0.*",
    "symfony/dotenv": "8.0.*",
    "symfony/flex": "^2",
    "symfony/form": "8.0.*",
    "symfony/framework-bundle": "8.0.*",
    "symfony/lock": "8.0.*",
    "symfony/mailer": "8.0.*",
    "symfony/messenger": "8.0.*",
    "symfony/monolog-bundle": "^4.0",
    "symfony/rate-limiter": "8.0.*",
    "symfony/redis-messenger": "8.0.*",
    "symfony/runtime": "8.0.*",
    "symfony/serializer": "8.0.*",
    "symfony/translation": "8.0.*",
    "symfony/twig-bundle": "8.0.*",
    "symfony/uid": "8.0.*",
    "symfony/ux-live-component": "^2.22",
    "symfony/ux-twig-component": "^2.22",
    "symfony/validator": "8.0.*",
    "symfony/webpack-encore-bundle": "^2.2",
    "symfony/yaml": "8.0.*",
    "tecnickcom/tcpdf": "^6.7",
    "twig/cssinliner-extra": "^3.18",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/string-extra": "^3.21",
    "twig/twig": ">=3.21 <3.29",
    "webmozart/assert": "^1.11"
  },
  "require-dev": {
    "dama/doctrine-test-bundle": "^8.6",
    "doctrine/doctrine-fixtures-bundle": "^4.0",
    "fakerphp/faker": "^1.23",
    "friendsofphp/php-cs-fixer": "^3.95",
    "liip/test-fixtures-bundle": "^3.9",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11",
    "rector/rector": "^2.0",
    "symfony/browser-kit": "8.0.*",
    "symfony/css-selector": "8.0.*",
    "symfony/maker-bundle": "^1.58",
    "symfony/phpunit-bridge": "^8.0"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.5.10"
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.0.*",
      "docker": false
    }
  }
}
