<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Waybills\Domain\Aggregate\Location\Location" table="waybills_location">
        <id name="id" type="uuid"><generator strategy="NONE"/></id>
        <field name="ownerId" column="owner_id" type="text"/>
        <field name="country" type="text"/>
        <field name="city" type="text"/>
        <field name="cityType" column="city_type" type="text" enum-type="App\Waybills\Domain\Aggregate\Route\SettlementType" nullable="true"/>
        <field name="street" type="text"/>
        <field name="house" type="text"/>
        <field name="enterprise" type="text" nullable="true"/>
        <field name="latitude" type="float" nullable="true"/>
        <field name="longitude" type="float" nullable="true"/>
        <field name="createdAt" column="created_at" type="precise_datetime_tz"/>
        <field name="updatedAt" column="updated_at" type="precise_datetime_tz"/>
    </entity>
</doctrine-mapping>
