<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Reports\Domain\Aggregate\Counterparty\Counterparty" table="reports_counterparty">
        <id name="id" type="string" length="36">
            <generator strategy="NONE"/>
        </id>
        <field name="title" type="string" length="100" unique="true"/>
        <field name="description" type="string" length="750" nullable="true"/>
        <!-- ИНН: Деплой 1 — nullable (legacy без ИНН), unique — PARTIAL-индексом в миграции (не unique="true",
             тот дал бы полный unique). Деплой 2 переведёт в NOT NULL + полный unique. -->
        <field name="tin" type="string" length="12" nullable="true"/>
    </entity>

</doctrine-mapping>
