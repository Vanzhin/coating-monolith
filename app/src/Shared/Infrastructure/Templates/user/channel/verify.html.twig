{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Верификация канала{% endblock %}

{% block body %}
    <div class="container py-3">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
                <div class="p-4 rounded-3 bg-body-tertiary"
                     data-controller="channel-verify"
                     data-channel-verify-send-url-value="{{ path('app_user_channel_verification_send_token') }}">

                    {% include 'user/channel/_messages.html.twig' with { form: verificationForm } only %}

                    <div class="text-center mb-4">
                        <h1 class="h4 fw-semibold mb-1">Верификация аккаунта</h1>
                        <p class="text-body-secondary mb-0">Подтвердите ваш канал связи</p>
                    </div>

                    {{ form_start(verificationForm, {
                        'attr': {
                            'novalidate': true,
                            'id': 'verification-form',
                            'data-action': 'submit->channel-verify#onSubmit'
                        },
                        'action': path('app_user_channel_verification')
                    }) }}

                    <div class="form-floating mb-3">
                        {{ form_widget(verificationForm.channel, {
                            'attr': {
                                'class': 'form-select' ~ (verificationForm.channel.vars.errors|length > 0 ? ' is-invalid' : ''),
                                'data-channel-verify-target': 'channel',
                                'data-action': 'change->channel-verify#onChannelChange'
                            }
                        }) }}
                        {{ form_label(verificationForm.channel) }}
                    </div>

                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-primary w-100"
                                data-channel-verify-target="sendBtn"
                                data-action="click->channel-verify#send">
                            <span data-channel-verify-target="sendText">Отправить код верификации</span>
                            <span data-channel-verify-target="timer" class="ms-1"></span>
                        </button>
                    </div>

                    <div class="form-floating mb-4">
                        {{ form_widget(verificationForm.token, {
                            'attr': {
                                'class': 'form-control channel-code-input' ~ (verificationForm.token.vars.errors|length > 0 ? ' is-invalid' : ''),
                                'data-channel-verify-target': 'token',
                                'data-action': 'input->channel-verify#onTokenInput',
                                'placeholder': 'Введите код',
                                'inputmode': 'numeric',
                                'maxlength': 6
                            }
                        }) }}
                        {{ form_label(verificationForm.token) }}
                    </div>

                    {{ form_rest(verificationForm) }}

                    <button class="btn btn-primary w-100" type="submit" data-channel-verify-target="submit">
                        Подтвердить код
                    </button>

                    {{ form_end(verificationForm) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
