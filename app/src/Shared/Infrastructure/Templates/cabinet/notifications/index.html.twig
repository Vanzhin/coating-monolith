{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Уведомления{% endblock %}

{% block body %}
    <main class="container-fluid py-3">
        {% block content %}
            <div class="container-fluid">
                {# Хедер + возврат в профиль. #}
                <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
                    <a href="{{ path('app_cabinet_profile') }}"
                       class="text-body-secondary text-decoration-none small d-inline-block mb-1">
                        <i class="bi bi-chevron-left"></i> Профиль
                    </a>
                    <h1 class="h3 mb-0">Уведомления</h1>
                </div>

                {# Список — единый infinite-list с кнопкой «Показать ещё» (по 10). Пустое состояние
                   рендерится внутри батча. Обёртка — цель live-обновления: по пушу (событие от service
                   worker) фронт перезапрашивает 1-ю страницу и перерисовывает список без перезагрузки. #}
                <div data-notifications-live-target="list">
                    {% include 'cabinet/notifications/_list.html.twig' %}
                </div>
            </div>
        {% endblock %}
    </main>
{% endblock %}
