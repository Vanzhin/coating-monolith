{% extends '/cabinet/index.html.twig' %}
{% block title %}{{ parent() }} | Путевой лист №{{ waybill.getNumber() }}{% endblock %}
{% block content %}
    <div class="p-2 p-md-3">
        <div class="d-flex align-items-center justify-content-between mb-3 p-3 rounded-3 bg-body-tertiary">
            <h2 class="text-body-emphasis mb-0">Путевой лист №{{ waybill.getNumber() }}</h2>
            <div class="d-flex gap-2 flex-wrap"><a href="{{ path('app_cabinet_waybill_sheet_list', {vehicleId: waybill.vehicleId()}) }}" class="btn btn-outline-secondary">Назад</a><a href="{{ path('app_cabinet_waybill_sheet_download', {id: waybill.getId()}) }}" class="btn btn-outline-secondary"><i class="bi bi-file-earmark-spreadsheet"></i> Скачать XLSX</a>{% if not waybill.isLocked() %} <a href="{{ path('app_cabinet_waybill_sheet_edit', {id: waybill.getId()}) }}" class="btn btn-primary">Редактировать</a><button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#approveWaybillModal"><i class="bi bi-check2"></i> Утвердить</button><button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteWaybillModal"><i class="bi bi-trash3"></i> Удалить</button>{% endif %}</div>
        </div>
        <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
            <div class="kv-grid">
                <div class="kvi"><span class="k">Автомобиль</span><span class="v">{{ waybill.vehicleModel() }} — {{ waybill.vehicleRegistrationNumber().value()|upper }}</span></div>
                <div class="kvi"><span class="k">Период</span><span class="v">{{ waybill.period().from().format('d.m.Y') }} — {{ waybill.period().to().format('d.m.Y') }}</span></div>
                <div class="kvi"><span class="k">Начальный одометр</span><span class="v">{{ waybill.odometerStart() }} км</span></div>
                <div class="kvi"><span class="k">Конечный одометр</span><span class="v">{{ waybill.odometerEndOrNull() is null ? 'Не указан' : waybill.odometerEndOrNull() ~ ' км' }}</span></div>
                <div class="kvi"><span class="k">Начальный остаток</span><span class="v">{{ waybill.fuelStart() }} л</span></div>
                {% set fuel = waybill.fuelOrNull() %}
                {% set refueledFuelTypes = waybill.refueledFuelTypes()|map(type => type.value) %}
                <div class="kvi"><span class="k">Заправлено</span><span class="v">{{ waybill.refuelingOperations().total() }} л</span></div>
                <div class="kvi"><span class="k">Марки топлива</span><span class="v">{{ refueledFuelTypes is empty ? 'Не указаны' : refueledFuelTypes|join(', ') }}</span></div>
                {% if fuel and fuel.refuelingsOrNull() %}<div class="kvi"><span class="k">Ранее сохранённые данные о заправках</span><span class="v">{{ fuel.refuelings().total() }} л</span></div>{% endif %}
                <div class="kvi"><span class="k">Конечный остаток</span><span class="v">{{ fuel and fuel.remainingOrNull() is not null ? fuel.remaining() ~ ' л' : 'Не указан' }}</span></div>
            </div>
        </div>
        <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
            <h6 class="fw-semibold mb-3">Заправки</h6>
            {% for operation in waybill.refuelingOperations().all() %}
                <div class="p-3 mb-2 rounded-3 bg-body">{{ operation.date.format('d.m.Y H:i:s') }} — {{ operation.fuelType.value }} — {{ operation.change }} л</div>
            {% else %}<div class="text-muted">Заправки не указаны.</div>{% endfor %}
        </div>
        <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
            <h6 class="fw-semibold mb-3">Периоды без поездок</h6>
            {% for absence in waybill.absences() %}
                <div class="p-3 mb-2 rounded-3 bg-body">{{ absence.from().format('d.m.Y H:i:s') }} — {{ absence.to().format('d.m.Y H:i:s') }}</div>
            {% else %}<div class="text-muted">Периоды без поездок не указаны.</div>{% endfor %}
        </div>
        <div class="p-3 rounded-3 bg-body-tertiary">
            <h6 class="fw-semibold mb-3">Поездки</h6>
            {% for trip in waybill.trips() %}
                <div class="p-3 mb-2 rounded-3 bg-body"><strong>{{ trip.date.format('d.m.Y H:i:s') }}</strong> — {{ trip.departure().toString() }} → {{ trip.destination.location.toString() }}{% if trip.destination.enterprise %}, {{ trip.destination.enterprise }}{% endif %} — {{ trip.distanceInKilometers() }} км</div>
            {% else %}<div class="text-muted">Поездки не указаны.</div>{% endfor %}
        </div>
    </div>
    {% if not waybill.isLocked() %}
        <div class="modal fade" id="approveWaybillModal" tabindex="-1" aria-labelledby="approveWaybillModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                <div class="modal-body"><h5 class="modal-title mb-2" id="approveWaybillModalLabel">Утвердить путевой лист?</h5><p class="text-body-secondary small mb-0">После утверждения лист нельзя изменить или удалить. Показания и журнал автомобиля будут обновлены.</p></div>
                <div class="modal-footer border-0 pt-0 d-flex gap-2">
                    <button type="button" class="btn btn-secondary flex-fill" data-bs-dismiss="modal">Отмена</button>
                    <form method="post" action="{{ path('app_cabinet_waybill_sheet_approve', {id: waybill.getId()}) }}" class="flex-fill m-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('waybill_approve_' ~ waybill.getId()) }}"><input type="hidden" name="version" value="{{ version }}">
                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-check2 me-1"></i>Утвердить</button>
                    </form>
                </div>
            </div></div>
        </div>
        <div class="modal fade" id="deleteWaybillModal" tabindex="-1" aria-labelledby="deleteWaybillModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                <div class="modal-body text-center pt-4 pb-2"><div class="del-ic"><i class="bi bi-trash3"></i></div><h5 class="modal-title mb-2" id="deleteWaybillModalLabel">Удалить черновик путевого листа?</h5><p class="text-body-secondary small mb-0">Вместе с ним удалятся его поездки и заправки. Действие необратимо.</p></div>
                <div class="modal-footer border-0 pt-0 d-flex gap-2">
                    <button type="button" class="btn btn-secondary flex-fill" data-bs-dismiss="modal">Отмена</button>
                    <form method="post" action="{{ path('app_cabinet_waybill_sheet_delete', {id: waybill.getId()}) }}" class="flex-fill m-0">
                        <input type="hidden" name="_token" value="{{ csrf_token('waybill_delete_' ~ waybill.getId()) }}"><input type="hidden" name="version" value="{{ version }}">
                        <button type="submit" class="btn btn-danger w-100"><i class="bi bi-trash3 me-1"></i>Удалить</button>
                    </form>
                </div>
            </div></div>
        </div>
    {% endif %}
{% endblock %}
