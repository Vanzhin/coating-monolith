<div id="sec-refuel" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
    <h6 class="fw-semibold mb-3"><span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary p-2 me-2"><i class="bi bi-fuel-pump"></i></span>Заправки</h6>
    <div class="row g-2">
        <div class="col-6 col-xl-3"><span class="form-label d-block">Начальный остаток, л</span><div class="p-2 rounded-3 bg-body fw-semibold">{{ input.initialFuel }}</div></div>
        <div class="col-6 col-xl-3"><label class="form-label" for="fuelRemaining">Конечный остаток, л</label><input id="fuelRemaining" name="fuelRemaining" value="{{ input.fuelRemaining }}" class="form-control" type="number" min="0" step="any"></div>
    </div>
    <div class="form-text mb-3">Неизвестный конечный остаток оставьте пустым.</div>
    {% if input.legacyRefuelingTotal is not null %}
        <div class="form-text">Ранее сохранённые данные о заправках: {{ input.legacyRefuelingTotal }} л. Они сохранятся без изменений.</div>
    {% endif %}
    <div id="refueling-rows" data-waybill-form-target="refuelingRows">
        {% for refueling in input.refuelings %}
            {% include 'cabinet/waybill/sheet/_refueling_row.html.twig' with {refueling: refueling, index: loop.index0, number: loop.index} %}
        {% endfor %}
    </div>
    {% set blankRefueling = {id: '', date: '', fuelType: input.defaultFuelType, quantity: ''} %}
    <template data-waybill-form-target="refuelingTemplate">{% include 'cabinet/waybill/sheet/_refueling_row.html.twig' with {refueling: blankRefueling, index: '__i__', number: 1} %}</template>
    <button type="button" class="btn btn-soft-success btn-sm w-100" data-action="click->waybill-form#add" data-waybill-form-kind-param="refueling"><i class="bi bi-plus-lg me-1"></i> Добавить заправку</button>
    {% if creating and (input.initialOdometer is not same as(input.currentVehicleOdometer) or input.initialFuel is not same as(input.currentVehicleFuel)) %}
        <div class="form-text">Показания автомобиля изменились. Обновите их и проверьте введённые данные.</div>
        <button type="submit" name="action" value="refresh_readings" class="btn btn-outline-secondary btn-sm">Обновить начальные показания</button>
    {% endif %}
    <div class="form-text">Пустой список заправок означает нулевое пополнение.</div>
</div>
