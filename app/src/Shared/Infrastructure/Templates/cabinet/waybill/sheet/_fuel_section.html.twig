<section id="sec-refuel" class="wb-card fsec" data-form-scrollspy-target="section">
    <div class="wb-sec-head">
        <span class="wb-sec-tile"><i class="bi bi-fuel-pump"></i></span>
        <h2 class="wb-sec-title">Заправки</h2>
        {% if not locked %}<button type="button" class="wb-add" data-action="click->waybill-form#add" data-waybill-form-kind-param="refueling"><i class="bi bi-plus-lg"></i> Добавить заправку</button>{% endif %}
    </div>
    <div class="wb-summary mb-2">
        <div class="wb-summary-item">
            <span class="wb-summary-k">Начальный остаток</span>
            <span class="wb-summary-v">{{ input.initialFuel }} л</span>
        </div>
        <div class="wb-summary-item">
            <span class="wb-summary-k">Заправлено</span>
            <span class="wb-summary-v wb-summary-v--ok" data-waybill-form-target="refueledTotal">—</span>
        </div>
        <div class="wb-summary-item">
            <label class="wb-summary-k" for="fuelRemaining">Конечный остаток, л</label>
            <input id="fuelRemaining" name="fuelRemaining" value="{{ input.fuelRemaining }}" class="wb-summary-input" type="number" min="0" step="any" required>
        </div>
    </div>
    <div class="wb-hint mb-2">Конечный остаток обязателен. Если бак пуст — укажите 0.</div>
    {% if input.legacyRefuelingTotal is not null %}
        <div class="wb-hint mb-2">Ранее сохранённые данные о заправках: {{ input.legacyRefuelingTotal }} л. Они сохранятся без изменений.</div>
    {% endif %}
    <div id="refueling-rows" data-waybill-form-target="refuelingRows">
        {% for refueling in input.refuelings %}
            {% include 'cabinet/waybill/sheet/_refueling_row.html.twig' with {refueling: refueling, index: loop.index0, number: loop.index} %}
        {% endfor %}
    </div>
    <div class="wb-empty" data-waybill-form-target="refuelingEmpty" {% if input.refuelings is not empty %}hidden{% endif %}>
        <div class="wb-empty-title">Нет добавленных заправок</div>
        <div class="wb-empty-text">Добавьте заправку, если топливо пополнялось в этом периоде</div>
    </div>
    {% set blankRefueling = {id: '', date: '', fuelType: input.defaultFuelType, quantity: ''} %}
    <template data-waybill-form-target="refuelingTemplate">{% include 'cabinet/waybill/sheet/_refueling_row.html.twig' with {refueling: blankRefueling, index: '__i__', number: 1, isNew: true} %}</template>
    {% if creating and (input.initialOdometer is not same as(input.currentVehicleOdometer) or input.initialFuel is not same as(input.currentVehicleFuel)) %}
        <div class="wb-hint">Показания автомобиля изменились. Обновите их и проверьте введённые данные.</div>
        <button type="submit" name="action" value="refresh_readings" class="btn btn-outline-secondary btn-sm mt-2">Обновить начальные показания</button>
    {% endif %}
</section>
