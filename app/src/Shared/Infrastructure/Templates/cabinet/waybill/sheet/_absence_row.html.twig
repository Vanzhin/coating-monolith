<div class="p-2 mb-2 rounded-3 bg-body" data-waybill-form-target="absenceRow" data-row-label="Период">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-lg-auto order-lg-last pb-lg-1 d-flex justify-content-between align-items-center"><strong data-role="row-title" class="visually-hidden">Период {{ number }}</strong><button type="button" class="btn btn-sm btn-outline-danger" data-action="click->waybill-form#remove" data-waybill-form-kind-param="absence" title="Удалить период" aria-label="Удалить период"><i class="bi bi-trash"></i></button></div>
        <div class="col-md-5"><label class="form-label" for="absence-from-{{ index }}">Начало</label><input id="absence-from-{{ index }}" name="absences[{{ index }}][from]" value="{{ absence.from|slice(0, 10) }}" class="form-control" type="date"></div>
        <div class="col-md-5"><label class="form-label" for="absence-to-{{ index }}">Окончание</label><input id="absence-to-{{ index }}" name="absences[{{ index }}][to]" value="{{ absence.to|slice(0, 10) }}" class="form-control" type="date"></div>
    </div>
</div>
