<div class="p-3 mb-3 rounded-3 bg-body" data-waybill-form-target="absenceRow" data-row-label="Период">
    <div class="d-flex justify-content-between align-items-center mb-3"><strong data-role="row-title">Период {{ number }}</strong><button type="button" class="btn btn-sm btn-outline-danger" data-action="click->waybill-form#remove" data-waybill-form-kind-param="absence" title="Удалить период" aria-label="Удалить период"><i class="bi bi-trash"></i></button></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label" for="absence-from-{{ index }}">Начало</label><input id="absence-from-{{ index }}" name="absences[{{ index }}][from]" value="{{ absence.from }}" class="form-control" type="datetime-local" step="1"></div>
        <div class="col-md-6"><label class="form-label" for="absence-to-{{ index }}">Окончание</label><input id="absence-to-{{ index }}" name="absences[{{ index }}][to]" value="{{ absence.to }}" class="form-control" type="datetime-local" step="1"></div>
    </div>
</div>
