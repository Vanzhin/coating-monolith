<div class="p-3 mb-3 rounded-3 bg-body" data-waybill-form-target="refuelingRow" data-row-label="Заправка">
    <div class="d-flex justify-content-between align-items-center mb-3"><strong data-role="row-title">Заправка {{ number }}</strong><button type="button" class="btn btn-sm btn-outline-danger" data-action="click->waybill-form#remove" data-waybill-form-kind-param="refueling" title="Удалить заправку" aria-label="Удалить заправку"><i class="bi bi-trash"></i></button></div>
    <input type="hidden" name="refuelings[{{ index }}][id]" value="{{ refueling.id }}">
    <div class="row g-3">
        <div class="col-md-4"><label class="form-label" for="refueling-date-{{ index }}">Дата и время</label><input id="refueling-date-{{ index }}" name="refuelings[{{ index }}][date]" value="{{ refueling.date }}" class="form-control" type="datetime-local" step="1"></div>
        <div class="col-md-4"><label class="form-label" for="refueling-type-{{ index }}">Вид топлива</label><select id="refueling-type-{{ index }}" name="refuelings[{{ index }}][fuelType]" class="form-select"><option value="">Выберите</option>{% if refueling.fuelType and refueling.fuelType not in availableFuelTypes %}<option value="{{ refueling.fuelType }}" selected>{{ refueling.fuelType }}</option>{% endif %}{% for type in availableFuelTypes %}<option value="{{ type }}" {% if refueling.fuelType == type %}selected{% endif %}>{{ type }}</option>{% endfor %}</select></div>
        <div class="col-md-4"><label class="form-label" for="refueling-quantity-{{ index }}">Количество, л</label><input id="refueling-quantity-{{ index }}" name="refuelings[{{ index }}][quantity]" value="{{ refueling.quantity }}" class="form-control" type="number" min="0" step="any"></div>
    </div>
</div>
