<div data-waybill-form-target="tripRow" data-row-label="Поездка">
    <div class="p-3 mb-3 rounded-3 bg-body">
    {% set automatic = trip.origin|default('manual') == 'automatic' %}
    <div class="d-flex justify-content-between align-items-center mb-3"><div><strong data-role="row-title">Поездка {{ number }}</strong><span class="form-text ms-2">{{ automatic ? 'Автоматическая' : 'Ручная' }}</span></div><button type="button" class="btn btn-sm btn-outline-danger" data-action="click->waybill-form#remove" data-waybill-form-kind-param="trip" title="Удалить поездку" aria-label="Удалить поездку"><i class="bi bi-trash"></i></button></div>
    <input type="hidden" name="trips[{{ index }}][id]" value="{{ trip.id }}">
    <input type="hidden" name="trips[{{ index }}][origin]" value="{{ automatic ? 'automatic' : 'manual' }}">
    <input type="hidden" name="trips[{{ index }}][pairId]" value="{{ trip.pairId|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalDate]" value="{{ trip.originalDate|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalDistance]" value="{{ trip.originalDistance|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalLocationId]" value="{{ trip.originalLocationId|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalCountry]" value="{{ trip.originalCountry|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalCity]" value="{{ trip.originalCity|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalCityType]" value="{{ trip.originalCityType|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalStreet]" value="{{ trip.originalStreet|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalHouse]" value="{{ trip.originalHouse|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalEnterprise]" value="{{ trip.originalEnterprise|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalLatitude]" value="{{ trip.originalLatitude|default('') }}">
    <input type="hidden" name="trips[{{ index }}][originalLongitude]" value="{{ trip.originalLongitude|default('') }}">
    <div class="row g-3">
        <div class="col-12"><span class="form-label">Откуда</span><div data-role="departure">{{ [departure.country, departure.city, departure.street, departure.house]|filter(value => value)|join(', ') }}{% if departure.enterprise|default('') %}, {{ departure.enterprise }}{% endif %}</div></div>
        <div class="col-md-6"><label class="form-label" for="trip-date-{{ index }}">Дата</label><input id="trip-date-{{ index }}" name="trips[{{ index }}][date]" value="{{ trip.date }}" class="form-control" type="date"></div>
        <div class="col-md-6"><label class="form-label" for="trip-distance-{{ index }}">Расстояние, км</label><input id="trip-distance-{{ index }}" name="trips[{{ index }}][distance]" value="{{ trip.distance }}" class="form-control" type="number" min="1" step="1" data-action="input->waybill-form#recalculate"></div>
        {% include 'cabinet/waybill/location/_fields.html.twig' with {name: 'trips[' ~ index ~ ']', location: trip, key: 'trip-' ~ index, idField: 'locationId', inputAction: 'input->waybill-form#refreshTrips', settlementTypes: settlementTypes} %}
    </div>
    <div class="d-flex justify-content-center mb-3" data-role="trip-insertion" {% if not insertable %}hidden{% endif %}>
        <button type="button" class="btn btn-soft-success btn-sm" data-action="click->waybill-form#insert"><i class="bi bi-plus-lg me-1"></i>Вставить поездку</button>
    </div>
</div>
</div>
