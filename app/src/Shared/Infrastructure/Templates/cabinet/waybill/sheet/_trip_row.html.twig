{% set automatic = trip.origin|default('manual') == 'automatic' %}
{% set departureText = [departure.country, departure.city, departure.street, departure.house, departure.enterprise|default('')]|filter(value => value)|join(', ') %}
{% set destinationText = [trip.country|default(''), trip.city|default(''), trip.street|default(''), trip.house|default(''), trip.enterprise|default('')]|filter(value => value)|join(', ') %}
{% set hasContent = trip.date or trip.distance or destinationText %}
<div class="wb-trip-wrap{{ hasContent ? ' wb-trip--has-content' : '' }}" data-waybill-form-target="tripRow" data-row-label="Поездка">
    <details name="waybill-trips" class="wb-trip" data-action="input->waybill-form#refreshTripSummary change->waybill-form#refreshTripSummary">
        <summary class="wb-trip-summary" data-action="click->waybill-form#toggleTrip">
            <i class="bi bi-chevron-right wb-trip-caret" aria-hidden="true"></i>
            <span class="wb-trip-date" data-role="trip-date">{{ trip.date ? trip.date|slice(8, 2) ~ '.' ~ trip.date|slice(5, 2) ~ '.' ~ trip.date|slice(0, 4) : '' }}</span>
            <span class="wb-trip-route"><span class="from" data-role="departure">{{ departureText }}</span><span data-role="trip-arrow" aria-hidden="true"> → </span><b data-role="destination">{{ destinationText ?: 'Новая поездка' }}</b></span>
            <span class="wb-trip-dist" data-role="trip-distance">{{ trip.distance ? trip.distance ~ ' км' : '' }}</span>
            <span class="wb-badge {{ automatic ? 'wb-badge--auto' : 'wb-badge--manual' }}">{{ automatic ? 'Авто' : 'Ручная' }}</span>
        </summary>
        <div class="waybill-trip-content wb-trip-body">
            <strong data-role="row-title" class="visually-hidden">Поездка {{ number }}</strong>
            <input type="hidden" name="trips[{{ index }}][id]" value="{{ trip.id }}">
            <input type="hidden" name="trips[{{ index }}][origin]" value="{{ automatic ? 'automatic' : 'manual' }}">
            <input type="hidden" name="trips[{{ index }}][pairId]" value="{{ trip.pairId|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalDate]" value="{{ trip.originalDate|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalDistance]" value="{{ trip.originalDistance|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalLocationId]" value="{{ trip.originalLocationId|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalCountry]" value="{{ trip.originalCountry|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalCity]" value="{{ trip.originalCity|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalCityType]" value="{{ trip.originalCityType|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalStreet]" value="{{ trip.originalStreet|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalHouse]" value="{{ trip.originalHouse|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalEnterprise]" value="{{ trip.originalEnterprise|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalLatitude]" value="{{ trip.originalLatitude|default('') }}">
            <input type="hidden" name="trips[{{ index }}][originalLongitude]" value="{{ trip.originalLongitude|default('') }}">
            <div class="row g-2 mb-2">
                <div class="col-6">
                    {% include 'components/date_picker.html.twig' with {id: 'trip-date', index: index, name: 'trips[' ~ index ~ '][date]', value: trip.date, label: 'Дата'} %}
                </div>
                <div class="col-6">
                    <div class="wb-field"><div class="wb-field-body">
                        <label class="wb-field-label" for="trip-distance-{{ index }}">Расстояние, км</label>
                        <input id="trip-distance-{{ index }}" name="trips[{{ index }}][distance]" value="{{ trip.distance }}" class="wb-field-control" type="number" min="1" step="1" data-action="input->waybill-form#recalculate">
                    </div></div>
                </div>
            </div>
            <div class="wb-trip-from mb-1">
                <div class="wb-meta-k">ОТКУДА</div>
                <div class="wb-meta-v" data-role="departure">{{ departureText }}</div>
            </div>
            <div class="wb-trip-arrow" aria-hidden="true"><i class="bi bi-arrow-down"></i></div>
            {% include 'cabinet/waybill/location/_fields.html.twig' with {name: 'trips[' ~ index ~ ']', location: trip, key: 'trip-' ~ index, idField: 'locationId', inputAction: 'input->waybill-form#refreshTripLocations', settlementTypes: settlementTypes, card: true} %}
        </div>
    </details>
    {% if not locked %}<div class="dropdown wb-trip-menu">
        <button class="btn btn-sm btn-link text-body-secondary p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Действия с поездкой" title="Действия с поездкой"><i class="bi bi-three-dots-vertical"></i></button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li data-role="trip-insertion" {% if not insertable %}hidden{% endif %}><button type="button" class="dropdown-item" data-action="click->waybill-form#insert"><i class="bi bi-plus-lg me-2"></i>Добавить поездку ниже</button></li>
            <li><button type="button" class="dropdown-item text-danger" data-action="click->waybill-form#remove" data-waybill-form-kind-param="trip" title="Удалить поездку" aria-label="Удалить поездку"><i class="bi bi-trash me-2"></i>Удалить поездку</button></li>
        </ul>
    </div>{% endif %}
</div>
