<div data-waybill-form-target="tripRow" data-row-label="Поездка">
    {% set automatic = trip.origin|default('manual') == 'automatic' %}
    <div class="row g-0">
        <div class="col position-relative">
            <details class="p-3 mb-2 rounded-3 bg-body" data-action="input->waybill-form#refreshTripSummary change->waybill-form#refreshTripSummary">
                <summary class="pe-5">
                    <span class="row g-2 align-items-center">
                        <span class="col-4 col-md-2 text-truncate" data-role="trip-date">{{ trip.date ?: 'Дата не указана' }}</span>
                        <span class="col-8 col-md-6"><span class="d-block text-truncate text-body-secondary" data-role="departure">{{ [departure.country, departure.city, departure.street, departure.house, departure.enterprise|default('')]|filter(value => value)|join(', ') ?: 'Не указана' }}</span><strong class="d-block text-truncate"><span class="text-body-secondary fw-normal" aria-hidden="true">→ </span><span data-role="destination">{{ [trip.country|default(''), trip.city|default(''), trip.street|default(''), trip.house|default(''), trip.enterprise|default('')]|filter(value => value)|join(', ') ?: 'Не указана' }}</span></strong></span>
                        <span class="col-4 col-md-2 text-truncate" data-role="trip-distance">{{ trip.distance ? trip.distance ~ ' км' : 'Расстояние не указано' }}</span>
                        <span class="col-8 col-md-2 small text-body-secondary text-truncate"><i class="bi {{ automatic ? 'bi-arrow-repeat' : 'bi-pencil' }}" title="{{ automatic ? 'Автоматическая поездка' : 'Ручная поездка' }}" aria-label="{{ automatic ? 'Автоматическая поездка' : 'Ручная поездка' }}"></i> {{ automatic ? 'Автоматическая' : 'Ручная' }}</span>
                    </span>
                </summary>
                <input type="hidden" name="trips[{{ index }}][id]" value="{{ trip.id }}">
                <input type="hidden" name="trips[{{ index }}][origin]" value="{{ automatic ? 'automatic' : 'manual' }}">
                <input type="hidden" name="trips[{{ index }}][pairId]" value="{{ trip.pairId|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalDate]" value="{{ trip.originalDate|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalDistance]" value="{{ trip.originalDistance|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalLocationId]" value="{{ trip.originalLocationId|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalCountry]" value="{{ trip.originalCountry|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalCity]" value="{{ trip.originalCity|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalCityType]" value="{{ trip.originalCityType|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalStreet]" value="{{ trip.originalStreet|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalHouse]" value="{{ trip.originalHouse|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalEnterprise]" value="{{ trip.originalEnterprise|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalLatitude]" value="{{ trip.originalLatitude|default('') }}">
                <input type="hidden" name="trips[{{ index }}][originalLongitude]" value="{{ trip.originalLongitude|default('') }}">
                <div class="row g-3 mt-1">
                    <div class="col-md-6"><label class="form-label" for="trip-date-{{ index }}">Дата</label><input id="trip-date-{{ index }}" name="trips[{{ index }}][date]" value="{{ trip.date }}" class="form-control" type="date"></div>
                    <div class="col-md-6"><label class="form-label" for="trip-distance-{{ index }}">Расстояние, км</label><input id="trip-distance-{{ index }}" name="trips[{{ index }}][distance]" value="{{ trip.distance }}" class="form-control" type="number" min="1" step="1" data-action="input->waybill-form#recalculate"></div>
                    <div class="col-12"><div class="p-3 rounded-3 bg-body-tertiary"><span class="form-label d-block">Откуда</span><div class="fw-semibold" data-role="departure">{{ [departure.country, departure.city, departure.street, departure.house, departure.enterprise|default('')]|filter(value => value)|join(', ') ?: 'Не указана' }}</div></div></div>
                    <div class="col-12 text-center text-body-secondary" aria-hidden="true"><i class="bi bi-arrow-down"></i></div>
                    {% include 'cabinet/waybill/location/_fields.html.twig' with {name: 'trips[' ~ index ~ ']', location: trip, key: 'trip-' ~ index, idField: 'locationId', inputAction: 'input->waybill-form#refreshTripLocations', settlementTypes: settlementTypes, card: true} %}
                </div>
            </details>
            <div class="dropdown position-absolute top-0 end-0 m-2">
                <button class="btn btn-sm btn-link text-body-secondary p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Действия с поездкой" title="Действия с поездкой"><i class="bi bi-three-dots-vertical"></i></button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li data-role="trip-insertion" {% if not insertable %}hidden{% endif %}><button type="button" class="dropdown-item" data-action="click->waybill-form#insert"><i class="bi bi-plus-lg me-2"></i>Добавить поездку ниже</button></li>
                    <li><button type="button" class="dropdown-item text-danger" data-action="click->waybill-form#remove" data-waybill-form-kind-param="trip" title="Удалить поездку" aria-label="Удалить поездку"><i class="bi bi-trash me-2"></i>Удалить поездку</button></li>
                </ul>
            </div>
        </div>
    </div>
</div>
