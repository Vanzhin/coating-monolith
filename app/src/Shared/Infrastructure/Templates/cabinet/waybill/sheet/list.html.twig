{% extends '/cabinet/index.html.twig' %}
{% block title %}{{ parent() }} | Путевые листы{% endblock %}
{% block content %}
    {% set filterQuery = {vehicleId: vehicleId, status: status, from: from, to: to} %}
    {% set hasFilters = vehicleId or status or from or to %}
    {% set pagination %}
        {% if page > 1 or page * perPage < total %}
            <nav class="mt-3" aria-label="Страницы путевых листов"><ul class="pagination pagination-sm justify-content-center">
                {% if page > 1 %}<li class="page-item"><a class="page-link" href="{{ path('app_cabinet_waybill_sheet_list', filterQuery|merge({page: page - 1})) }}">Назад</a></li>{% endif %}
                <li class="page-item active"><span class="page-link">{{ page }}</span></li>
                {% if page * perPage < total %}<li class="page-item"><a class="page-link" href="{{ path('app_cabinet_waybill_sheet_list', filterQuery|merge({page: page + 1})) }}">Вперёд</a></li>{% endif %}
            </ul></nav>
        {% endif %}
    {% endset %}

    <div class="p-2 p-md-3 wb-page">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h1 class="fs-5 fw-bold mb-0">Путевые листы</h1>
            <a href="{{ path('app_cabinet_waybill_sheet_new') }}" class="btn btn-primary ms-auto d-inline-flex align-items-center gap-2"><i class="bi bi-plus-lg"></i> Новый лист</a>
        </div>

        <form class="wb-filters mb-3" method="get" action="{{ path('app_cabinet_waybill_sheet_list') }}">
            <input type="hidden" name="status" value="{{ status }}">
            <div class="wb-field wb-filter-field">
                <div class="wb-field-body">
                    <label class="visually-hidden" for="waybill-vehicle-filter">Автомобиль</label>
                    <input id="waybill-vehicle-filter" type="text" class="wb-field-control" placeholder="Все автомобили" autocomplete="off"
                           data-controller="typeahead"
                           data-typeahead-endpoint-value="{{ path('app_cabinet_waybill_vehicle_suggest') }}"
                           data-typeahead-hidden-name-value="vehicleId"
                           data-typeahead-min-length-value="1"
                           {% if selectedVehicle %}data-typeahead-existing-value="{{ selectedVehicle|json_encode|e('html_attr') }}"{% endif %}>
                    <input type="hidden" name="vehicleId" value="{{ vehicleId }}">
                </div>
                <i class="bi bi-chevron-down wb-field-ic" aria-hidden="true"></i>
            </div>
            <div class="wb-period-filter" data-controller="date-range">
                <div data-date-range-target="enhanced" hidden>
                    <div class="wb-field wb-filter-field">
                        <div class="wb-field-body">
                            <label class="visually-hidden" for="waybill-period-filter">Период</label>
                            <input id="waybill-period-filter" class="wb-field-control" type="text" placeholder="Все периоды" autocomplete="off" readonly data-date-range-target="display" data-action="click->date-range#toggle keydown->date-range#onDisplayKeydown" aria-haspopup="dialog" aria-expanded="false" aria-controls="waybill-period-calendar">
                        </div>
                        <i class="bi bi-calendar3 wb-field-ic" aria-hidden="true"></i>
                    </div>
                </div>
                <div class="wb-period-fallback" data-date-range-target="fallback">
                    <div class="wb-field wb-filter-field">
                        <div class="wb-field-body"><label class="wb-field-label" for="filter-from">С</label><input id="filter-from" name="from" class="wb-field-control" type="date" value="{{ from }}" data-date-range-target="from"></div>
                    </div>
                    <div class="wb-field wb-filter-field">
                        <div class="wb-field-body"><label class="wb-field-label" for="filter-to">По</label><input id="filter-to" name="to" class="wb-field-control" type="date" value="{{ to }}" data-date-range-target="to"></div>
                    </div>
                </div>
                <div id="waybill-period-calendar" class="date-range-popover" role="dialog" aria-label="Фильтр по периоду" data-date-range-target="popup" hidden><div data-date-range-target="calendar"></div></div>
            </div>
            <button type="submit" class="wb-filter wb-filter-submit"><i class="bi bi-funnel"></i> Показать</button>
            <div class="wb-tabs" role="tablist" aria-label="Статус путевого листа">
                <a href="{{ path('app_cabinet_waybill_sheet_list', filterQuery|merge({status: '', page: 1})) }}" class="wb-tab{{ status == '' ? ' is-active' }}" role="tab" aria-selected="{{ status == '' ? 'true' : 'false' }}">Все</a>
                <a href="{{ path('app_cabinet_waybill_sheet_list', filterQuery|merge({status: 'draft', page: 1})) }}" class="wb-tab{{ status == 'draft' ? ' is-active' }}" role="tab" aria-selected="{{ status == 'draft' ? 'true' : 'false' }}">Черновики</a>
                <a href="{{ path('app_cabinet_waybill_sheet_list', filterQuery|merge({status: 'done', page: 1})) }}" class="wb-tab{{ status == 'done' ? ' is-active' }}" role="tab" aria-selected="{{ status == 'done' ? 'true' : 'false' }}">Готовые</a>
            </div>
        </form>

        {% if items is empty %}
            <div class="wb-empty wb-empty--lg">
                <i class="bi bi-file-earmark-plus wb-empty-ic" aria-hidden="true"></i>
                <div class="wb-empty-title">{{ hasFilters ? 'Путевые листы не найдены' : 'Пока нет путевых листов' }}</div>
                <div class="wb-empty-text">{{ hasFilters ? 'Измените условия или сбросьте фильтры.' : 'Создайте первый — укажите период, заправки и поездки' }}</div>
                {% if hasFilters %}
                    <a href="{{ path('app_cabinet_waybill_sheet_list') }}" class="wb-add mt-2">Сбросить фильтры</a>
                {% else %}
                    <a href="{{ path('app_cabinet_waybill_sheet_new') }}" class="wb-add mt-2"><i class="bi bi-plus-lg"></i> Новый лист</a>
                {% endif %}
            </div>
        {% else %}
            <div class="mb-3">
                {% for item in items %}
                    <a href="{{ path('app_cabinet_waybill_sheet_show', {id: item.getId()}) }}" class="wb-sheet">
                        <span class="wb-sheet-tile"><i class="bi bi-file-earmark-spreadsheet"></i></span>
                        <span class="wb-sheet-info">
                            <span class="wb-sheet-name d-block">Путевой лист №{{ item.getNumber() }}</span>
                            <span class="wb-sheet-meta">{{ item.vehicleModel() }} — {{ item.vehicleRegistrationNumber().formatted() }}</span>
                        </span>
                        <span class="wb-sheet-stat">
                            <span class="wb-sheet-k d-block">ПЕРИОД</span>
                            <span class="wb-sheet-v">{{ item.period().from().format('d.m.Y') }} — {{ item.period().to().format('d.m.Y') }}</span>
                        </span>
                        <span class="wb-sheet-stat">
                            <span class="wb-sheet-k d-block">ПОЕЗДКИ</span>
                            <span class="wb-sheet-v">{{ item.trips()|length }} на {{ item.tripDistance()|number_format(0, '.', ' ') }} км</span>
                        </span>
                        <span class="wb-badge {{ item.isLocked() ? 'wb-badge--done' : 'wb-badge--draft' }}"><span class="wb-badge-dot"></span>{{ item.isLocked() ? 'Готов' : 'Черновик' }}</span>
                        <i class="bi bi-chevron-right wb-sheet-chev" aria-hidden="true"></i>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
        {{ pagination }}
    </div>
{% endblock %}
