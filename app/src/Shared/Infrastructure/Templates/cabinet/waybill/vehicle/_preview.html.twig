<div class="modal fade" id="vehiclePreview-{{ vehicle.id }}" tabindex="-1"
     aria-labelledby="vehiclePreviewLabel-{{ vehicle.id }}" aria-hidden="true">
    <div class="modal-dialog modal-sheet modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="ecard-media"><i class="bi bi-car-front"></i></div>
                    <div><h5 class="modal-title mb-0" id="vehiclePreviewLabel-{{ vehicle.id }}">{{ vehicle.model }}</h5><small class="text-body-secondary">Автомобиль</small></div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                {% include 'cabinet/waybill/vehicle/_details.html.twig' with {vehicle: vehicle} only %}
                <div class="mt-3"><a href="{{ path('app_cabinet_waybill_sheet_list', {vehicleId: vehicle.id}) }}" class="btn btn-primary">Путевые листы</a></div>
            </div>
        </div>
    </div>
</div>
