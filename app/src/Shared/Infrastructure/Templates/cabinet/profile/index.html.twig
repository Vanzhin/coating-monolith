{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Профиль{% endblock %}

{% block body %}
    <main class="container-fluid py-3">
        {% block content %}
            <div class="container-fluid">
                {# Хедер профиля — тертиарная карточка (как в cabinet/index). #}
                <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
                    <h1 class="h3 mb-1">Профиль</h1>
                    <p class="text-body-secondary mb-0">
                        {% if app.user %}{{ app.user.email }}{% endif %}
                        {% if is_granted('ROLE_ADMIN') %}
                            <span class="badge text-bg-secondary ms-1">Администратор</span>
                        {% endif %}
                    </p>
                </div>

                {# Меню профиля — каждый пункт отдельный блок (разделяем пространством, не чертой). #}
                <a href="{{ path('app_notifications_list') }}"
                   class="p-3 mb-3 rounded-3 bg-body-tertiary d-flex align-items-center gap-3 text-decoration-none text-body">
                    <i class="bi bi-bell fs-4 text-body-secondary"></i>
                    <span class="fw-medium">Уведомления</span>
                    <span class="ms-auto d-flex align-items-center gap-2">
                        {% include '_shell/_notifications_badge.html.twig' %}
                        <i class="bi bi-chevron-right text-body-secondary"></i>
                    </span>
                </a>
                <a href="{{ path('app_cabinet_profile_settings') }}"
                   class="p-3 mb-3 rounded-3 bg-body-tertiary d-flex align-items-center gap-3 text-decoration-none text-body">
                    <i class="bi bi-gear fs-4 text-body-secondary"></i>
                    <span class="fw-medium">Настройки</span>
                    <i class="bi bi-chevron-right ms-auto text-body-secondary"></i>
                </a>

                {# Выход — отдельный блок внизу (перенесён из сайдбара и шторки «Ещё»). #}
                <a href="{{ path('app_logout') }}"
                   class="p-3 rounded-3 bg-body-tertiary d-flex align-items-center gap-3 text-decoration-none text-danger">
                    <i class="bi bi-box-arrow-right fs-4"></i>
                    <span class="fw-medium">Выйти из аккаунта</span>
                </a>
            </div>
        {% endblock %}
    </main>
{% endblock %}
