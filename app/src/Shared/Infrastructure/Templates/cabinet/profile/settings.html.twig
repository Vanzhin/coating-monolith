{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Настройки{% endblock %}

{% block body %}
    <main class="container-fluid py-3">
        {% block content %}
            <div class="container-fluid">
                <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
                    <a href="{{ path('app_cabinet_profile') }}"
                       class="text-body-secondary text-decoration-none small d-inline-block mb-1">
                        <i class="bi bi-chevron-left"></i> Профиль
                    </a>
                    <h1 class="h3 mb-0">Настройки</h1>
                </div>

                {# Каждая настройка — отдельный блок: описание слева, крупный тоггл справа.
                   Разделяем блоки пространством, не чертой. #}
                {% if vapid_public_key %}
                    {% include '_shell/_notifications_button.html.twig' %}
                {% endif %}

                <div class="p-3 rounded-3 bg-body-tertiary d-flex justify-content-between align-items-center gap-3"
                     data-controller="theme-toggle">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-moon-stars fs-3 text-body-secondary flex-shrink-0"></i>
                        <div>
                            <div class="fw-medium">Тёмная тема</div>
                            <div class="form-text mt-0">Тёмное оформление интерфейса на этом устройстве.</div>
                        </div>
                    </div>
                    <div class="form-check form-switch form-switch-lg flex-shrink-0">
                        <input class="form-check-input" type="checkbox" role="switch"
                               data-theme-toggle-target="switch"
                               data-action="change->theme-toggle#toggle" aria-label="Тёмная тема">
                    </div>
                </div>
            </div>
        {% endblock %}
    </main>
{% endblock %}
