{# Ленивый фрагмент (app_cabinet_inquiry_edit) — модалка правки распознанных параметров.
   Сабмит синхронный (app_cabinet_inquiry_reprocess): переподбор без модели. Каскад стандарт →
   категория/долговечность — контроллер inquiry-edit; вещества — общий coating-tags (как в фильтре
   систем). Всплывает через openFragmentModal. #}
{% set p = form.params %}
{% set o = form.options %}

{# Фасеты текущего стандарта для серверной отрисовки (прогрессивное улучшение до JS-каскада). #}
{% set curStd = null %}
{% for s in o.standards|filter(s => s.value == p.standard) %}{% set curStd = s %}{% endfor %}
{% set durabilityHidden = not curStd or curStd.durabilities is empty or (p.category and p.category in curStd.categoriesWithoutSecondaryAxis) %}

{# Дерево вариантов для JS-каскада. #}
{% set tree = {} %}
{% for s in o.standards %}
    {% set tree = tree|merge({(s.value): {
        primaryLabel: s.primaryLabel,
        secondaryLabel: s.secondaryLabel,
        categories: s.categories,
        durabilities: s.durabilities,
        categoriesWithoutSecondaryAxis: s.categoriesWithoutSecondaryAxis,
    }}) %}
{% endfor %}

{% set appTimeFromHours = p.minApplicationTimeFromMinutes is not null ? (p.minApplicationTimeFromMinutes / 60)|round : '' %}
{% set appTimeToHours = p.minApplicationTimeToMinutes is not null ? (p.minApplicationTimeToMinutes / 60)|round : '' %}

<div class="modal fade" id="inquiryEditModal" tabindex="-1" aria-labelledby="inquiryEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <form method="post" action="{{ path('app_cabinet_inquiry_reprocess', {id: form.inquiryId}) }}"
                  data-controller="inquiry-edit"
                  data-inquiry-edit-tree-value="{{ tree|json_encode }}"
                  data-inquiry-edit-initial-category-value="{{ p.category }}"
                  data-inquiry-edit-initial-durability-value="{{ p.durability }}">
                <input type="hidden" name="_token" value="{{ csrf_token('reprocess') }}">

                <div class="modal-header">
                    <h5 class="modal-title" id="inquiryEditModalLabel">Исправить параметры и переподобрать</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>

                <div class="modal-body">
                    <div class="small text-body-secondary mb-3">Правка параметров запускает подбор заново. Пустые поля — ось не учитывается.</div>

                    {# --- Подложка (мульти) --- #}
                    <div class="mb-3">
                        <label class="form-label small mb-1">Подложка</label>
                        <div class="d-flex flex-wrap gap-2">
                            {% for opt in o.substrates %}
                                <div class="form-check form-check-inline me-0">
                                    <input class="form-check-input" type="checkbox" name="substrates[]" value="{{ opt.value }}"
                                           id="substrate-{{ opt.value }}" {% if opt.value in p.substrates %}checked{% endif %}>
                                    <label class="form-check-label small" for="substrate-{{ opt.value }}">{{ opt.label }}</label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="row g-3">
                        {# --- Среда --- #}
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Среда</label>
                            <select name="environment" class="form-select form-select-sm">
                                <option value="">— не задано —</option>
                                {% for opt in o.environments %}
                                    <option value="{{ opt.value }}" {% if opt.value == p.environment %}selected{% endif %}>{{ opt.label }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        {# --- Стандарт --- #}
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Стандарт</label>
                            <select name="standard" class="form-select form-select-sm"
                                    data-inquiry-edit-target="standardSelect" data-action="change->inquiry-edit#onStandardChange">
                                <option value="">— не задано —</option>
                                {% for s in o.standards %}
                                    <option value="{{ s.value }}" {% if s.value == p.standard %}selected{% endif %}>{{ s.label }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        {# --- Категория (ось 1 стандарта) --- #}
                        <div class="col-md-6" data-inquiry-edit-target="categoryWrap" {% if not curStd %}hidden{% endif %}>
                            <label class="form-label small mb-1" data-inquiry-edit-target="categoryLabel">{{ curStd ? curStd.primaryLabel : 'Категория' }}</label>
                            <select name="category" class="form-select form-select-sm"
                                    data-inquiry-edit-target="categorySelect" data-action="change->inquiry-edit#onCategoryChange">
                                <option value="">— не задано —</option>
                                {% if curStd %}
                                    {% for opt in curStd.categories %}
                                        <option value="{{ opt.value }}" {% if opt.value == p.category %}selected{% endif %}>{{ opt.label }}</option>
                                    {% endfor %}
                                {% endif %}
                            </select>
                        </div>

                        {# --- Долговечность (ось 2 стандарта) --- #}
                        <div class="col-md-6" data-inquiry-edit-target="durabilityWrap" {% if durabilityHidden %}hidden{% endif %}>
                            <label class="form-label small mb-1" data-inquiry-edit-target="durabilityLabel">{{ curStd ? curStd.secondaryLabel : 'Долговечность' }}</label>
                            <select name="durability" class="form-select form-select-sm" data-inquiry-edit-target="durabilitySelect">
                                <option value="">— не задано —</option>
                                {% if curStd %}
                                    {% for opt in curStd.durabilities %}
                                        <option value="{{ opt.value }}" {% if opt.value == p.durability %}selected{% endif %}>{{ opt.label }}</option>
                                    {% endfor %}
                                {% endif %}
                            </select>
                        </div>
                    </div>

                    {# --- Стойкость к веществу (как в фильтре систем) --- #}
                    <div class="mt-3">
                        <label class="form-label small mb-1">Стойкость к веществу</label>
                        <input type="text"
                               data-controller="coating-tags"
                               data-coating-tags-suggest-url-value="{{ path('app_cabinet_chemical_resistance_substance_autocomplete') }}"
                               data-coating-tags-hidden-input-name-value="substanceIds[]"
                               data-coating-tags-allow-create-value="false"
                               data-coating-tags-preselected-ids-value="{{ p.substanceIds|json_encode }}"
                               data-coating-tags-resolve-url-value="{{ path('app_cabinet_chemical_resistance_substance_by_ids') }}"
                               class="form-control form-control-sm"
                               placeholder="Начните вводить вещество...">
                        <input type="number" min="1" name="substanceTemp" value="{{ p.substanceTemperature ?: '' }}"
                               class="form-control form-control-sm mt-2" placeholder="Температура у вещества, °C (опц.)">
                    </div>

                    {# --- Тепловая нагрузка --- #}
                    <div class="row g-3 mt-0">
                        <div class="col-md-4">
                            <label class="form-label small mb-1">Тепловая нагрузка, °C</label>
                            <input type="number" name="thermalTemperature" value="{{ p.thermalTemperature ?: '' }}" class="form-control form-control-sm" placeholder="напр. 120">
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small mb-1">Среда нагрева</label>
                            <select name="thermalEnvironment" class="form-select form-select-sm">
                                <option value="">— не задано —</option>
                                {% for opt in o.thermalEnvironments %}
                                    <option value="{{ opt.value }}" {% if opt.value == p.thermalEnvironment %}selected{% endif %}>{{ opt.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="thermalIncludingPeak" value="1" id="thermalIncludingPeak" {% if p.thermalIncludingPeak %}checked{% endif %}>
                                <label class="form-check-label small" for="thermalIncludingPeak">С учётом пика</label>
                            </div>
                        </div>
                    </div>

                    {# --- Температура нанесения --- #}
                    <div class="row g-3 mt-0">
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Температура нанесения, °C</label>
                            <div class="input-group input-group-sm">
                                <input type="number" name="applicationMinTempFrom" value="{{ p.applicationMinTempFrom is not null ? p.applicationMinTempFrom : '' }}" class="form-control" placeholder="от">
                                <span class="input-group-text">…</span>
                                <input type="number" name="applicationMinTempTo" value="{{ p.applicationMinTempTo is not null ? p.applicationMinTempTo : '' }}" class="form-control" placeholder="до">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">Время сборки при 20 °C, ч</label>
                            <div class="input-group input-group-sm">
                                <input type="number" min="0" name="minApplicationTimeFromHours" value="{{ appTimeFromHours }}" class="form-control" placeholder="от">
                                <span class="input-group-text">…</span>
                                <input type="number" min="0" name="minApplicationTimeToHours" value="{{ appTimeToHours }}" class="form-control" placeholder="до">
                            </div>
                        </div>
                    </div>

                    {# --- Поиск по тексту --- #}
                    <div class="mt-3">
                        <label class="form-label small mb-1">Поиск по названию системы</label>
                        <input type="text" name="search" value="{{ p.search }}" class="form-control form-control-sm" placeholder="фрагмент названия (опц.)">
                    </div>
                </div>

                <div class="modal-footer border-0 d-flex gap-2">
                    <button type="button" class="btn btn-secondary flex-fill" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-arrow-repeat me-1"></i>Переподобрать</button>
                </div>
            </form>
        </div>
    </div>
</div>
