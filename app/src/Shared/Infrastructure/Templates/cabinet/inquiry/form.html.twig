{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Новый запрос на подбор{% endblock %}

{% block content %}
    {% embed 'components/form_page.html.twig' with {
        title: 'Новый запрос на подбор',
        back_url: path('app_cabinet_inquiry_list'),
        save_form_id: 'inquiry-form',
        save_label: 'Отправить на подбор',
    } %}
        {% block sections %}
            <form id="inquiry-form" method="post" action="{{ path('app_cabinet_inquiry_submit') }}"
                  enctype="multipart/form-data" class="w-100" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('inquiry') }}">

                <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="inquiry-text">Текст запроса</label>
                        <textarea id="inquiry-text" name="text" class="form-control" rows="8"
                                  placeholder="Вставьте текст письма/опросника или опишите задачу: среда, вещество, подложка, температура, стандарт…"></textarea>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold" for="inquiry-files">Вложения — опросники, письма (PDF, DOCX, XLSX)</label>
                        <input id="inquiry-files" type="file" name="attachments[]" class="form-control" multiple
                               accept=".pdf,.docx,.xlsx,.xls">
                        <div class="form-text">Можно несколько файлов, до 15 МБ каждый.</div>
                    </div>

                    <div class="form-text"><i class="bi bi-info-circle me-1"></i>Обработка идёт в фоне — результат появится в карточке запроса.</div>
                </div>
            </form>
        {% endblock %}
    {% endembed %}
{% endblock %}
