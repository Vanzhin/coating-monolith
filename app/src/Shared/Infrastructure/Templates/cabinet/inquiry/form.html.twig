{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Новый запрос на подбор{% endblock %}

{% block content %}
    <div class="container-fluid py-3" style="max-width: 760px;">
        <h1 class="h5 mb-3">Новый запрос на подбор системы</h1>

        <form method="post" action="{{ path('app_cabinet_inquiry_submit') }}" enctype="multipart/form-data"
              class="card border-0 shadow-sm" novalidate>
            <div class="card-body p-4">
                <input type="hidden" name="_token" value="{{ csrf_token('inquiry') }}">

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="inquiry-text">Текст запроса</label>
                    <textarea id="inquiry-text" name="text" class="form-control" rows="7"
                              placeholder="Вставьте текст письма/опросника или опишите задачу: среда, вещество, подложка, температура, стандарт…"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="inquiry-files">Вложения — опросники, письма (PDF, DOCX, XLSX)</label>
                    <input id="inquiry-files" type="file" name="attachments[]" class="form-control" multiple
                           accept=".pdf,.docx,.xlsx,.xls">
                    <div class="form-text">Можно несколько файлов, до 15 МБ каждый.</div>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-search me-1"></i>Отправить на подбор</button>
                    <span class="text-body-secondary small">Обработка идёт в фоне — результат появится в карточке запроса.</span>
                </div>
            </div>
        </form>
    </div>
{% endblock %}
