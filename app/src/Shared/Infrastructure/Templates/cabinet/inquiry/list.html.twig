{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Запросы{% endblock %}

{% block content %}
    {% set statusBadge = {received: 'secondary', recognized: 'secondary', matched: 'primary', approved: 'success', failed: 'danger'} %}

    <div class="container-fluid py-3">
        <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
            <h1 class="h5 mb-0">Запросы на подбор</h1>
            <a href="{{ path('app_cabinet_inquiry_new') }}" class="btn btn-sm btn-primary ms-auto"><i class="bi bi-plus-lg me-1"></i>Новый запрос</a>
        </div>

        <div class="d-flex gap-1 flex-wrap mb-3">
            <a href="{{ path('app_cabinet_inquiry_list') }}" class="btn btn-sm {{ currentStatus == '' ? 'btn-secondary' : 'btn-light' }}">Все</a>
            {% for s in statuses %}
                <a href="{{ path('app_cabinet_inquiry_list', {status: s.value}) }}" class="btn btn-sm {{ currentStatus == s.value ? 'btn-secondary' : 'btn-light' }}">{{ s.label }}</a>
            {% endfor %}
        </div>

        {% if result.items is empty %}
            <div class="text-body-secondary fst-italic py-5 text-center">Запросов нет.</div>
        {% else %}
            {% for item in result.items %}
                <a href="{{ path('app_cabinet_inquiry_show', {id: item.id}) }}"
                   class="card border-0 shadow-sm mb-2 text-decoration-none text-body">
                    <div class="card-body py-2 d-flex align-items-center gap-3 flex-wrap">
                        <span class="badge rounded-pill text-bg-{{ statusBadge[item.statusValue] ?? 'secondary' }}">{{ item.statusLabel }}</span>
                        <span class="flex-grow-1 text-truncate small" style="min-width:160px">{{ item.summary }}</span>
                        {% if item.answerTotal is not null %}
                            <span class="badge text-bg-light fw-normal text-body-secondary">{{ item.answerTotal }} систем</span>
                        {% endif %}
                        <span class="small text-body-secondary">{{ item.createdAt|date('d.m.Y H:i') }}</span>
                    </div>
                </a>
            {% endfor %}

            {% if result.pages > 1 %}
                <nav class="mt-3" aria-label="Страницы"><ul class="pagination pagination-sm mb-0">
                    {% for p in 1..result.pages %}
                        <li class="page-item {{ p == result.page ? 'active' : '' }}">
                            <a class="page-link" href="{{ path('app_cabinet_inquiry_list', {status: currentStatus, page: p}) }}">{{ p }}</a>
                        </li>
                    {% endfor %}
                </ul></nav>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
