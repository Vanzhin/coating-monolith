{# Фрагмент быстрого просмотра системы покрытий. Рендерится эндпоинтом
   app_cabinet_coating_system_preview, всплывает модалкой (bottom-sheet на мобиле,
   modal-lg на десктопе — .modal-sheet). Переменные: system (CoatingSystemDTO), canEdit.
   Контракты: id coatingSystemPreview-{id}; coating-preview-loader (вложенное превью
   покрытия по клику на слой); include _system_layer_rows; ленивый блок system-documents. #}

{% set complianceByStandard = {} %}
{% for entry in system.compliance %}
    {% set complianceByStandard = complianceByStandard|merge({(entry.standard): (complianceByStandard[entry.standard]|default([]))|merge([entry])}) %}
{% endfor %}

{% set opTempParts = [] %}
{% if system.maxDryHeatContinuousOperatingTemp is not null %}{% set opTempParts = opTempParts|merge([system.maxDryHeatContinuousOperatingTemp ~ ' °C (сух.)']) %}{% endif %}
{% if system.maxImmersionContinuousOperatingTemp is not null %}{% set opTempParts = opTempParts|merge([system.maxImmersionContinuousOperatingTemp ~ ' °C (погр.)']) %}{% endif %}

<div class="modal fade" id="coatingSystemPreview-{{ system.id }}" tabindex="-1"
     aria-labelledby="coatingSystemPreviewLabel-{{ system.id }}" aria-hidden="true"
     data-controller="coating-preview-loader"
     data-coating-preview-loader-endpoint-value="{{ path('app_cabinet_coating_coating_preview', {id: '00000000-0000-0000-0000-000000000000'}) }}">
    <div class="modal-dialog modal-sheet modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="ecard-media" style="width: 44px; height: 44px;"><i class="bi bi-layers"></i></div>
                    <h5 class="modal-title mb-0" id="coatingSystemPreviewLabel-{{ system.id }}">{{ system.title }}</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div class="kv">
                    <div class="row"><span class="k">Подложка</span><span class="v">{{ system.substrateTitle }}</span></div>
                    <div class="row"><span class="k">Среда</span><span class="v">{{ system.environmentTitle }}</span></div>
                    <div class="row"><span class="k">Подготовка</span><span class="v">{{ system.surfaceTreatmentCode ?: system.surfaceTreatmentDescription }}{% if system.surfaceTreatmentStandardCode %} <span class="u">{{ system.surfaceTreatmentStandardCode }}</span>{% endif %}</span></div>
                    <div class="row"><span class="k">Суммарная ТСП</span><span class="v">{{ system.totalDft }}<span class="u">мкм</span></span></div>
                    {% if system.maxLayerApplicationMinTemp is not null %}<div class="row"><span class="k">Мин. Т нанесения</span><span class="v">{{ system.maxLayerApplicationMinTemp }}<span class="u">°C</span></span></div>{% endif %}
                    {% if opTempParts is not empty %}<div class="row"><span class="k">Макс. Т эксплуатации</span><span class="v">{{ opTempParts|join(' / ') }}</span></div>{% endif %}
                    {% if system.minApplicationTimeAt20Minutes is not null %}<div class="row"><span class="k">Мин. время нанесения</span><span class="v">{{ system.minApplicationTimeAt20Minutes|duration_minutes_short }}</span></div>{% endif %}
                </div>

                {% if system.description %}
                    <p class="text-body-secondary small mt-3 mb-0">{{ system.description }}</p>
                {% endif %}

                <div class="pv-sec">Состав · {{ system.layers|length }} слоёв</div>
                {% include 'cabinet/coating/coating_system/_system_layer_rows.html.twig' with { layers: system.layers } only %}

                {% if complianceByStandard|length > 0 %}
                    <div class="pv-sec">Соответствие</div>
                    <div class="ecard-compliance">
                        {% for standard, entries in complianceByStandard %}
                            <div class="ecard-compliance-row">
                                <span class="std">{{ (entries|first).standardTitle }}</span>
                                <span class="vals">
                                    {% for entry in entries %}
                                        {% set q = { standard: entry.standard, category: entry.primary, durability: entry.secondary } %}
                                        <a href="{{ path('app_cabinet_coating_system_list', q) }}"
                                           title="Отфильтровать по «{{ entry.standardTitle }} · {{ entry.label }}»">{{ entry.label }}</a>
                                    {% endfor %}
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if system.documentCount > 0 %}
                    <div class="pv-sec">Документы</div>
                    <div data-controller="system-documents"
                         data-system-documents-url-value="{{ path('app_cabinet_coating_system_documents', {id: system.id}) }}"
                         data-system-documents-document-preview-route-value="{{ path('app_cabinet_certificate_document_preview', {id: '00000000-0000-0000-0000-000000000000'}) }}"
                         data-system-documents-target="block">
                        <div class="d-flex flex-wrap gap-1" data-system-documents-target="list"></div>
                    </div>
                {% endif %}

                {% if system.tags|length > 0 %}
                    <div class="pv-sec">Теги</div>
                    <div class="d-flex flex-wrap gap-1">
                        {% for tag in system.tags %}<span class="badge text-bg-light fw-normal text-body-secondary">{{ tag.title }}</span>{% endfor %}
                    </div>
                {% endif %}

                <div class="small text-body-secondary mt-3">Обновлено: {{ system.updatedAt|date('d.m.Y') }}</div>
            </div>
            <div class="modal-footer">
                {% if canEdit %}
                    <a href="{{ path('app_cabinet_coating_system_update', {id: system.id}) }}" class="btn btn-outline-primary">
                        <i class="bi bi-pencil"></i> Редактировать
                    </a>
                {% endif %}
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>
