{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Поиск систем по соответствию{% endblock %}

{% block content %}
    <div class="p-2 p-md-3">
        <div class="mb-4">
            <h1 class="h3 mb-0">Поиск по соответствию</h1>
        </div>

        {% if error is not null %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}

        <form method="get" action="{{ path('app_cabinet_coating_system_search_by_compliance') }}" class="mb-4">
            <div class="row g-2">
                <div class="col-md-3">
                    <label for="standard" class="form-label">Стандарт</label>
                    <select id="standard" name="standard" class="form-select" required>
                        <option value="">— Стандарт —</option>
                        {% for s in standards %}
                            <option value="{{ s.value }}" {% if standard == s.value %}selected{% endif %}>
                                {{ s.title() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="category" class="form-label">Категория коррозийности</label>
                    <select id="category" name="category" class="form-select" required>
                        <option value="">— Категория —</option>
                        {% for c in categories %}
                            <option value="{{ c.value }}" {% if category == c.value %}selected{% endif %}>
                                {{ c.title() }} — {{ c.description() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="durability" class="form-label">Долговечность</label>
                    <select id="durability" name="durability" class="form-select" required>
                        <option value="">— Долговечность —</option>
                        {% for d in durabilities %}
                            <option value="{{ d.value }}" {% if durability == d.value %}selected{% endif %}>
                                {{ d.title() }} — {{ d.description() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="substrate" class="form-label">Субстрат (опционально)</label>
                    <select id="substrate" name="substrate" class="form-select">
                        <option value="">Любой</option>
                        {% for s in substrates %}
                            <option value="{{ s.value }}" {% if substrate == s.value %}selected{% endif %}>
                                {{ s.title() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Найти</button>
            </div>
        </form>

        {% if items is not null %}
            {% if items is empty %}
                <div class="p-3 rounded-3 bg-body-tertiary text-center text-muted">
                    Нет систем, соответствующих указанным требованиям.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Название</th>
                                <th>Субстрат</th>
                                <th class="text-end">Слоёв</th>
                                <th class="text-end">Суммарная ТСП, мкм</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for system in items %}
                                <tr>
                                    <td>
                                        <a href="{{ path('app_cabinet_coating_system_view', {id: system.id}) }}"
                                           class="text-body fw-semibold text-decoration-none">
                                            {{ system.title }}
                                        </a>
                                    </td>
                                    <td class="text-muted small">{{ system.substrateTitle }}</td>
                                    <td class="text-end">{{ system.layers|length }}</td>
                                    <td class="text-end">{{ system.totalDft }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
