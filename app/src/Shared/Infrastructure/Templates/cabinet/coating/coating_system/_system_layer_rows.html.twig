{# Строки слоёв системы: кликабельная кнопка-покрытие (грузит превью покрытия через
   coating-preview-loader) + ТСП + цвет. Общий партиал для карточки списка и модалки превью.
   Переменные: layers — list<CoatingSystemLayerDTO>. #}
{% if layers|length > 0 %}
    <div class="small text-body-secondary d-flex flex-column gap-1">
        {% for layer in layers %}
            <div class="d-flex align-items-center flex-wrap gap-1">
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-coating-id="{{ layer.coatingId }}"
                        data-action="click->coating-preview-loader#open">{{ layer.coatingTitle }}</button>
                <span>{{ layer.dft }} мкм</span>
                {% if layer.colorHex %}
                    <span class="color-swatch ms-1" style="background: {{ layer.colorHex }}"
                          title="{{ layer.colorLabel }}"></span>{{ layer.colorLabel }}
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="small text-muted">Слоёв нет</div>
{% endif %}
