{# Батч карточек систем покрытий (единая entity-карточка).
   Используется:
   - основным шаблоном list.html.twig для первой страницы;
   - ListAction в режиме ?partial=1 для догрузки следующих страниц.

   Обязательные переменные:
     items    — list<CoatingSystemDTO>
     canEdit  — bool

   Контракты (не ломать): data-system-id на карточке; превью по клику —
   click->entity-preview#open + data-entity-id. Детали состава/нанесения — в превью. #}
{% set canEdit = canEdit|default(false) %}

{% for system in items %}
    {# Соответствие сгруппировано по стандартам (ГОСТ/ISO/СП) — бейджи label. #}
    {% set complianceByStandard = {} %}
    {% for entry in system.compliance %}
        {% set complianceByStandard = complianceByStandard|merge({(entry.standard): (complianceByStandard[entry.standard]|default([]))|merge([entry])}) %}
    {% endfor %}

    <div class="ecard" data-system-id="{{ system.id }}">
        <div class="ecard-media" role="button"
             data-action="click->entity-preview#open" data-entity-id="{{ system.id }}">
            <i class="bi bi-layers"></i>
        </div>

        <div class="ecard-body">
            <div class="ecard-head">
                <div class="ecard-title" role="button"
                     data-action="click->entity-preview#open" data-entity-id="{{ system.id }}">{{ system.title }}</div>
                {% if canEdit %}
                    <div class="ecard-kebab dropdown" data-controller="dropdown-portal">
                        <button class="btn btn-sm btn-link text-body-secondary p-1" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Действия">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% if system.documentDownloadUrl %}
                                <li>
                                    <a class="dropdown-item" href="{{ system.documentDownloadUrl }}">
                                        <i class="bi bi-file-earmark-arrow-down me-2"></i>Скачать документ
                                    </a>
                                </li>
                            {% endif %}
                            <li>
                                <a class="dropdown-item" href="{{ path('app_cabinet_coating_system_update', {id: system.id}) }}">
                                    <i class="bi bi-pencil me-2"></i>Редактировать
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-danger"
                                   href="{{ path('app_cabinet_coating_system_remove', {id: system.id}) }}"
                                   data-bs-toggle="modal" data-bs-target="#deleteModal"
                                   data-bs-title="{{ system.title }}" data-bs-id="{{ system.id }}">
                                    <i class="bi bi-trash3 me-2"></i>Удалить
                                </a>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            </div>

            {% if system.description %}
                <div class="ecard-desc" role="button"
                     data-action="click->entity-preview#open" data-entity-id="{{ system.id }}">{{ system.description }}</div>
            {% endif %}

            {# Покрытия системы (по слоям) — кликабельные чипы: свотч цвета слоя + название,
               ведут в превью покрытия (тот же coating-preview-loader, что и в списке покрытий). #}
            {% if system.layers|length > 0 %}
                <div class="ecard-tags" data-controller="scroll-fade">
                    {% for layer in system.layers %}
                        <button type="button" class="tag tag-btn"
                                data-coating-id="{{ layer.coatingId }}"
                                data-action="click->coating-preview-loader#open">
                            {% if layer.colorHex %}<span class="sw" style="background: {{ layer.colorHex }}"></span>{% endif %}{{ layer.coatingTitle }}
                        </button>
                    {% endfor %}
                </div>
            {% endif %}

            {# Мета: ТСП · подложка · среда · документы. Кол-во слоёв и подготовка
               поверхности убраны (слои видны чипами выше, детали — в модалке). #}
            <div class="ecard-meta">
                {{ system.totalDft }} мкм · {{ system.substrateTitle }} · {{ system.environmentTitle }}
                {%- if system.documentCount > 0 %} · {{ system.documentCount }} докум.{% endif %}
            </div>

            {# Соответствие — сгруппировано по стандарту: подпись стандарта + кликабельные
               чипы. Клик по чипу фильтрует список систем по этому соответствию
               (standard/category/durability = standard/primary/secondary DTO). #}
            {% if complianceByStandard|length > 0 %}
                <div class="ecard-compliance">
                    {% for standard, entries in complianceByStandard %}
                        <div class="ecard-compliance-row">
                            <span class="std">{{ (entries|first).standardTitle }}</span>
                            <span class="vals">
                                {% for entry in entries %}
                                    {% set q = app.request.query.all|merge({
                                        standard: entry.standard, category: entry.primary,
                                        durability: entry.secondary, page: null
                                    })|filter(v => v is not null) %}
                                    <a href="{{ path('app_cabinet_coating_system_list', q) }}"
                                       title="Отфильтровать по «{{ entry.standardTitle }} · {{ entry.label }}»">{{ entry.label }}</a>
                                {% endfor %}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if system.tags|length > 0 %}
                <div class="ecard-tags" data-controller="scroll-fade">
                    {% for tag in system.tags %}<span class="tag">{{ tag.title }}</span>{% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endfor %}
