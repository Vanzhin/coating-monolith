{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Системы покрытий{% endblock %}

{% block content %}
    <div class="p-2 p-md-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3 mb-0">Системы покрытий</h1>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_cabinet_coating_system_add') }}" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg"></i> Добавить
                </a>
            {% endif %}
        </div>

        <form method="get" action="{{ path('app_cabinet_coating_system_list') }}" class="mb-3">
            <div class="row g-2">
                <div class="col-md-5">
                    <input type="text" name="search" value="{{ search }}" class="form-control"
                           placeholder="Поиск по названию...">
                </div>
                <div class="col-md-4">
                    <select name="substrate" class="form-select">
                        <option value="">Все субстраты</option>
                        {% for s in substrates %}
                            <option value="{{ s.value }}" {% if substrate == s.value %}selected{% endif %}>
                                {{ s.title() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-outline-secondary w-100">Найти</button>
                </div>
            </div>
        </form>

        {% if items is empty %}
            <div class="p-3 rounded-3 bg-body-tertiary text-center text-muted">
                Системы покрытий не найдены.
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Название</th>
                            <th>Субстрат</th>
                            <th class="text-end">Слоёв</th>
                            <th class="text-end">Суммарная ТСП, мкм</th>
                            <th>Обновлено</th>
                            {% if is_granted('ROLE_ADMIN') %}
                                <th></th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for system in items %}
                            <tr>
                                <td>
                                    <a href="{{ path('app_cabinet_coating_system_view', {id: system.id}) }}"
                                       class="text-body fw-semibold text-decoration-none">
                                        {{ system.title }}
                                    </a>
                                </td>
                                <td class="text-muted small">{{ system.substrateTitle }}</td>
                                <td class="text-end">{{ system.layers|length }}</td>
                                <td class="text-end">{{ system.totalDft }}</td>
                                <td class="text-muted small">{{ system.updatedAt|date('d.m.Y') }}</td>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <td class="text-end">
                                        <a href="{{ path('app_cabinet_coating_system_update', {id: system.id}) }}"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post"
                                              action="{{ path('app_cabinet_coating_system_remove', {id: system.id}) }}"
                                              class="d-inline"
                                              data-controller="confirm-form"
                                              data-confirm-form-message-value="Удалить систему «{{ system.title|e('js') }}»?"
                                              data-action="submit->confirm-form#confirm">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if total > perPage %}
                <nav class="mt-3">
                    <ul class="pagination pagination-sm justify-content-center">
                        {% if page > 1 %}
                            <li class="page-item">
                                <a class="page-link"
                                   href="{{ path('app_cabinet_coating_system_list', {page: page - 1, search: search, substrate: substrate}) }}">
                                    Назад
                                </a>
                            </li>
                        {% endif %}
                        {% set totalPages = (total / perPage)|round(0, 'ceil') %}
                        {% for p in 1..totalPages %}
                            <li class="page-item {% if p == page %}active{% endif %}">
                                <a class="page-link"
                                   href="{{ path('app_cabinet_coating_system_list', {page: p, search: search, substrate: substrate}) }}">
                                    {{ p }}
                                </a>
                            </li>
                        {% endfor %}
                        {% if page < totalPages %}
                            <li class="page-item">
                                <a class="page-link"
                                   href="{{ path('app_cabinet_coating_system_list', {page: page + 1, search: search, substrate: substrate}) }}">
                                    Вперёд
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
