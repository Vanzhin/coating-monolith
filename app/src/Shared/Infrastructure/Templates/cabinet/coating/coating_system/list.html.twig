{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Системы покрытий{% endblock %}

{% block content %}
    {% set canEdit = is_granted('ROLE_ADMIN') %}
    {% set idPlaceholder = '00000000-0000-0000-0000-000000000000' %}

    <div data-controller="entity-preview coating-preview-loader"
         data-entity-preview-endpoint-value="{{ path('app_cabinet_coating_system_preview', {id: idPlaceholder}) }}"
         data-coating-preview-loader-endpoint-value="{{ path('app_cabinet_coating_coating_preview', {id: idPlaceholder}) }}">

    {# Собираем значения активных подложек для сравнения #}
    {% set activeSubstrateValues = substrates|map(s => s.value) %}

    {# Активность фасетов #}
    {% set substratesActive = substrates|length > 0 %}
    {% set environmentActive = environment is not null %}
    {% set standardActive = standard is not null %}
    {% set categoryActive = standardActive and category is not null %}
    {# У CX/Im4 нет оси долговечности (durabilityAxisEnabled=false) — блок скрыт, значение не применяется #}
    {% set durabilityActive = standardActive and durability is not null and durabilityAxisEnabled %}
    {% set durabilityAxisShown = categoryActive and durabilityAxisEnabled %}
    {% set tagsActive = tagIds|length > 0 %}
    {% set coatingsActive = coatingIds|length > 0 %}
    {% set appMinTempActive = applicationMinTemp is not null %}
    {% set appTimeActive = minApplicationTimeAt20Hours is not null %}
    {% set thermalActive = thermTemp is not null and thermEnv %}

    {% set activeFacetsCount = substrates|length
        + (environmentActive ? 1 : 0)
        + (standardActive ? 1 : 0)
        + (categoryActive ? 1 : 0)
        + (durabilityActive ? 1 : 0)
        + tagIds|length
        + coatingIds|length
        + (appMinTempActive ? 1 : 0)
        + (appTimeActive ? 1 : 0)
        + (thermalActive ? 1 : 0)
        + (hasDocuments != '' ? 1 : 0) %}

    {# Summary-строки для активных range/single фасетов #}
    {% set appMinTempSummary = appMinTempActive
        ? (applicationMinTemp.from is not null and applicationMinTemp.to is not null
            ? applicationMinTemp.from ~ '…' ~ applicationMinTemp.to ~ ' °C'
            : (applicationMinTemp.from is not null ? '≥ ' ~ applicationMinTemp.from ~ ' °C' : '≤ ' ~ applicationMinTemp.to ~ ' °C'))
        : null %}

    {% set appTimeSummary = appTimeActive
        ? (minApplicationTimeAt20Hours.from is not null and minApplicationTimeAt20Hours.to is not null
            ? minApplicationTimeAt20Hours.from ~ '…' ~ minApplicationTimeAt20Hours.to ~ ' ч'
            : (minApplicationTimeAt20Hours.from is not null ? '≥ ' ~ minApplicationTimeAt20Hours.from ~ ' ч' : '≤ ' ~ minApplicationTimeAt20Hours.to ~ ' ч'))
        : null %}

    {% set thSummary = thermalActive
        ? thermTemp ~ ' °C (' ~ (thermEnv == 'immersion' ? 'погр.' : 'сух.') ~ (thermIncludingPeak ? ' +пик' : '') ~ ')'
        : null %}

    {# Reset URL-ы для range-фасетов #}
    {% set appMinTempResetUrl = path('app_cabinet_coating_system_list', app.request.query.all|merge({applicationMinTempFrom: null, applicationMinTempTo: null, page: null})|filter(v => v is not null)) %}
    {% set appTimeResetUrl = path('app_cabinet_coating_system_list', app.request.query.all|merge({minApplicationTimeAt20From: null, minApplicationTimeAt20To: null, page: null})|filter(v => v is not null)) %}
    {% set thResetUrl = path('app_cabinet_coating_system_list', app.request.query.all|merge({thermTemp: null, thermEnv: null, thermPeak: null, page: null})|filter(v => v is not null)) %}

    {# Пресеты температурных чипов: «нанесение возможно при T и ниже» —
       фильтр по верхней границе (max_layer_application_min_temp <= T). #}
    {% set appMinTempPresets = [
        {from: null, to: -10, label: '−10 °C и ниже'},
        {from: null, to: 5,   label: '+5 °C и ниже'},
        {from: null, to: 10,  label: '+10 °C и ниже'},
    ] %}

    {% set appTimePresets = [
        {from: null, to: 8,  label: 'до 8 ч'},
        {from: null, to: 24, label: 'до 24 ч'},
        {from: null, to: 72, label: 'до 3 сут'},
    ] %}

    {% embed 'components/list_page.html.twig' with {
        title: 'Системы покрытий',
        create_route: 'app_cabinet_coating_system_add',
        can_edit: canEdit,
        is_empty: items is empty,
    } %}
    {% block above_list %}
        {% set selectedTagsJson = '[]' %}
        {% set defaultSort = constant('App\\Coatings\\Domain\\Repository\\CoatingSystemSort::DEFAULT') %}
        {% embed 'components/entity_search.html.twig' with {
            list_route: 'app_cabinet_coating_system_list',
            form_id: 'systemListForm',
            search_name: 'q',
            search_value: q,
            search_placeholder: 'По названию системы (от 3 символов)',
            search_typeahead: path('app_cabinet_coating_system_suggest'),
            sort_options: sortOptions|map(o => {value: o.value, label: o.title()}),
            sort_current: sort.value,
            sort_default: defaultSort.value,
            active_count: activeFacetsCount,
            drawer_id: 'allFiltersOffcanvas',
            drawer_form_id: 'allFiltersForm',
        } %}
            {% block chips %}

                {# --- Подложка (multi) --- #}
                {% if substratesActive %}
                    {% for s in substrateOptions|filter(s => s.value in activeSubstrateValues) %}
                        {% set valsAfterRemove = activeSubstrateValues|filter(v => v != s.value) %}
                        {% set removeUrl = path('app_cabinet_coating_system_list', app.request.query.all|merge({substrates: valsAfterRemove, page: null})|filter(v => v is not null)) %}
                        <a href="{{ removeUrl }}"
                           class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                           title="Убрать «{{ s.title() }}» из фильтра">
                            {{ s.title() }} <i class="bi bi-x-lg"></i>
                        </a>
                    {% endfor %}
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="substrate">
                        Подложка
                    </button>
                {% endif %}

                {# --- Среда (single) --- #}
                {% if environmentActive %}
                    {% set environmentResetUrl = path('app_cabinet_coating_system_list', app.request.query.all|merge({environment: null, page: null})|filter(v => v is not null)) %}
                    <a href="{{ environmentResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр среды">
                        {{ environment.title() }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="environment">
                        Среда
                    </button>
                {% endif %}

                {# --- Документы: выбор в шторке «Все фильтры»; здесь — только активный чип для сброса --- #}
                {% if hasDocuments != '' %}
                    {% set docsResetUrl = path('app_cabinet_coating_system_list', app.request.query.all|merge({hasDocuments: null, page: null})|filter(v => v is not null)) %}
                    <a href="{{ docsResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр документов">
                        {{ hasDocuments == '1' ? 'С документами' : 'Без документов' }} <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}

                {# --- Стандарт (single) --- #}
                {% if standardActive %}
                    {% set standardResetUrl = path('app_cabinet_coating_system_list', app.request.query.all|merge({standard: null, category: null, durability: null, page: null})|filter(v => v is not null)) %}
                    <a href="{{ standardResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр стандарта">
                        {{ standard.title() }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="standard">
                        Стандарт
                    </button>
                {% endif %}

                {# --- Категория / Долговечность (только если стандарт выбран) --- #}
                {% if standardActive %}
                    {% if categoryActive %}
                        {% set categoryResetUrl = path('app_cabinet_coating_system_list', app.request.query.all|merge({category: null, durability: null, page: null})|filter(v => v is not null)) %}
                        <a href="{{ categoryResetUrl }}"
                           class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                           title="Убрать фильтр категории">
                            {{ categoryTitle }} <i class="bi bi-x-lg"></i>
                        </a>
                    {% else %}
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-action="click->facet-jump#jump" data-facet-jump-facet-param="category">
                            {{ complianceFacets.primaryLabel }}
                        </button>
                    {% endif %}

                    {# --- Долговечность (single, только если у категории есть эта ось; у CX/Im4 нет) --- #}
                    {% if durabilityAxisShown %}
                        {% if durabilityActive %}
                            {% set durabilityResetUrl = path('app_cabinet_coating_system_list', app.request.query.all|merge({durability: null, page: null})|filter(v => v is not null)) %}
                            <a href="{{ durabilityResetUrl }}"
                               class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                               title="Убрать фильтр долговечности">
                                {{ durabilityTitle }} <i class="bi bi-x-lg"></i>
                            </a>
                        {% else %}
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-action="click->facet-jump#jump" data-facet-jump-facet-param="durability">
                                {{ complianceFacets.secondaryLabel }}
                            </button>
                        {% endif %}
                    {% endif %}
                {% endif %}

                {# --- Мин Т нанесения (range) --- #}
                {% if appMinTempActive %}
                    <a href="{{ appMinTempResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр">
                        Мин Т: {{ appMinTempSummary }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="appMinTemp">
                        Мин Т нанесения
                    </button>
                {% endif %}

                {# --- Мин время нанесения при 20°C (range) --- #}
                {% if appTimeActive %}
                    <a href="{{ appTimeResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр">
                        Минимальное время нанесения: {{ appTimeSummary }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="appTime">
                        Мин. время нанесения
                    </button>
                {% endif %}

                {# --- Температура эксплуатации (single) --- #}
                {% if thermalActive %}
                    <a href="{{ thResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр">
                        Работает при {{ thSummary }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="thermal">
                        Температура эксплуатации
                    </button>
                {% endif %}

            {% endblock %}

            {% block drawer %}
                    {# Активные фильтры сверху #}
                    {% if activeFacetsCount > 0 %}
                        <div class="p-3 mb-2 rounded-3 bg-body-tertiary">
                            <div class="small text-muted mb-2">Активные фильтры</div>
                            <div class="d-flex flex-wrap gap-1">
                                {% if substratesActive %}
                                    {% for s in substrateOptions|filter(s => s.value in activeSubstrateValues) %}
                                        {% set valsAfterRemove = activeSubstrateValues|filter(v => v != s.value) %}
                                        {% set qRemove = app.request.query.all|merge({substrates: valsAfterRemove, page: null})|filter(v => v is not null) %}
                                        <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                            {{ s.title() }}
                                            <a href="{{ path('app_cabinet_coating_system_list', qRemove) }}"
                                               class="btn-close btn-close-white btn-close-sm ms-1"
                                               aria-label="Убрать"></a>
                                        </span>
                                    {% endfor %}
                                {% endif %}
                                {% if environmentActive %}
                                    {% set qRemove = app.request.query.all|merge({environment: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        {{ environment.title() }}
                                        <a href="{{ path('app_cabinet_coating_system_list', qRemove) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1"
                                           aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if standardActive %}
                                    {% set qRemove = app.request.query.all|merge({standard: null, category: null, durability: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        {{ standard.title() }}
                                        <a href="{{ path('app_cabinet_coating_system_list', qRemove) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1"
                                           aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if categoryActive %}
                                    {% set qRemove = app.request.query.all|merge({category: null, durability: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        {{ categoryTitle }}
                                        <a href="{{ path('app_cabinet_coating_system_list', qRemove) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1"
                                           aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if durabilityActive %}
                                    {% set qRemove = app.request.query.all|merge({durability: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        {{ durabilityTitle }}
                                        <a href="{{ path('app_cabinet_coating_system_list', qRemove) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1"
                                           aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if appMinTempActive %}
                                    {% set qRemove = app.request.query.all|merge({applicationMinTempFrom: null, applicationMinTempTo: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        Мин Т: {{ appMinTempSummary }}
                                        <a href="{{ path('app_cabinet_coating_system_list', qRemove) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1"
                                           aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if appTimeActive %}
                                    {% set qRemove = app.request.query.all|merge({minApplicationTimeAt20From: null, minApplicationTimeAt20To: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        Минимальное время нанесения: {{ appTimeSummary }}
                                        <a href="{{ path('app_cabinet_coating_system_list', qRemove) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1"
                                           aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if thermalActive %}
                                    {% set qRemove = app.request.query.all|merge({thermTemp: null, thermEnv: null, thermPeak: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        Работает при {{ thermTemp }} °C ({{ thermEnv == 'immersion' ? 'погр.' : 'сух.' }}{{ thermIncludingPeak ? ' +пик' : '' }})
                                        <a href="{{ path('app_cabinet_coating_system_list', qRemove) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1"
                                           aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                    {# === Секция: Подложка === #}
                    <div id="facet-substrate" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                        <h6 class="fw-semibold mb-2">Подложка</h6>
                        <div class="d-flex flex-wrap gap-1">
                            {% for s in substrateOptions %}
                                <label class="facet-pill">
                                    <input type="checkbox" name="substrates[]" value="{{ s.value }}"
                                           {% if s.value in activeSubstrateValues %}checked{% endif %}>{{ s.title() }}
                                </label>
                            {% endfor %}
                        </div>
                    </div>

                    {# === Секция: Среда === #}
                    <div id="facet-environment" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                        <h6 class="fw-semibold mb-2">Среда</h6>
                        <div class="d-flex flex-wrap gap-1">
                            {% for e in environmentOptions %}
                                <label class="facet-pill">
                                    <input type="radio" name="environment" value="{{ e.value }}"
                                           {% if environment and environment.value == e.value %}checked{% endif %}>{{ e.title() }}
                                </label>
                            {% endfor %}
                            <label class="facet-pill facet-pill--muted">
                                <input type="radio" name="environment" value="" {% if not environment %}checked{% endif %}>Любая
                            </label>
                        </div>
                    </div>

                    {# === Секция: Документы === #}
                    <div id="facet-hasDocuments" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                        <h6 class="fw-semibold mb-2">Документы</h6>
                        <div class="d-flex flex-wrap gap-1">
                            <label class="facet-pill">
                                <input type="radio" name="hasDocuments" value="1" {% if hasDocuments == '1' %}checked{% endif %}>С документами
                            </label>
                            <label class="facet-pill">
                                <input type="radio" name="hasDocuments" value="0" {% if hasDocuments == '0' %}checked{% endif %}>Без документов
                            </label>
                            <label class="facet-pill facet-pill--muted">
                                <input type="radio" name="hasDocuments" value="" {% if hasDocuments == '' %}checked{% endif %}>Любые
                            </label>
                        </div>
                    </div>

                    {# === Секция: Стандарт === #}
                    <div id="facet-standard" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                        <h6 class="fw-semibold mb-2">Стандарт</h6>
                        <div class="d-flex flex-wrap gap-1">
                            {% for s in standardOptions %}
                                <label class="facet-pill">
                                    <input type="radio" name="standard" value="{{ s.value }}"
                                           {% if standard and standard.value == s.value %}checked{% endif %}>{{ s.title() }}
                                </label>
                            {% endfor %}
                            <label class="facet-pill facet-pill--muted">
                                <input type="radio" name="standard" value="" {% if not standard %}checked{% endif %}>Любой
                            </label>
                        </div>
                    </div>

                    {# === Секция: Категория (только при стандарте) === #}
                    {% if standardActive %}
                        <div id="facet-category" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                            <h6 class="fw-semibold mb-2">{{ complianceFacets.primaryLabel }}</h6>
                            <input type="hidden" name="standard" value="{{ standard.value }}">
                            <div class="d-flex flex-wrap gap-1">
                                {% for opt in complianceFacets.primaryOptions %}
                                    <label class="facet-pill">
                                        <input type="radio" name="category" value="{{ opt.value }}"
                                               {% if category == opt.value %}checked{% endif %}>{{ opt.title }}
                                    </label>
                                {% endfor %}
                                <label class="facet-pill facet-pill--muted">
                                    <input type="radio" name="category" value="" {% if not category %}checked{% endif %}>Любая
                                </label>
                            </div>
                        </div>

                        {# === Секция: Долговечность (только при категории с этой осью; у CX/Im4 нет) === #}
                        {% if durabilityAxisShown %}
                            <div id="facet-durability" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                                <h6 class="fw-semibold mb-2">{{ complianceFacets.secondaryLabel }}</h6>
                                <input type="hidden" name="category" value="{{ category }}">
                                <div class="d-flex flex-wrap gap-1">
                                    {% for opt in complianceFacets.secondaryOptions %}
                                        <label class="facet-pill">
                                            <input type="radio" name="durability" value="{{ opt.value }}"
                                                   {% if durability == opt.value %}checked{% endif %}>{{ opt.title }}
                                        </label>
                                    {% endfor %}
                                    <label class="facet-pill facet-pill--muted">
                                        <input type="radio" name="durability" value="" {% if not durability %}checked{% endif %}>Любая
                                    </label>
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}

                    {# === Секция: Мин Т нанесения === #}
                    {% include 'components/range_filter_card.html.twig' with {
                        title: 'Мин Т нанесения',
                        unit: '°C',
                        name_from: 'applicationMinTempFrom',
                        facet_id: 'appMinTemp',
                        name_to: 'applicationMinTempTo',
                        from: applicationMinTemp ? applicationMinTemp.from : null,
                        to: applicationMinTemp ? applicationMinTemp.to : null,
                        presets: appMinTempPresets,
                        min: -30,
                        max: 50,
                        reset_label: 'Любая',
                    } only %}

                    {# === Секция: Минимальное время нанесения при 20°C === #}
                    {% include 'components/range_filter_card.html.twig' with {
                        title: 'Минимальное время нанесения (при 20°C)',
                        unit: 'ч',
                        name_from: 'minApplicationTimeAt20From',
                        facet_id: 'appTime',
                        name_to: 'minApplicationTimeAt20To',
                        from: minApplicationTimeAt20Hours ? minApplicationTimeAt20Hours.from : null,
                        to: minApplicationTimeAt20Hours ? minApplicationTimeAt20Hours.to : null,
                        presets: appTimePresets,
                        min: 0,
                        max: 168,
                        reset_label: 'Любое',
                    } only %}

                    {# === Секция: Температура эксплуатации === #}
                    <div id="facet-thermal" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                        <h6 class="fw-semibold mb-2">Температура эксплуатации</h6>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">°C</label>
                                <input type="number" name="thermTemp" value="{{ thermTemp }}"
                                       class="form-control form-control-sm"
                                       min="-200" max="1000" step="5" placeholder="напр. 90">
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Среда</label>
                                {% set thermEnvEffective = thermEnv ?: 'dry_heat' %}
                                <select name="thermEnv" class="form-select form-select-sm">
                                    <option value="dry_heat" {% if thermEnvEffective == 'dry_heat' %}selected{% endif %}>Сухое тепло</option>
                                    <option value="immersion" {% if thermEnvEffective == 'immersion' %}selected{% endif %}>Погружение</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input"
                                           id="thermPeakOff" name="thermPeak" value="1"
                                           {% if thermIncludingPeak %}checked{% endif %}>
                                    <label class="form-check-label small" for="thermPeakOff">Включая пиковые нагрузки</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# === Секция: Покрытия в составе === #}
                    <div id="facet-coatings" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary" data-coating-tags-group>
                        <h6 class="fw-semibold mb-2">Покрытия в составе</h6>
                        <input type="text"
                               data-controller="coating-tags"
                               data-coating-tags-existing-value="[]"
                               data-coating-tags-suggest-url-value="{{ path('app_cabinet_coating_coating_suggest') }}"
                               data-coating-tags-create-url-value=""
                               data-coating-tags-hidden-input-name-value="coatingIds[]"
                               data-coating-tags-allow-create-value="false"
                               data-coating-tags-preselected-ids-value="{{ coatingIds|json_encode }}"
                               data-coating-tags-resolve-url-value="{{ path('app_cabinet_coating_coating_by_ids') }}"
                               class="form-control form-control-sm"
                               placeholder="Начните вводить покрытие...">
                    </div>

                    {# === Секция: Теги === #}
                    <div id="facet-tags" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary" data-coating-tags-group>
                        <h6 class="fw-semibold mb-2">Теги</h6>
                        <input type="text"
                               data-controller="coating-tags"
                               data-coating-tags-existing-value="{{ selectedTagsJson }}"
                               data-coating-tags-suggest-url-value="{{ path('app_cabinet_coating_coating_tag_suggest') }}"
                               data-coating-tags-create-url-value=""
                               data-coating-tags-hidden-input-name-value="tagIds[]"
                               data-coating-tags-allow-create-value="false"
                               class="form-control form-control-sm"
                               placeholder="Начните вводить тег...">
                    </div>
            {% endblock %}
        {% endembed %}
    {% endblock %}

    {% block list_content %}
        <div class="d-inline-block p-2 px-3 mb-3 rounded-3 bg-body-tertiary small">
            Найдено: <strong>{{ total }}</strong>
        </div>

        {% set totalPages = (total / perPage)|round(0, 'ceil') %}
        {% set baseQuery = app.request.query.all|filter((v, k) => v is not null and k != 'page' and k != 'partial') %}

        {% include 'components/infinite_list.html.twig' with {
            items_template: 'cabinet/coating/coating_system/_list_cards.html.twig',
            items_params: {
                items: items,
                canEdit: canEdit,
            },
            total_pages: totalPages,
            base_url: path('app_cabinet_coating_system_list', baseQuery),
            wrapper_class: 'ecard-grid',
        } only %}

        <noscript>
            {% include 'components/pager.html.twig' with {pager: {
                total_items: total,
                page: page,
                perPage: perPage,
            }} %}
        </noscript>

        {% if canEdit %}
            {% include 'components/delete_modal.html.twig' with {'delete': 'app_cabinet_coating_system_remove'} %}
        {% endif %}
    {% endblock %}

    {% block empty_state %}
        <div class="p-4 mt-3 rounded-3 bg-body-tertiary text-center" role="status">
            <i class="bi bi-layers fs-1 d-block mb-2 text-body-secondary"></i>
            <h5 class="fw-semibold mb-2">Системы покрытий не найдены</h5>
            {% if q or substratesActive or standardActive or tagsActive or coatingsActive or appMinTempActive or appTimeActive or thermalActive %}
                <p class="text-body-secondary mb-0">
                    По запросу с заданными фильтрами совпадений нет. Попробуйте изменить параметры поиска.
                </p>
            {% endif %}
        </div>
    {% endblock %}
    {% endembed %}


    </div>{# /data-controller="entity-preview coating-preview-loader" #}

{% endblock %}
