{% extends '/cabinet/index.html.twig' %}

{% set inputData = inputData|default({}) %}
{% set isUpdate = systemId is defined and systemId %}
{% set pageTitle = isUpdate ? 'Обновление системы покрытий' : 'Добавление системы покрытий' %}
{% set submitLabel = isUpdate ? 'Сохранить' : 'Добавить' %}
{% set actionUrl = isUpdate
    ? path('app_cabinet_coating_system_update', {id: systemId})
    : path('app_cabinet_coating_system_add') %}
{% set listUrl = path('app_cabinet_coating_system_list') %}
{% set formId = 'coating-system-form' %}
{% set anchors = [
    {id: 'sec-meta',   label: 'Описание'},
    {id: 'sec-prep',   label: 'Подготовка'},
    {id: 'sec-layers', label: 'Слои'},
    {id: 'sec-tags',   label: 'Теги'},
] %}

{% block title %}{{ parent() }} | {{ pageTitle }}{% endblock %}

{% block content %}
    {% embed 'components/form_page.html.twig' with {
        title: pageTitle, back_url: listUrl, save_form_id: formId, save_label: submitLabel, anchors: anchors,
    } %}
        {% block sections %}
        <div data-controller="surface-treatment-modal"
             data-surface-treatment-modal-endpoint-value="{{ path('app_cabinet_surface_treatment_create_inline') }}"
             data-surface-treatment-modal-treatment-select-value="inputSurfaceTreatment"
             data-surface-treatment-modal-substrate-select-value="inputSubstrate">
            <form id="{{ formId }}" method="post" action="{{ actionUrl }}" class="w-100" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('mutation') }}">
                {% if error is defined and error %}
                    <div class="form-alert" role="alert">
                        <i class="bi bi-exclamation-octagon"></i>
                        <div>
                            <div class="form-alert-title">Не удалось сохранить</div>
                            <div>{{ error }}</div>
                        </div>
                    </div>
                {% endif %}

            {# 1. Метаданные #}
            <div id="sec-meta" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">Описание</h6>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label for="inputTitle" class="form-label">Название</label>
                        <input type="text" value="{{ inputData.title|default('') }}" name="title" id="inputTitle"
                               class="form-control" required autofocus maxlength="100"
                               placeholder="Укажите название системы...">
                    </div>
                    <div class="col-md-4">
                        <label for="inputSubstrate" class="form-label">Подложка</label>
                        <select class="form-select" id="inputSubstrate" name="substrate" required>
                            <option value="">Выберите подложку...</option>
                            {% for s in substrates %}
                                <option value="{{ s.value }}"
                                        {% if (inputData.substrate ?? '') == s.value %} selected {% endif %}>
                                    {{ s.title() }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="inputEnvironment" class="form-label">Среда эксплуатации</label>
                        <select class="form-select" id="inputEnvironment" name="environment" required>
                            {% for e in environments %}
                                <option value="{{ e.value }}"
                                        {% if (inputData.environment ?? 'atmospheric') == e.value %} selected {% endif %}>
                                    {{ e.title() }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <label for="inputDescription" class="form-label">Описание</label>
                        <textarea name="description" id="inputDescription" class="form-control"
                                  rows="3" maxlength="2000"
                                  placeholder="Описание системы покрытий...">{{ inputData.description|default('') }}</textarea>
                        <div class="form-text">до 2000 символов</div>
                    </div>
                </div>
            </div>

            {# 2. Подготовка поверхности #}
            <div id="sec-prep" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">Подготовка поверхности</h6>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label for="inputSurfaceTreatment" class="form-label">Метод подготовки</label>
                        <div class="d-flex flex-column flex-sm-row gap-2 align-items-sm-start">
                            <div class="flex-grow-1" style="min-width: 0;"
                                 data-controller="async-typeahead"
                                 data-async-typeahead-endpoint-value="{{ path('app_cabinet_surface_treatment_suggest') }}"
                                 data-async-typeahead-placeholder-value="Поиск подготовки поверхности...">
                                <select id="inputSurfaceTreatment" class="form-select" name="surfaceTreatmentId" required
                                        data-async-typeahead-target="select">
                                    <option value="">Выберите подготовку поверхности...</option>
                                    {% if (inputData.surfaceTreatmentId ?? '') and (inputData.surfaceTreatmentTitle ?? '') %}
                                        <option value="{{ inputData.surfaceTreatmentId }}" selected>
                                            {{ inputData.surfaceTreatmentTitle }}
                                        </option>
                                    {% endif %}
                                </select>
                            </div>
                            <button type="button" class="btn btn-soft-success flex-shrink-0"
                                    data-action="click->surface-treatment-modal#open">
                                <i class="bi bi-plus-lg"></i> Создать
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            {# 3. Слои системы — единый редактор для создания и редактирования #}
            {% set editorLayers = isUpdate ? (layersDto.layers|default([])) : [] %}
            {% if not isUpdate %}
                {% set coatingTitlesById = inputData.coatingTitlesById|default({}) %}
                {% for layer in inputData.layers|default([]) %}
                    {% set editorLayers = editorLayers|merge([{
                        coatingId: layer.coatingId,
                        dft: layer.dft,
                        coatingTitle: coatingTitlesById[layer.coatingId]|default(''),
                        colorId: layer.colorId|default(null),
                        colorName: layer.colorName|default(null),
                        colorRal: layer.colorRal|default(null),
                        colorHex: layer.colorHex|default(null),
                        colorLabel: layer.colorLabel|default(null),
                    }]) %}
                {% endfor %}
            {% endif %}
            <div id="sec-layers" class="fsec" data-form-scrollspy-target="section">
                {% include 'cabinet/coating/coating_system/_layers_edit.html.twig' with {
                    layers: editorLayers,
                    error: null,
                } %}
            </div>

            {# 4. Теги #}
            <div id="sec-tags" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section" data-coating-tags-group>
                <h6 class="fw-semibold mb-3">Теги</h6>
                <input type="text"
                       data-controller="coating-tags"
                       data-coating-tags-existing-value="{{ existingTagsJson|default('[]') }}"
                       data-coating-tags-suggest-url-value="{{ path('app_cabinet_coating_coating_tag_suggest') }}"
                       data-coating-tags-create-url-value="{{ path('app_cabinet_coating_coating_tag_create') }}"
                       data-coating-tags-hidden-input-name-value="tagIds[]"
                       data-coating-tags-allow-create-value="true"
                       class="form-control"
                       placeholder="Начните вводить тег...">
            </div>

            </form>

    {# Bootstrap modal для inline-создания подготовки поверхности.
       Модалка ВНУТРИ внешнего div c data-controller="surface-treatment-modal",
       чтобы её targets попадали в scope контроллера. #}
    <div class="modal fade" id="surfaceTreatmentModal" tabindex="-1" aria-labelledby="surfaceTreatmentModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="surfaceTreatmentModalLabel">Создать подготовку поверхности</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Описание <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" maxlength="2000"
                                  placeholder="Описание метода подготовки поверхности..."
                                  data-surface-treatment-modal-target="descriptionInput"></textarea>
                        <div class="form-text">до 2000 символов</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Код</label>
                            <input type="text" class="form-control" maxlength="30" placeholder="Sa 2"
                                   data-surface-treatment-modal-target="codeInput">
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Стандарт</label>
                            <input type="text" class="form-control" maxlength="100" placeholder="ГОСТ Р ИСО 8501-1"
                                   data-surface-treatment-modal-target="standardInput">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Применимые подложки <span class="text-danger">*</span></label>
                        <div>
                            {% for s in substrates %}
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox"
                                           id="modalScope_{{ s.value }}"
                                           value="{{ s.value }}"
                                           data-surface-treatment-modal-target="scopeCheckbox">
                                    <label class="form-check-label" for="modalScope_{{ s.value }}">{{ s.title() }}</label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="alert alert-danger d-none" data-surface-treatment-modal-target="errorBox"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="button" class="btn btn-primary"
                            data-action="click->surface-treatment-modal#submit">Сохранить</button>
                </div>
            </div>
        </div>
    </div>

    {% include 'components/color_create_modal.html.twig' %}
        </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
