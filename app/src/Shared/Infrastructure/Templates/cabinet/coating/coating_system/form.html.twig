{% extends '/cabinet/index.html.twig' %}

{% set inputData = inputData|default({}) %}
{% set isUpdate = systemId is defined and systemId %}
{% set pageTitle = isUpdate ? 'Обновление системы покрытий' : 'Добавление системы покрытий' %}
{% set submitLabel = isUpdate ? 'Сохранить' : 'Добавить' %}
{% set actionUrl = isUpdate
    ? path('app_cabinet_coating_system_update', {id: systemId})
    : path('app_cabinet_coating_system_add') %}

{% block title %}{{ parent() }} | {{ pageTitle }}{% endblock %}

{% block content %}
    <div class="p-2 p-md-3"
         data-controller="coating-system-form surface-treatment-modal"
         data-surface-treatment-modal-endpoint-value="{{ path('app_cabinet_surface_treatment_create_inline') }}"
         data-surface-treatment-modal-treatment-select-value="inputSurfaceTreatment"
         data-surface-treatment-modal-substrate-select-value="inputSubstrate">
        <form method="post" action="{{ actionUrl }}" class="w-100" novalidate>
            {% if error is defined and error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">{{ pageTitle }}</h1>
                <a href="{{ path('app_cabinet_coating_system_list') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left"></i> К списку
                </a>
            </div>

            {# 1. Метаданные #}
            <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
                <h6 class="fw-semibold mb-3">Описание</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="inputTitle" class="form-label">Название</label>
                        <input type="text" value="{{ inputData.title|default('') }}" name="title" id="inputTitle"
                               class="form-control" required autofocus maxlength="100"
                               placeholder="Укажите название системы...">
                    </div>
                    <div class="col-md-6">
                        <label for="inputSubstrate" class="form-label">Субстрат</label>
                        <select class="form-select" id="inputSubstrate" name="substrate" required>
                            <option value="">Выберите субстрат...</option>
                            {% for s in substrates %}
                                <option value="{{ s.value }}"
                                        {% if (inputData.substrate ?? '') == s.value %} selected {% endif %}>
                                    {{ s.title() }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <label for="inputDescription" class="form-label">Описание</label>
                        <textarea name="description" id="inputDescription" class="form-control"
                                  rows="3" maxlength="2000"
                                  placeholder="Описание системы покрытий...">{{ inputData.description|default('') }}</textarea>
                        <div class="form-text">до 2000 символов</div>
                    </div>
                </div>
            </div>

            {# 2. Подготовка поверхности #}
            <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
                <h6 class="fw-semibold mb-3">Подготовка поверхности</h6>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label for="inputSurfaceTreatment" class="form-label">Метод подготовки</label>
                        <div class="input-group">
                            <div class="flex-grow-1"
                                 data-controller="async-typeahead"
                                 data-async-typeahead-endpoint-value="{{ path('app_cabinet_surface_treatment_suggest') }}"
                                 data-async-typeahead-placeholder-value="Поиск подготовки поверхности...">
                                <select id="inputSurfaceTreatment" class="form-select" name="surfaceTreatmentId" required
                                        data-async-typeahead-target="select">
                                    <option value="">Выберите подготовку поверхности...</option>
                                    {% if (inputData.surfaceTreatmentId ?? '') and (inputData.surfaceTreatmentTitle ?? '') %}
                                        <option value="{{ inputData.surfaceTreatmentId }}" selected>
                                            {{ inputData.surfaceTreatmentTitle }}
                                        </option>
                                    {% endif %}
                                </select>
                            </div>
                            <button type="button" class="btn btn-outline-secondary"
                                    data-action="click->surface-treatment-modal#open">
                                + Создать
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            {# 3. Слои системы (только при создании) #}
            {% if not isUpdate %}
                <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-semibold mb-0">Слои системы</h6>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-action="click->coating-system-form#addLayer">
                            <i class="bi bi-plus-lg"></i> Добавить слой
                        </button>
                    </div>
                    <div class="form-text mb-3">
                        Укажите покрытия и их проектную толщину (ТСП, мкм). Слои можно добавить и отредактировать после создания системы.
                    </div>
                    <div data-coating-system-form-target="layersList">
                        {% set coatingTitlesById = inputData.coatingTitlesById|default({}) %}
                        {% for i, layer in inputData.layers|default([]) %}
                            <div class="row g-2 mb-2 align-items-center" data-coating-system-form-target="layerRow">
                                <div class="col"
                                     data-controller="async-typeahead"
                                     data-async-typeahead-endpoint-value="{{ path('app_cabinet_coating_coating_suggest') }}"
                                     data-async-typeahead-placeholder-value="Поиск покрытия...">
                                    <select name="layers[{{ i }}][coatingId]" class="form-select form-select-sm" required
                                            data-async-typeahead-target="select">
                                        <option value="">Выберите покрытие...</option>
                                        {% if (layer.coatingId ?? '') and (coatingTitlesById[layer.coatingId] ?? '') %}
                                            <option value="{{ layer.coatingId }}" selected>
                                                {{ coatingTitlesById[layer.coatingId] }}
                                            </option>
                                        {% endif %}
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <div class="input-group input-group-sm">
                                        <input type="number" name="layers[{{ i }}][dft]"
                                               value="{{ layer.dft|default('') }}"
                                               class="form-control" min="1" max="9999" required
                                               placeholder="ТСП">
                                        <span class="input-group-text">мкм</span>
                                    </div>
                                </div>
                                <div class="col-auto">
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            data-action="click->coating-system-form#removeLayer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <template data-coating-system-form-target="layerTemplate">
                        <div class="row g-2 mb-2 align-items-center" data-coating-system-form-target="layerRow">
                            <div class="col"
                                 data-controller="async-typeahead"
                                 data-async-typeahead-endpoint-value="{{ path('app_cabinet_coating_coating_suggest') }}"
                                 data-async-typeahead-placeholder-value="Поиск покрытия...">
                                <select name="layers[__INDEX__][coatingId]" class="form-select form-select-sm" required
                                        data-async-typeahead-target="select">
                                    <option value="">Выберите покрытие...</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group input-group-sm">
                                    <input type="number" name="layers[__INDEX__][dft]"
                                           value=""
                                           class="form-control" min="1" max="9999" required
                                           placeholder="ТСП">
                                    <span class="input-group-text">мкм</span>
                                </div>
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-action="click->coating-system-form#removeLayer">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </template>
                </div>
            {% else %}
                <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
                    <p class="text-muted mb-0 small">
                        <i class="bi bi-info-circle me-1"></i>
                        Слои системы редактируются отдельно после сохранения метаданных.
                    </p>
                </div>
            {% endif %}

            {# 4. Теги #}
            <div class="p-3 mb-3 rounded-3 bg-body-tertiary" data-coating-tags-group>
                <h6 class="fw-semibold mb-3">Теги</h6>
                <input type="text"
                       data-controller="coating-tags"
                       data-coating-tags-existing-value="{{ existingTagsJson|default('[]') }}"
                       data-coating-tags-suggest-url-value="{{ path('app_cabinet_coating_coating_tag_suggest') }}"
                       data-coating-tags-create-url-value=""
                       data-coating-tags-hidden-input-name-value="tagIds[]"
                       data-coating-tags-allow-create-value="false"
                       class="form-control"
                       placeholder="Начните вводить тег...">
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a href="{{ path('app_cabinet_coating_system_list') }}" class="btn btn-outline-secondary">Отмена</a>
                <button class="btn btn-primary" type="submit">{{ submitLabel }}</button>
            </div>
        </form>

    {# Bootstrap modal для inline-создания подготовки поверхности.
       Модалка ВНУТРИ внешнего div c data-controller="surface-treatment-modal",
       чтобы её targets попадали в scope контроллера. #}
    <div class="modal fade" id="surfaceTreatmentModal" tabindex="-1" aria-labelledby="surfaceTreatmentModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="surfaceTreatmentModalLabel">Создать подготовку поверхности</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Описание <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="3" maxlength="2000"
                                  placeholder="Описание метода подготовки поверхности..."
                                  data-surface-treatment-modal-target="descriptionInput"></textarea>
                        <div class="form-text">до 2000 символов</div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label">Код</label>
                            <input type="text" class="form-control" maxlength="30" placeholder="Sa 2"
                                   data-surface-treatment-modal-target="codeInput">
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Стандарт</label>
                            <input type="text" class="form-control" maxlength="100" placeholder="ГОСТ Р ИСО 8501-1"
                                   data-surface-treatment-modal-target="standardInput">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Применимые субстраты <span class="text-danger">*</span></label>
                        <div>
                            {% for s in substrates %}
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox"
                                           id="modalScope_{{ s.value }}"
                                           value="{{ s.value }}"
                                           data-surface-treatment-modal-target="scopeCheckbox">
                                    <label class="form-check-label" for="modalScope_{{ s.value }}">{{ s.title() }}</label>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                    <div class="alert alert-danger d-none" data-surface-treatment-modal-target="errorBox"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="button" class="btn btn-primary"
                            data-action="click->surface-treatment-modal#submit">Сохранить</button>
                </div>
            </div>
        </div>
    </div>
    </div>
{% endblock %}
