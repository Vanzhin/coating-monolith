{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Отчёты{% endblock %}

{% block content %}
    {% set totalPages = (result.pager.total_items / result.pager.perPage)|round(0, 'ceil') %}
    {% set baseQuery = app.request.query.all|filter((v, k) => v is not null and k != 'page' and k != 'partial') %}
    {% set statuses = {'': 'Все', 'created': 'Черновики', 'in_work': 'В работе', 'under_review': 'На проверке', 'approved': 'Утверждённые', 'rejected': 'Отклонённые'} %}
    {% set activeCount = ownerIds|length + customerIds|length + contractorIds|length + projectIds|length + (status ? 1 : 0) %}

    {% embed 'components/list_page.html.twig' with {
        title: 'Отчёты',
        create_route: null,
        can_edit: true,
        is_empty: result.reports is empty,
        reports: result.reports,
        search: search,
        status: status,
        statuses: statuses,
        activeCount: activeCount,
        ownerIds: ownerIds,
        customerIds: customerIds,
        contractorIds: contractorIds,
        projectIds: projectIds,
        total_pages: totalPages,
        base_url: path('app_cabinet_report_list', baseQuery),
    } only %}
        {% block header_actions %}
            <button type="button" class="btn btn-soft-success" title="Добавить"
                    data-bs-toggle="modal" data-bs-target="#reportCreateModal">
                <i class="bi bi-plus-lg"></i>
            </button>
        {% endblock %}

        {% block above_list %}
            {% embed 'components/entity_search.html.twig' with {
                list_route: 'app_cabinet_report_list',
                form_id: 'reportListForm',
                search_name: 'search',
                search_value: search,
                search_placeholder: 'Поиск по № акта или проекту',
                search_minlength: 2,
                search_maxlength: 50,
                active_count: activeCount,
                drawer_id: 'allReportFiltersOffcanvas',
                drawer_form_id: 'allReportFiltersForm',
            } %}
                {# Статус — быстрый дропдаун в chip-row (как facet-дропдаун в покрытиях). #}
                {% block chips %}
                    <div class="dropdown flex-shrink-0">
                        <button type="button"
                                class="btn btn-sm {{ status ? 'btn-primary' : 'btn-outline-secondary' }} dropdown-toggle"
                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Статус">
                            <i class="bi bi-flag"></i><span class="d-none d-md-inline"> {{ status ? statuses[status] : 'Статус' }}</span>
                        </button>
                        <ul class="dropdown-menu">
                            {% for key, label in statuses %}
                                {% set st = key ?: null %}
                                {% set q = app.request.query.all|merge({status: st, page: null})|filter(v => v is not null) %}
                                {% set isActive = (status == key) or (not status and key == '') %}
                                <li><a class="dropdown-item {{ isActive ? 'active' : '' }}" href="{{ path('app_cabinet_report_list', q) }}">{{ label }}</a></li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endblock %}

                {# Статус живёт в chip-row (не в форме шторки) — пробрасываем его hidden, чтобы «Показать» не сбросил. #}
                {% block drawer_hidden %}
                    {% if status %}<input type="hidden" name="status" value="{{ status }}">{% endif %}
                {% endblock %}

                {# Фасеты сущностей — только админу (suggest под ROLE_ADMIN). Бэкенд универсальный:
                   открыть обычным пользователям = снять guard с suggest/by-ids и убрать этот if. #}
                {% block drawer %}
                    {% if is_granted('ROLE_ADMIN') %}
                        {# === Секция: Владелец (одиночный) === #}
                        <div id="facet-owner" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary" data-coating-tags-group>
                            <h6 class="fw-semibold mb-2">Владелец</h6>
                            <input type="text"
                                   data-controller="coating-tags"
                                   data-coating-tags-existing-value="[]"
                                   data-coating-tags-suggest-url-value="{{ path('app_cabinet_users_suggest') }}"
                                   data-coating-tags-create-url-value=""
                                   data-coating-tags-hidden-input-name-value="ownerIds[]"
                                   data-coating-tags-allow-create-value="false"
                                   data-coating-tags-max-tags-value="1"
                                   data-coating-tags-preselected-ids-value="{{ ownerIds|json_encode }}"
                                   data-coating-tags-resolve-url-value="{{ path('app_cabinet_users_by_ids') }}"
                                   class="form-control form-control-sm"
                                   placeholder="Начните вводить email...">
                        </div>

                        {# === Секция: Заказчик (одиночный) === #}
                        <div id="facet-customer" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary" data-coating-tags-group>
                            <h6 class="fw-semibold mb-2">Заказчик</h6>
                            <input type="text"
                                   data-controller="coating-tags"
                                   data-coating-tags-existing-value="[]"
                                   data-coating-tags-suggest-url-value="{{ path('app_cabinet_reports_counterparty_suggest') }}"
                                   data-coating-tags-create-url-value=""
                                   data-coating-tags-hidden-input-name-value="customerIds[]"
                                   data-coating-tags-allow-create-value="false"
                                   data-coating-tags-max-tags-value="1"
                                   data-coating-tags-preselected-ids-value="{{ customerIds|json_encode }}"
                                   data-coating-tags-resolve-url-value="{{ path('app_cabinet_reports_counterparty_by_ids') }}"
                                   class="form-control form-control-sm"
                                   placeholder="Начните вводить заказчика...">
                        </div>

                        {# === Секция: Подрядчики (мультивыбор) === #}
                        <div id="facet-contractor" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary" data-coating-tags-group>
                            <h6 class="fw-semibold mb-2">Подрядчики</h6>
                            <input type="text"
                                   data-controller="coating-tags"
                                   data-coating-tags-existing-value="[]"
                                   data-coating-tags-suggest-url-value="{{ path('app_cabinet_reports_counterparty_suggest') }}"
                                   data-coating-tags-create-url-value=""
                                   data-coating-tags-hidden-input-name-value="contractorIds[]"
                                   data-coating-tags-allow-create-value="false"
                                   data-coating-tags-preselected-ids-value="{{ contractorIds|json_encode }}"
                                   data-coating-tags-resolve-url-value="{{ path('app_cabinet_reports_counterparty_by_ids') }}"
                                   class="form-control form-control-sm"
                                   placeholder="Начните вводить подрядчика...">
                        </div>

                        {# === Секция: Проекты (мультивыбор) === #}
                        <div id="facet-project" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary" data-coating-tags-group>
                            <h6 class="fw-semibold mb-2">Проекты</h6>
                            <input type="text"
                                   data-controller="coating-tags"
                                   data-coating-tags-existing-value="[]"
                                   data-coating-tags-suggest-url-value="{{ path('app_cabinet_reports_project_suggest') }}"
                                   data-coating-tags-create-url-value=""
                                   data-coating-tags-hidden-input-name-value="projectIds[]"
                                   data-coating-tags-allow-create-value="false"
                                   data-coating-tags-preselected-ids-value="{{ projectIds|json_encode }}"
                                   data-coating-tags-resolve-url-value="{{ path('app_cabinet_reports_project_by_ids') }}"
                                   class="form-control form-control-sm"
                                   placeholder="Начните вводить проект...">
                        </div>
                    {% endif %}
                {% endblock %}
            {% endembed %}
        {% endblock %}

        {% block list_content %}
            {% include 'components/infinite_list.html.twig' with {
                items_template: 'cabinet/report/_report_cards_batch.html.twig',
                items_params: { reports: reports },
                total_pages: total_pages,
                base_url: base_url,
                wrapper_class: 'ecard-grid',
            } only %}
            {% include 'components/delete_modal.html.twig' with {'delete': 'app_cabinet_report_delete'} %}
        {% endblock %}

        {% block empty_state %}
            <div class="text-center text-body-secondary py-5">
                <i class="bi bi-clipboard-data fs-1 d-block mb-2 opacity-50"></i>
                Пока нет отчётов. Создайте первый — кнопка «+» вверху.
            </div>
        {% endblock %}
    {% endembed %}

    {% include 'cabinet/report/_create_modal.html.twig' with {types: types} %}
{% endblock %}
