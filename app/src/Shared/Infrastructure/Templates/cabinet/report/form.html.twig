{% extends '/cabinet/index.html.twig' %}

{% set editing = editing|default(false) %}
{% set input = input|default({}) %}

{% block title %}{{ parent() }} | {{ editing ? 'Реквизиты отчёта' : 'Новый отчёт' }}{% endblock %}

{% block content %}
    {% set actionUrl = editing ? path('app_cabinet_report_edit', {id: report.id}) : path('app_cabinet_report_create') %}
    {% set backUrl = editing ? path('app_cabinet_report_view', {id: report.id}) : path('app_cabinet_report_list') %}
    {% set actNumber = editing ? report.actNumber : input.actNumber|default('') %}
    {% set reportDate = editing ? report.reportDate : input.reportDate|default('') %}

    {% embed 'components/form_page.html.twig' with {
        title: editing ? 'Реквизиты отчёта' : 'Новый отчёт',
        back_url: backUrl,
        save_form_id: 'report-form',
        save_label: editing ? 'Сохранить' : 'Создать',
        anchors: [{id: 'sec-doc', label: 'Документ'}, {id: 'sec-refs', label: 'Ссылки'}],
    } %}
        {% block sections %}
            <form id="report-form" method="post" action="{{ actionUrl }}" class="w-100" novalidate>
                {% if error is defined and error %}
                    <div class="form-alert" role="alert">
                        <i class="bi bi-exclamation-octagon"></i>
                        <div>
                            <div class="form-alert-title">Не удалось сохранить</div>
                            <div>{{ error }}</div>
                        </div>
                    </div>
                {% endif %}

                <div id="sec-doc" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <h6 class="fw-semibold mb-3">Документ</h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Вид документа</label>
                            {% if editing %}
                                <input class="form-control" value="{{ report.typeLabel }}" disabled>
                            {% else %}
                                <select name="type" class="form-select" required>
                                    {% for t in types %}
                                        <option value="{{ t.value }}" {{ input.type|default('') == t.value ? 'selected' : '' }}>{{ t.label }}</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">№ акта</label>
                            <input name="actNumber" value="{{ actNumber }}" class="form-control">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Дата</label>
                            <input type="date" name="reportDate" value="{{ reportDate }}" class="form-control">
                        </div>
                    </div>
                </div>

                <div id="sec-refs" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <h6 class="fw-semibold mb-3">Ссылки</h6>
                    <div class="row g-3">
                        <div class="col-12" data-controller="system-select"
                             data-system-select-search-url-value="{{ path('app_cabinet_report_system_search') }}"
                             data-system-select-hidden-name-value="systemId"
                             {% if editing and report.systemId %}data-system-select-selected-value="{{ {id: report.systemId, title: report.systemTitle}|json_encode|e('html_attr') }}"{% endif %}>
                            <label class="form-label">Система покрытия</label>
                            <div class="mb-2" data-system-select-target="selected"></div>
                            <input type="text" class="form-control" data-system-select-target="input" placeholder="Поиск системы по названию…">
                            <div class="form-text">В варианте видны слои, толщина, подложка, подготовка, среда. Слои выбранной системы засеются в план.</div>
                            <div class="mt-2" data-system-select-target="results"></div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Заказчик</label>
                            <input type="text" class="form-control" data-controller="typeahead"
                                   data-typeahead-endpoint-value="{{ path('app_cabinet_reports_counterparty_suggest') }}"
                                   data-typeahead-create-url-value="{{ path('app_cabinet_reports_counterparty_quick') }}"
                                   data-typeahead-create-modal-value="counterparty-create-modal"
                                   data-typeahead-hidden-name-value="customerId"
                                   data-typeahead-aux-fields-value="{{ [{field:'tin',label:'ИНН'}]|json_encode|e('html_attr') }}"
                                   {% if editing and report.customerId %}data-typeahead-existing-value="{{ {id: report.customerId, title: report.customerTitle}|json_encode|e('html_attr') }}"{% endif %}
                                   placeholder="Поиск или создать…">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Подрядчик</label>
                            <input type="text" class="form-control" data-controller="typeahead"
                                   data-typeahead-endpoint-value="{{ path('app_cabinet_reports_counterparty_suggest') }}"
                                   data-typeahead-create-url-value="{{ path('app_cabinet_reports_counterparty_quick') }}"
                                   data-typeahead-create-modal-value="counterparty-create-modal"
                                   data-typeahead-hidden-name-value="contractorId"
                                   data-typeahead-aux-fields-value="{{ [{field:'tin',label:'ИНН'}]|json_encode|e('html_attr') }}"
                                   {% if editing and report.contractorId %}data-typeahead-existing-value="{{ {id: report.contractorId, title: report.contractorTitle}|json_encode|e('html_attr') }}"{% endif %}
                                   placeholder="Поиск или создать…">
                        </div>
                        <div class="col-12">
                            <label class="form-label">Проект</label>
                            <input type="text" class="form-control" data-controller="typeahead"
                                   data-typeahead-endpoint-value="{{ path('app_cabinet_reports_project_suggest') }}"
                                   data-typeahead-create-url-value="{{ path('app_cabinet_reports_project_quick') }}"
                                   data-typeahead-hidden-name-value="projectId"
                                   data-typeahead-counterparty-name-value="customerId"
                                   {% if editing and report.projectId %}data-typeahead-existing-value="{{ {id: report.projectId, title: report.projectTitle}|json_encode|e('html_attr') }}"{% endif %}
                                   placeholder="Поиск или создать…">
                            <div class="form-text">Новый проект создаётся под выбранным заказчиком.</div>
                        </div>
                    </div>
                </div>
            </form>

            {# Модалка создания контрагента с ИНН (заказчик/подрядчик), ВНЕ формы. Одна на страницу. #}
            {% include 'components/counterparty_create_modal.html.twig' %}
        {% endblock %}
    {% endembed %}
{% endblock %}
