{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | {{ report.typeLabel|default('Отчёт') }}{% endblock %}

{% block content %}
    <div class="p-2 p-md-3 col-12 col-lg-9 col-xl-7 mx-auto">
        <div class="d-flex align-items-center justify-content-between mb-3 p-3 rounded-3 bg-body-tertiary">
            <div class="d-flex align-items-center gap-2">
                <a href="{{ path('app_cabinet_report_list') }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left"></i></a>
                <h2 class="text-body-emphasis mb-0 fs-4">{{ report.typeLabel|default('Отчёт') }}</h2>
            </div>
            {% include 'cabinet/report/_status_pill.html.twig' with {status: report.status, label: report.statusLabel} only %}
        </div>

        {% if report.status == 'rejected' and report.rejectionReason %}
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <strong>Отклонён.</strong> {{ report.rejectionReason }}</div>
        {% endif %}
        {% if report.status == 'approved' %}
            <div class="alert alert-success"><i class="bi bi-lock"></i> Отчёт утверждён и заморожен — правки закрыты.</div>
        {% endif %}

        <div class="card p-3 mb-3">
            <dl class="row mb-0">
                <dt class="col-5 col-sm-4 text-body-secondary fw-normal">№ акта</dt><dd class="col-7 col-sm-8">{{ report.actNumber|default('—') }}</dd>
                <dt class="col-5 col-sm-4 text-body-secondary fw-normal">Дата</dt><dd class="col-7 col-sm-8">{{ report.reportDate|default('—') }}</dd>
                <dt class="col-5 col-sm-4 text-body-secondary fw-normal">Проект</dt><dd class="col-7 col-sm-8">{{ report.projectTitle|default('—') }}</dd>
                <dt class="col-5 col-sm-4 text-body-secondary fw-normal">Заказчик</dt><dd class="col-7 col-sm-8">{{ report.customerTitle|default('—') }}</dd>
                <dt class="col-5 col-sm-4 text-body-secondary fw-normal">Подрядчик</dt><dd class="col-7 col-sm-8">{{ report.contractorTitle|default('—') }}</dd>
                <dt class="col-5 col-sm-4 text-body-secondary fw-normal">Система</dt><dd class="col-7 col-sm-8">{{ report.systemTitle|default('—') }}</dd>
            </dl>
        </div>

        <div class="alert alert-secondary mb-0">
            <i class="bi bi-info-circle"></i> Заполнение блоков и генерация файла — следующий инкремент.
        </div>
    </div>
{% endblock %}
