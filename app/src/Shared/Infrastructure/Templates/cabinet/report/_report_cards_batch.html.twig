{% for r in reports %}
    <div class="ecard">
        <a class="ecard-media" href="{{ path('app_cabinet_report_fill', {id: r.id}) }}"><i class="bi bi-clipboard-data"></i></a>
        <div class="ecard-body">
            <div class="ecard-head">
                <a class="ecard-title" href="{{ path('app_cabinet_report_fill', {id: r.id}) }}">{{ r.actNumber ? '№ ' ~ r.actNumber : 'Без номера' }}</a>
                {% include 'cabinet/report/_status_pill.html.twig' with {status: r.status, label: r.statusLabel} only %}
                <div class="ecard-kebab dropdown" data-controller="dropdown-portal">
                    <button class="btn btn-sm btn-link text-body-secondary p-1" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false" aria-label="Действия">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_cabinet_report_download', {id: r.id}) }}">
                                <i class="bi bi-download me-2"></i>Скачать .docx
                            </a>
                        </li>
                        {% if r.status != 'approved' %}
                            <li class="mt-1">
                                <a class="dropdown-item text-danger"
                                   href="{{ path('app_cabinet_report_delete', {id: r.id}) }}"
                                   data-bs-toggle="modal" data-bs-target="#deleteModal"
                                   data-bs-title="отчёт{{ r.actNumber ? ' № ' ~ r.actNumber : '' }}" data-bs-id="{{ r.id }}">
                                    <i class="bi bi-trash3 me-2"></i>Удалить
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
            <div class="ecard-desc">{{ r.typeLabel|default('Отчёт') }}{% if r.projectTitle %} · {{ r.projectTitle }}{% endif %}</div>
            <div class="ecard-meta">
                {% if r.systemTitle %}<span>{{ r.systemTitle }}</span>{% endif %}
                {% if r.customerTitle %}<span>Заказчик: {{ r.customerTitle }}</span>{% endif %}
                {% if r.contractorTitle %}<span>Подрядчик: {{ r.contractorTitle }}</span>{% endif %}
                {% if r.ownerLabel %}<span>Владелец: {{ r.ownerLabel }}</span>{% endif %}
                {% if r.layerCount %}<span>Слоёв: <b>{{ r.layerCount }}</b></span>{% endif %}
                <span class="ms-auto">{{ r.reportDate|default(r.updatedAt) }}</span>
            </div>
        </div>
    </div>
{% endfor %}
