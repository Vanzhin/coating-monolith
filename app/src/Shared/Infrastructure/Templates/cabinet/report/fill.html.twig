{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Заполнение отчёта{% endblock %}

{% macro widget(name, field, value) %}
    {% set t = field.type %}
    {% if t == 'textarea' %}
        <textarea name="{{ name }}" class="form-control" rows="2">{{ value }}</textarea>
    {% elseif t == 'number' %}
        <div class="input-group">
            <input type="number" step="any" name="{{ name }}" value="{{ value }}" class="form-control">
            {% if field.unit %}<span class="input-group-text">{{ field.unit }}</span>{% endif %}
        </div>
    {% elseif t == 'date' %}
        <input type="date" name="{{ name }}" value="{{ value }}" class="form-control">
    {% elseif t == 'enum' %}
        <select name="{{ name }}" class="form-select">
            <option value=""></option>
            {% for opt in field.options %}<option value="{{ opt }}" {{ value == opt ? 'selected' : '' }}>{{ opt }}</option>{% endfor %}
        </select>
    {% elseif t in ['text', 'timerange'] %}
        <input type="text" name="{{ name }}" value="{{ value }}" class="form-control">
    {% else %}
        <div class="text-body-secondary small py-1"><i class="bi bi-hourglass-split"></i> Заполнение — в следующем шаге.</div>
    {% endif %}
{% endmacro %}

{% block content %}
    {% import _self as w %}
    <div class="p-2 p-md-3 col-12 col-lg-9 col-xl-7 mx-auto">
        <div class="d-flex align-items-center justify-content-between mb-3 p-3 rounded-3 bg-body-tertiary">
            <div class="d-flex align-items-center gap-2">
                <a href="{{ path('app_cabinet_report_view', {id: report.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left"></i></a>
                <h2 class="text-body-emphasis mb-0 fs-4">{{ report.typeLabel|default('Отчёт') }}</h2>
            </div>
            {% include 'cabinet/report/_status_pill.html.twig' with {status: report.status, label: report.statusLabel} only %}
        </div>

        {% if error is defined and error %}
            <div class="alert alert-danger">{{ error }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_cabinet_report_fill', {id: report.id}) }}">
            {% for section in sections %}
                <details class="card mb-2" {{ loop.first ? 'open' : '' }}>
                    <summary class="p-3 fw-semibold d-flex align-items-center gap-2" style="cursor:pointer">
                        {{ section.title }}
                        {% if section.readOnly %}<span class="badge text-bg-light ms-auto">заполнено</span>{% endif %}
                    </summary>
                    <div class="p-3 pt-0">
                        {% if section.readOnly %}
                            <div class="text-body-secondary small">Заполнено из выбранной системы. Видно в просмотре, здесь не редактируется.</div>
                        {% else %}
                            {% for field in section.fields %}
                                {% if field.type == 'list' %}
                                    <div class="mb-3" data-controller="report-list-rows">
                                        <label class="form-label fw-semibold">{{ field.label }}</label>
                                        <div data-report-list-rows-target="rows">
                                            {% for row in field.value|default([]) %}
                                                <div class="border rounded-3 p-2 mb-2" data-report-list-rows-target="row">
                                                    {% for sub in field.itemFields %}
                                                        <div class="mb-2">
                                                            <label class="form-label small mb-1">{{ sub.label }}{% if sub.required %} <span class="text-danger">*</span>{% endif %}</label>
                                                            {{ w.widget('content[' ~ section.key ~ '][' ~ field.key ~ '][' ~ loop.parent.loop.index0 ~ '][' ~ sub.key ~ ']', sub, row[sub.key]|default('')) }}
                                                        </div>
                                                    {% endfor %}
                                                    <button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="report-list-rows#remove">Удалить строку</button>
                                                </div>
                                            {% endfor %}
                                        </div>
                                        <template data-report-list-rows-target="template">
                                            <div class="border rounded-3 p-2 mb-2" data-report-list-rows-target="row">
                                                {% for sub in field.itemFields %}
                                                    <div class="mb-2">
                                                        <label class="form-label small mb-1">{{ sub.label }}{% if sub.required %} <span class="text-danger">*</span>{% endif %}</label>
                                                        {{ w.widget('content[' ~ section.key ~ '][' ~ field.key ~ '][__i__][' ~ sub.key ~ ']', sub, '') }}
                                                    </div>
                                                {% endfor %}
                                                <button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="report-list-rows#remove">Удалить строку</button>
                                            </div>
                                        </template>
                                        <button type="button" class="btn btn-soft-success btn-sm" data-action="report-list-rows#add"><i class="bi bi-plus-lg"></i> Добавить</button>
                                    </div>
                                {% else %}
                                    <div class="mb-3">
                                        <label class="form-label">{{ field.label }}{% if field.required %} <span class="text-danger">*</span>{% endif %}</label>
                                        {{ w.widget('content[' ~ section.key ~ '][' ~ field.key ~ ']', field, field.value|default('')) }}
                                    </div>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    </div>
                </details>
            {% endfor %}

            <div class="d-flex gap-2 mt-3 position-sticky bottom-0 py-2 bg-body">
                <button type="submit" name="action" value="save" class="btn btn-outline-primary flex-fill">Сохранить</button>
                <button type="submit" name="action" value="submit" class="btn btn-primary flex-fill">На проверку</button>
            </div>
        </form>
    </div>
{% endblock %}
