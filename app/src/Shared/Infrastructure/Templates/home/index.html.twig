{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Главная{% endblock %}

{# Лендинг без header/footer — фокус на герое и входе. Меню/брендинг — только в кабинете. #}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class="authshell">
        <div class="land-split">
            {# Левая половина (на узком экране — верх): герой. Не меняется при переключении форм. #}
            <div class="ls-left">
                <div class="auth-glow"></div>
                <div class="land-hero">
                    <a href="{{ path('app_homepage') }}" class="auth-logo-mark lg" title="На главную">{{ app_name|first }}</a>
                    <div class="land-title">{{ app_name }}</div>
                    <div class="land-sub">Каталог, подбор и сравнение — в одном приложении. Работает и как сайт, и как установленное приложение.</div>

                    <div class="land-feats">
                        <div class="land-feat">
                            <div class="fi"><i class="bi bi-grid-3x3-gap"></i></div>
                            <div class="ft"><b>Покрытия</b><span>поиск, фильтры и характеристики</span></div>
                        </div>
                        <div class="land-feat">
                            <div class="fi"><i class="bi bi-droplet"></i></div>
                            <div class="ft"><b>Подбор по среде</b><span>под условия эксплуатации</span></div>
                        </div>
                        <div class="land-feat">
                            <div class="fi"><i class="bi bi-arrow-left-right"></i></div>
                            <div class="ft"><b>Сравнение</b><span>варианты рядом</span></div>
                        </div>
                    </div>

                    <a href="{{ path('app_tools_index') }}" class="land-feat land-feat-link">
                        <div class="fi"><i class="bi bi-calculator"></i></div>
                        <div class="ft"><b>Инструменты</b><span>калькуляторы без входа</span></div>
                        <i class="bi bi-chevron-right land-feat-arrow"></i>
                    </a>
                </div>
            </div>

            {# Правая половина (на узком экране — низ): свап вход/регистрация/по-ссылке.
               Переключение — на CSS (radio + :checked), без JS. Каждая форма постит на свой
               роут, так что без JS всё работает. #}
            <div class="ls-right">
                <div class="auth-swap">
                    <input type="radio" name="auth_mode" id="auth-buttons" checked>
                    <input type="radio" name="auth_mode" id="auth-login">
                    <input type="radio" name="auth_mode" id="auth-register">
                    <input type="radio" name="auth_mode" id="auth-link">

                    <div class="auth-panel panel-buttons">
                        <div class="cta-prompt">Начните работу</div>
                        <label for="auth-login" class="auth-btn auth-btn-primary">
                            <i class="bi bi-box-arrow-in-right"></i> Войти
                        </label>
                        <label for="auth-register" class="auth-btn auth-btn-ghost">Регистрация</label>
                        <label for="auth-link" class="auth-mini-swap">Вход по ссылке без пароля</label>
                        <div class="install-hint">
                            {% include '_shell/_install_button.html.twig' with { class: 'btn-sm' } %}
                        </div>
                    </div>

                    <div class="auth-panel panel-login">
                        <label for="auth-buttons" class="auth-back" title="Назад"><i class="bi bi-arrow-left"></i></label>
                        <div class="auth-h">Вход</div>
                        {% include 'security/_login_form.html.twig' %}
                        <label for="auth-link" class="auth-mini-swap">Вход по ссылке без пароля</label>
                    </div>

                    <div class="auth-panel panel-register">
                        <label for="auth-buttons" class="auth-back" title="Назад"><i class="bi bi-arrow-left"></i></label>
                        <div class="auth-h">Регистрация</div>
                        {% include 'security/_register_form.html.twig' %}
                    </div>

                    <div class="auth-panel panel-link">
                        <label for="auth-buttons" class="auth-back" title="Назад"><i class="bi bi-arrow-left"></i></label>
                        <div class="auth-h">Вход по ссылке</div>
                        <p class="auth-s">Пришлём ссылку для одноразового входа. Пароль не нужен.</p>
                        {% include 'security/_login_link_form.html.twig' %}
                        <label for="auth-login" class="auth-mini-swap">← Ко входу с паролем</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
