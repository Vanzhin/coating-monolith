{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Главная{% endblock %}

{# Лендинг без header/footer — фокус на герое и входе. Меню/брендинг — только в кабинете. #}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class="authshell">
        <div class="land-split">
            <div class="ls-left">
                <div class="auth-glow"></div>
                <div class="land-hero">
                    <div class="auth-logo-mark lg">{{ app_name|first }}</div>
                    <div class="land-title">{{ app_name }}</div>
                    <div class="land-sub">Каталог, подбор и сравнение — в одном приложении. Работает и как сайт, и как установленное приложение.</div>

                    <div class="land-feats">
                        <div class="land-feat">
                            <div class="fi"><i class="bi bi-grid-3x3-gap"></i></div>
                            <div class="ft"><b>Покрытия</b><span>поиск, фильтры и характеристики</span></div>
                        </div>
                        <div class="land-feat">
                            <div class="fi"><i class="bi bi-droplet"></i></div>
                            <div class="ft"><b>Подбор по среде</b><span>под условия эксплуатации</span></div>
                        </div>
                        <div class="land-feat">
                            <div class="fi"><i class="bi bi-arrow-left-right"></i></div>
                            <div class="ft"><b>Сравнение</b><span>варианты рядом</span></div>
                        </div>
                    </div>

                    <div class="land-cta">
                        <a href="{{ path('app_login') }}" class="auth-btn auth-btn-primary">
                            <i class="bi bi-box-arrow-in-right"></i> Войти
                        </a>
                        <a href="{{ path('app_sign_up') }}" class="auth-btn auth-btn-ghost">Регистрация</a>
                        <div class="install-hint">
                            {% include '_shell/_install_button.html.twig' with { class: 'btn-sm' } %}
                        </div>
                    </div>
                </div>
            </div>

            {# Десктоп: вход прямо в сплите (на мобиле скрыт — там кнопки CTA выше). #}
            <div class="ls-right">
                <div class="auth-card">
                    <h1 class="auth-h">Вход</h1>
                    {% include 'security/_login_form.html.twig' %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
