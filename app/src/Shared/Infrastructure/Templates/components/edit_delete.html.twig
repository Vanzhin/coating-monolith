{# Действия над сущностью — единый компонент (списки-строки и карточки).
   Кнопки soft (без рамки): Дублировать (info) / Редактировать (primary) / Удалить (danger).
   Адаптивно: на мобиле только иконки, на десктопе (md+) иконка + подпись.
   Удаление — через общий #deleteModal (data-bs-id + подключённый на странице delete_modal).

   Параметры: edit (route), delete (route), id, title; duplicate (route, опц.). #}
{% if duplicate is defined %}
    <a href="{{ path(duplicate, {'from': id}) }}" class="btn btn-sm btn-soft-info" title="Дублировать">
        <i class="bi bi-files"></i><span class="d-none d-md-inline ms-1">Дублировать</span>
    </a>
{% endif %}
<a href="{{ path(edit, {'id': id}) }}" class="btn btn-sm btn-soft-primary" title="Редактировать">
    <i class="bi bi-pencil"></i><span class="d-none d-md-inline ms-1">Редактировать</span>
</a>
{% include 'components/_delete_form.html.twig' with { route: delete, id: id, title: title } only %}
