{# Единая модалка подтверждения удаления (#deleteModal — одна на страницу).
   Триггер — кнопка удаления из _delete_form.html.twig (type=submit + data-bs-toggle="modal"
   + data-bs-title). Логика — Stimulus-контроллер delete-confirm на <body>: arm() запоминает
   форму и ставит заголовок, confirm() сабмитит её. Без JS модалка не участвует — форма
   сабмитится напрямую. Никакого <script> здесь (см. assets/controllers/delete_confirm_controller.js). #}
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center pt-4 pb-2">
                <div class="del-ic"><i class="bi bi-trash3"></i></div>
                <h5 class="modal-title mb-2" id="deleteModalLabel" data-role="title">Удалить?</h5>
                <p class="text-body-secondary small mb-0">Действие необратимо.</p>
            </div>
            <div class="modal-footer border-0 pt-0 d-flex gap-2">
                <button type="button" class="btn btn-secondary flex-fill" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-danger flex-fill" data-bs-dismiss="modal" data-action="click->delete-confirm#confirm">
                    <i class="bi bi-trash3 me-1"></i>Удалить
                </button>
            </div>
        </div>
    </div>
</div>
