{# Блок диапазонного фасета в шторке «Все фильтры»: слайдер (от/до) + пилюли-пресеты
   ОБА сразу видимы (без flip/⟳). Пресет и «Любая» ставят значения слайдера БЕЗ
   авто-сабмита — применяет общий «Показать» шторки. Один range-slider контроллер
   на весь блок (слайдер + пресеты). Служит целью перехода с чипа (id="facet-{facet_id}").

   Args:
     title       — заголовок
     unit        — единица ('°C', '%', 'ч'…)
     name_from   — form field name для 'от'
     name_to     — form field name для 'до'
     from        — int|null, текущее 'от'
     to          — int|null, текущее 'до'
     presets     — list<{from:int, to:int, label:string}>
     min         — int, нижняя граница слайдера
     max         — int, верхняя граница
     step        — int, дефолт 1
     reset_label — string|null, дефолт 'Любая'
     facet_id    — string|null, суффикс id блока (дефолт = name_from) для jump с чипа
#}
{% set reset_label = reset_label|default('Любая') %}
{% set step = step|default(1) %}
{% set facet_id = facet_id|default(name_from) %}
{% set active = from is not null or to is not null %}
<div id="facet-{{ facet_id }}"
     class="facet-block range-slider p-3 mb-2 rounded-3 bg-body-tertiary"
     data-controller="range-slider"
     data-range-slider-min-value="{{ min }}"
     data-range-slider-max-value="{{ max }}"
     data-range-slider-step-value="{{ step }}">
    <h6 class="fw-semibold mb-2">{{ title }} <span class="text-muted small fw-normal">{{ unit }}</span></h6>

    <div class="row g-2 mb-2 align-items-end">
        <div class="col-6">
            <label class="form-label small text-muted mb-1">От</label>
            <div class="input-group input-group-sm">
                <input type="number" name="{{ name_from }}" value="{{ from }}" step="{{ step }}"
                       class="form-control" data-range-slider-target="fromInput"
                       data-action="input->range-slider#typeInput blur->range-slider#blurInput">
                {% if unit != '' %}<span class="input-group-text">{{ unit }}</span>{% endif %}
            </div>
        </div>
        <div class="col-6">
            <label class="form-label small text-muted mb-1">До</label>
            <div class="input-group input-group-sm">
                <input type="number" name="{{ name_to }}" value="{{ to }}" step="{{ step }}"
                       class="form-control" data-range-slider-target="toInput"
                       data-action="input->range-slider#typeInput blur->range-slider#blurInput">
                {% if unit != '' %}<span class="input-group-text">{{ unit }}</span>{% endif %}
            </div>
        </div>
    </div>
    <div class="range-slider-track-wrap">
        <input type="range" min="{{ min }}" max="{{ max }}" step="{{ step }}" value="{{ from|default(min) }}"
               class="range-slider-thumb range-slider-thumb-from" data-range-slider-target="fromRange"
               data-action="input->range-slider#dragRange" aria-label="От">
        <input type="range" min="{{ min }}" max="{{ max }}" step="{{ step }}" value="{{ to|default(max) }}"
               class="range-slider-thumb range-slider-thumb-to" data-range-slider-target="toRange"
               data-action="input->range-slider#dragRange" aria-label="До">
    </div>
    <div class="d-flex justify-content-between mt-1 mb-2">
        <span class="text-muted small">{{ min }}{{ unit }}</span>
        <span class="text-muted small">{{ max }}{{ unit }}</span>
    </div>

    <div class="d-flex flex-wrap gap-1" data-range-preset-group>
        <button type="button" data-range-preset="reset"
                class="btn btn-sm rounded-pill {% if not active %}btn-primary{% else %}btn-outline-secondary{% endif %}"
                data-action="click->range-slider#resetPreset">{{ reset_label }}</button>
        {% for p in presets %}
            {% set active_preset = p.from is same as from and p.to is same as to %}
            <button type="button" data-range-preset
                    class="btn btn-sm rounded-pill {% if active_preset %}btn-primary{% else %}btn-outline-primary{% endif %}"
                    data-from="{{ p.from }}" data-to="{{ p.to }}"
                    data-action="click->range-slider#preset">
                {{ p.label }}
            </button>
        {% endfor %}
    </div>
</div>
