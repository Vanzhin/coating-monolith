{% extends '/cabinet/index.html.twig' %}

{% set inputData = inputData|default({}) %}
{% set isUpdate = inputData.id is defined and inputData.id %}
{% set pageTitle = isUpdate ? 'Обновление профиля' : 'Добавление профиля' %}
{% set submitLabel = isUpdate ? 'Сохранить' : 'Добавить' %}
{% set listUrl = path('app_cabinet_personnel_profile_list') %}
{% set formId = 'profile-form' %}
{% set actionUrl = isUpdate
    ? path('app_cabinet_personnel_profile_update', {id: inputData.id})
    : path('app_cabinet_personnel_profile_create') %}
{% set anchors = [
    {id: 'sec-person', label: 'Сотрудник'},
    {id: 'sec-work',   label: 'Работа'},
    {id: 'sec-sizes',  label: 'Размеры СИЗ'},
] %}

{% block title %}{{ parent() }} | {{ pageTitle }}{% endblock %}

{% block content %}
    {% embed 'components/form_page.html.twig' with {
        title: pageTitle, back_url: listUrl, save_form_id: formId, save_label: submitLabel, anchors: anchors,
    } %}
        {% block sections %}
            <form id="{{ formId }}" method="post" action="{{ actionUrl }}" class="w-100">
                {% if error is defined and error %}
                    <div class="form-alert" role="alert">
                        <i class="bi bi-exclamation-octagon"></i>
                        <div>
                            <div class="form-alert-title">Не удалось сохранить</div>
                            <div>{{ error }}</div>
                        </div>
                    </div>
                {% endif %}

                <div id="sec-person" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <h6 class="fw-semibold mb-3">Сотрудник</h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label for="inputLastName" class="form-label">Фамилия</label>
                            <input type="text" value="{{ inputData.lastName|default('') }}" name="lastName" id="inputLastName"
                                   class="form-control" required autofocus maxlength="100" placeholder="Например, Иванов">
                        </div>
                        <div class="col-md-4">
                            <label for="inputFirstName" class="form-label">Имя</label>
                            <input type="text" value="{{ inputData.firstName|default('') }}" name="firstName" id="inputFirstName"
                                   class="form-control" required maxlength="100" placeholder="Например, Иван">
                        </div>
                        <div class="col-md-4">
                            <label for="inputMiddleName" class="form-label">Отчество</label>
                            <input type="text" value="{{ inputData.middleName|default('') }}" name="middleName" id="inputMiddleName"
                                   class="form-control" maxlength="100" placeholder="Необязательно">
                        </div>

                        {% if not isUpdate %}
                            <div class="col-md-6"
                                 data-controller="async-typeahead"
                                 data-async-typeahead-endpoint-value="{{ path('app_cabinet_users_suggest') }}"
                                 data-async-typeahead-placeholder-value="Начните вводить email…"
                                 data-async-typeahead-min-length-value="1">
                                <label for="userSelect" class="form-label">Пользователь платформы</label>
                                <select id="userSelect" name="userUlid" data-async-typeahead-target="select" required>
                                    <option value="">Выберите...</option>
                                    {% if inputData.userUlid is defined and inputData.userUlid %}
                                        <option value="{{ inputData.userUlid }}" selected>{{ inputData.userUlidTitle|default('') }}</option>
                                    {% endif %}
                                </select>
                                <div class="form-text">Привязка к учётной записи задаётся один раз — сменить её позже нельзя.</div>
                            </div>
                        {% else %}
                            <div class="col-md-6">
                                <label class="form-label">Пользователь платформы</label>
                                <input type="text" class="form-control" value="{{ inputData.userUlid|default('') }}" disabled>
                                <div class="form-text">Привязка к учётной записи неизменна после создания профиля.</div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div id="sec-work" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <h6 class="fw-semibold mb-3">Работа</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="inputPosition" class="form-label">Должность</label>
                            <input type="text" id="inputPosition" class="form-control"
                                   data-controller="typeahead"
                                   data-typeahead-endpoint-value="{{ path('app_cabinet_personnel_position_suggest') }}"
                                   data-typeahead-create-url-value="{{ path('app_cabinet_personnel_position_quick') }}"
                                   data-typeahead-hidden-name-value="positionId"
                                   data-typeahead-min-length-value="1"
                                   {% if inputData.positionId is defined and inputData.positionId %}
                                       data-typeahead-existing-value="{{ {id: inputData.positionId, title: inputData.positionTitle|default('')}|json_encode|e('html_attr') }}"
                                   {% endif %}
                                   placeholder="Поиск или создать…">
                        </div>
                        <div class="col-md-6"
                             data-controller="async-typeahead"
                             data-async-typeahead-endpoint-value="{{ path('app_cabinet_reports_counterparty_suggest') }}"
                             data-async-typeahead-placeholder-value="Найти организацию…"
                             data-async-typeahead-min-length-value="1">
                            <label for="organizationSelect" class="form-label">Организация</label>
                            <select id="organizationSelect" name="organizationId" data-async-typeahead-target="select" required>
                                <option value="">Выберите...</option>
                                {% if inputData.organizationId is defined and inputData.organizationId %}
                                    <option value="{{ inputData.organizationId }}" selected>{{ inputData.organizationTitle|default('') }}</option>
                                {% endif %}
                            </select>
                        </div>
                        <div class="col-md-6"
                             data-controller="async-typeahead"
                             data-async-typeahead-endpoint-value="{{ path('app_cabinet_personnel_department_suggest') }}"
                             data-async-typeahead-placeholder-value="Найти отдел…"
                             data-async-typeahead-min-length-value="1">
                            <label for="departmentSelect" class="form-label">Отдел</label>
                            <select id="departmentSelect" name="departmentId" data-async-typeahead-target="select" required>
                                <option value="">Выберите...</option>
                                {% if inputData.departmentId is defined and inputData.departmentId %}
                                    <option value="{{ inputData.departmentId }}" selected>{{ inputData.departmentTitle|default('') }}</option>
                                {% endif %}
                            </select>
                            <div class="form-text">Отдел должен принадлежать выбранной организации — иначе сервер вернёт ошибку.</div>
                        </div>
                        <div class="col-md-3">
                            <label for="inputPersonnelNumber" class="form-label">Табельный номер</label>
                            <input type="text" value="{{ inputData.personnelNumber|default('') }}" name="personnelNumber" id="inputPersonnelNumber"
                                   class="form-control" maxlength="50" placeholder="Например, 1042">
                        </div>
                        <div class="col-md-3">
                            <label for="inputHiredAt" class="form-label">Дата приёма</label>
                            <input type="date" value="{{ inputData.hiredAt|default('') }}" name="hiredAt" id="inputHiredAt"
                                   class="form-control">
                        </div>
                    </div>
                </div>

                <div id="sec-sizes" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <h6 class="fw-semibold mb-3">Размеры СИЗ</h6>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label for="inputClothing" class="form-label">Размер одежды</label>
                            <input type="text" value="{{ inputData.clothing|default('') }}" name="clothing" id="inputClothing"
                                   class="form-control" maxlength="20" placeholder="Например, 52-54">
                        </div>
                        <div class="col-md-3">
                            <label for="inputShoes" class="form-label">Размер обуви</label>
                            <input type="text" value="{{ inputData.shoes|default('') }}" name="shoes" id="inputShoes"
                                   class="form-control" maxlength="20" placeholder="Например, 42">
                        </div>
                        <div class="col-md-3">
                            <label for="inputHeadgear" class="form-label">Размер головного убора</label>
                            <input type="text" value="{{ inputData.headgear|default('') }}" name="headgear" id="inputHeadgear"
                                   class="form-control" maxlength="20" placeholder="Например, 56">
                        </div>
                        <div class="col-md-3">
                            <label for="inputGasMask" class="form-label">Размер противогаза</label>
                            <input type="text" value="{{ inputData.gasMask|default('') }}" name="gasMask" id="inputGasMask"
                                   class="form-control" maxlength="20" placeholder="Например, 2">
                        </div>
                        <div class="col-md-3">
                            <label for="inputRespirator" class="form-label">Размер респиратора</label>
                            <input type="text" value="{{ inputData.respirator|default('') }}" name="respirator" id="inputRespirator"
                                   class="form-control" maxlength="20">
                        </div>
                        <div class="col-md-3">
                            <label for="inputGloves" class="form-label">Размер перчаток</label>
                            <input type="text" value="{{ inputData.gloves|default('') }}" name="gloves" id="inputGloves"
                                   class="form-control" maxlength="20" placeholder="Например, 9">
                        </div>
                        <div class="col-md-3">
                            <label for="inputHeight" class="form-label">Рост</label>
                            <input type="text" value="{{ inputData.height|default('') }}" name="height" id="inputHeight"
                                   class="form-control" maxlength="20" placeholder="Например, 176">
                        </div>
                        <div class="col-md-3">
                            <label for="inputGender" class="form-label">Пол</label>
                            <select name="gender" id="inputGender" class="form-select">
                                <option value="">Не указан</option>
                                {% for g in genders %}
                                    <option value="{{ g.value }}" {{ inputData.gender|default('') == g.value ? 'selected' : '' }}>{{ g.title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            </form>
        {% endblock %}
    {% endembed %}
{% endblock %}
