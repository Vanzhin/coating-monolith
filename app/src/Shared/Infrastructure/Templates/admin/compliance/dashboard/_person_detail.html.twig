{# Деталь человека: группы требований + таблица позиций. Только просмотр ситуации — действия цикла документа
   (выдать/списать) живут на странице выдачи требования. Только Bootstrap. #}
{% set badge = {ok: 'text-bg-success', soon: 'text-bg-warning', overdue: 'text-bg-danger', missing: 'text-bg-danger'} %}
{% set icon = {ok: 'bi-check-circle', soon: 'bi-clock', overdue: 'bi-exclamation-triangle', missing: 'bi-x-circle'} %}

{% for g in person.groups %}
    {% set hasRecords = g.rows|filter(r => r.lastFulfilledAt is not null) is not empty %}
    <div class="p-3 mb-3 rounded-3 bg-body-tertiary">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <span class="fw-semibold">{{ g.name }}</span>
            <span class="badge text-bg-light">{{ g.typeLabel }}</span>
            {% if hasRecords %}
                <span class="badge text-bg-success"><i class="bi bi-journal-check me-1"></i>Есть записи</span>
            {% else %}
                <span class="badge text-bg-light"><i class="bi bi-journal-x me-1"></i>Нет записей</span>
            {% endif %}
        </div>

        {# Позиции — блоками (оттенком), не строками таблицы: единый вид у материального и процедуры,
           статус выровнен справа у всех; норма и даты — приглушённой подстрокой. #}
        <div class="d-flex flex-column gap-2">
            {% for r in g.rows %}
                <div class="bg-body rounded-3 p-2">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <span class="fw-medium" style="min-width:0">{{ r.label }}</span>
                        <span class="badge {{ badge[r.bucket] }} flex-shrink-0"><i class="bi {{ icon[r.bucket] }} me-1"></i>{{ r.bucketLabel }}</span>
                    </div>
                    <div class="d-flex flex-wrap gap-3 small text-body-secondary mt-1">
                        <span>{{ r.spec }}</span>
                        <span>Посл.: <span class="tnum">{{ r.lastFulfilledAt ?? '—' }}</span></span>
                        <span>След. срок: <span class="tnum">{{ r.nextDueAt ?? '—' }}</span></span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endfor %}
