{% extends '/cabinet/index.html.twig' %}

{% set fio = profile.lastName ~ ' ' ~ profile.firstName ~ (profile.middleName ? ' ' ~ profile.middleName : '') %}
{% set backUrl = path('app_cabinet_compliance_issue', {profileId: profileId, requirementId: requirementId}) %}

{% block title %}{{ parent() }} | Акт списания — {{ fio }}{% endblock %}

{% block content %}
    {% embed 'components/form_page.html.twig' with {
        title: 'Акт списания — ' ~ fio,
        back_url: backUrl,
        save_enabled: false,
        save_form_id: 'wo-act-form',
        save_label: 'Оформить',
        anchors: draft ? [{id: 'sec-commission', label: 'Комиссия'}, {id: 'sec-scan', label: 'Скан'}, {id: 'sec-items', label: 'Позиции'}] : [{id: 'sec-items', label: 'Позиции'}],
    } %}
        {% block sections %}
            {% if error is defined and error %}
                <div class="form-alert mb-3" role="alert">
                    <i class="bi bi-exclamation-octagon"></i>
                    <div><div class="form-alert-title">Не удалось сохранить</div><div>{{ error }}</div></div>
                </div>
            {% endif %}

            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <span class="badge {{ draft ? 'text-bg-secondary' : 'text-bg-success' }}">
                    <i class="bi {{ draft ? 'bi-file-earmark-text' : 'bi-lock-fill' }} me-1"></i>{{ draft ? 'Черновик' : 'Оформлен' }}{% if actNumber %} · № {{ actNumber }}{% endif %}
                </span>
                {% if not draft %}
                    <div class="ms-auto d-flex flex-wrap gap-2">
                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_writeoff_download', {profileId: profileId, actId: actId}) }}">
                            <i class="bi bi-file-earmark-word me-1"></i>Скачать акт
                        </a>
                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_writeoff_scan', {profileId: profileId, actId: actId}) }}">
                            <i class="bi bi-download me-1"></i>Скан
                        </a>
                    </div>
                {% endif %}
            </div>

            {% if draft %}
                <form id="wo-act-form" method="post" action="{{ path('app_cabinet_compliance_writeoff_show', {profileId: profileId, actId: actId}) }}"
                      data-controller="staged-file" data-staged-file-stage-url-value="{{ path('app_cabinet_file_stage') }}">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                        <h2 class="h6 mb-0">Акт списания</h2>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" name="op" value="save" class="btn btn-soft-success btn-sm">
                                <i class="bi bi-save me-1"></i>Сохранить черновик
                            </button>
                            <button type="submit" name="op" value="sign" class="btn btn-primary btn-sm">
                                <i class="bi bi-check-lg me-1"></i>Оформить
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm"
                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-bs-title="акт списания"
                                    data-bs-url="{{ path('app_cabinet_compliance_writeoff_delete', {profileId: profileId, actId: actId}) }}">
                                <i class="bi bi-trash3 me-1"></i>Удалить
                            </button>
                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_writeoff_download', {profileId: profileId, actId: actId}) }}">
                                <i class="bi bi-file-earmark-word me-1"></i>Скачать акт
                            </a>
                        </div>
                    </div>
                    <div class="form-text mb-2">Сохраните черновик — тогда в акт попадут № и комиссия. Для оформления приложите скан и нажмите «Оформить».</div>

                    <div id="sec-commission" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                        <h2 class="h6 mb-3">Комиссия и реквизиты</h2>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small mb-1">№ акта</label>
                                <input type="text" name="actNumber" class="form-control" value="{{ actNumber|default('') }}">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">Дата акта</label>
                                <input type="date" name="actDate" class="form-control" value="{{ actDate }}">
                            </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small mb-1">№ приказа</label>
                                <input type="text" name="orderNumber" class="form-control" value="{{ orderNumber|default('') }}">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">Дата приказа</label>
                                <input type="date" name="orderDate" class="form-control" value="{{ orderDate|default('') }}">
                            </div>
                        </div>
                        <label class="form-label fw-semibold">Представитель отдела ОТ и ПБ</label>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small mb-1">Должность</label>
                                <input type="text" name="representativePosition" class="form-control" value="{{ representativePosition|default('') }}">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small mb-1">Фамилия И. О.</label>
                                <input type="text" name="representativeFio" class="form-control" value="{{ representativeFio|default('') }}">
                            </div>
                        </div>
                        <label class="form-label fw-semibold">Члены комиссии</label>
                        {% include 'components/commission_editor.html.twig' with {prefix: 'commission', rows: commissionRows|default([])} %}
                    </div>

                    <div id="sec-scan" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                        <h2 class="h6 mb-2">Скан подписанного акта</h2>
                        <input type="file" class="form-control" data-action="change->staged-file#upload" accept=".pdf,.jpg,.jpeg,.png">
                        <div class="form-text">Скачайте акт, подпишите комиссией, приложите скан — тогда списание вступит в силу.</div>
                        <input type="hidden" name="stagedFileId" data-staged-file-target="hidden" value="">
                        <div class="text-body-secondary small mt-1" data-staged-file-target="name"></div>
                    </div>

                    <div id="sec-items" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <h2 class="h6 mb-0">Позиции к списанию</h2>
                        </div>
                        {% if positions is empty %}
                            <div class="p-4 rounded-3 bg-body text-center text-body-secondary">Нет действующих позиций для списания.</div>
                        {% endif %}
                        {% for p in positions %}
                            {% embed 'admin/compliance/_item_card.html.twig' with {name: p.label, meta: p.meta, p: p, i: loop.index0, reasons: reasons} %}
                                {% block control %}
                                    <div class="text-end" style="width: 8rem;">
                                        <label class="form-label small mb-1">Списать</label>
                                        <div class="d-flex align-items-baseline gap-1 justify-content-end">
                                            <input type="number" min="0" max="{{ p.held }}" step="any" inputmode="decimal" class="form-control form-control-sm"
                                                   name="portions[{{ i }}][quantity]" value="{{ p.quantity }}" placeholder="0">
                                            <span class="text-body-secondary small">{{ p.unit }}</span>
                                        </div>
                                    </div>
                                {% endblock %}
                                {% block footer %}
                                    <input type="hidden" name="portions[{{ i }}][recordId]" value="{{ p.recordId }}">
                                    <div class="w-100">
                                        <label class="form-label small mb-1">Причина</label>
                                        <select name="portions[{{ i }}][reason]" class="form-select form-select-sm">
                                            <option value="">— выберите —</option>
                                            {% for r in reasons %}<option value="{{ r.value }}"{{ p.reason == r.value ? ' selected' : '' }}>{{ r.title }}</option>{% endfor %}
                                        </select>
                                    </div>
                                {% endblock %}
                            {% endembed %}
                        {% endfor %}
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </form>

                {% include 'components/delete_modal.html.twig' %}
            {% else %}
                <div id="sec-items" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <h2 class="h6 mb-3">Списано{% if actDate %} · {{ actDate }}{% endif %}</h2>
                    {% for it in signedItems %}
                        {% embed 'admin/compliance/_item_card.html.twig' with {name: it.label, meta: it.meta, it: it} %}
                            {% block control %}
                                <div class="text-end">
                                    <div class="small text-body-secondary mb-1">Списано</div>
                                    <span class="badge text-bg-danger fw-normal">{{ it.quantityLabel }}</span>
                                </div>
                            {% endblock %}
                            {% block footer %}
                                {% if it.reason %}<div class="w-100 text-body-secondary small">Причина: {{ it.reason }}</div>{% endif %}
                            {% endblock %}
                        {% endembed %}
                    {% endfor %}
                </div>

                {% if commissionMembers is not empty %}
                    <div class="p-3 mb-3 rounded-3 bg-body-tertiary fsec">
                        <h2 class="h6 mb-2">Комиссия</h2>
                        {% for m in commissionMembers %}
                            <div class="small">{{ m.position }}{% if m.position and m.fio %} — {% endif %}{{ m.fio }}{% if m.organization %} · {{ m.organization }}{% endif %}{% if m.date %} · {{ m.date }}{% endif %}</div>
                        {% endfor %}
                    </div>
                {% endif %}
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
