{% extends '/cabinet/index.html.twig' %}

{% set fio = profile.fio %}
{% set backUrl = path('app_cabinet_compliance_dashboard', {profile: profileId}) %}
{# Выдача доступна всегда; списание — параллельный блок. Показываем секцию, когда есть что списывать (held) или
   есть открытый черновик акта (корзина) — его единственного тут и показываем; оформленные акты доступны ссылкой
   из истории позиции, списком их больше не дублируем. #}
{% set draftAct = (writeOffActs|default([]))|filter(a => not a.signed)|first %}
{% set woPresent = canWriteOff|default(false) or draftAct is not null %}
{# Статус-бейдж карточки позиции — тот же бакет/резолвер, что у дашборда (admin/compliance/dashboard/_person_detail.html.twig). #}
{% set bucketBadge = {ok: 'text-bg-success', soon: 'text-bg-warning', overdue: 'text-bg-danger', missing: 'text-bg-danger'} %}
{% set bucketIcon = {ok: 'bi-check-circle', soon: 'bi-clock', overdue: 'bi-exclamation-triangle', missing: 'bi-x-circle'} %}

{# Строка добавляемой персональной позиции (вне нормы). Один макрос на server-render существующих строк и на
   <template> новой — чтобы не дублировать разметку. Поля кол-ва/ед. — под требованием, несущим количество
   (material/periodic); админ заполнит их или оставит пустыми — ad-hoc позиция не привязана к норме/проекции,
   поэтому точного «это инструктаж» тут не определить (это признак КОНКРЕТНОЙ позиции нормы, не требования). #}
{% macro personal_row(prefix, row, requirementType, units, instructionGroups, requirementRequiresQuantity, requirementAllowsMixed) %}
    <div class="p-3 mb-2 rounded-3 bg-body" data-report-list-rows-target="row">
        <div class="row g-2">
            <div class="col-12 col-md-5">
                <label class="form-label small mb-1">Наименование</label>
                <input type="text" name="{{ prefix }}[label]" value="{{ row.label|default('') }}" class="form-control">
            </div>
            {% if requirementType == 'material' %}
                <div class="col-12 col-md-7">
                    <label class="form-label small mb-1">Модель / марка / артикул</label>
                    <input type="text" name="{{ prefix }}[note]" value="{{ row.note|default('') }}" class="form-control" placeholder="Модель, марка, артикул, класс защиты">
                </div>
            {% endif %}
            {% if requirementRequiresQuantity %}
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">Кол-во</label>
                    <input type="number" min="0" step="any" inputmode="decimal" name="{{ prefix }}[amount]" value="{{ row.amount|default('') }}" class="form-control">
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">Ед.</label>
                    <select name="{{ prefix }}[unit]" class="form-select">
                        {% for u in units %}<option value="{{ u.value }}"{{ row.unit|default('') == u.value ? ' selected' : '' }}>{{ u.title }}</option>{% endfor %}
                    </select>
                </div>
            {% endif %}
            {% if requirementAllowsMixed %}
                {# Вне нормы позиция на смешанной «Выдаче» может быть и инвентарём, и расходником (см.
                   admin/compliance/requirements/_macros.html.twig item_row — тот же выбор у норменной позиции):
                   дефолт — инвентарь, домен хендлера подставит его же, если поле не придёт вовсе. #}
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">Вид</label>
                    <select name="{{ prefix }}[type]" class="form-select">
                        <option value="material"{{ row.type|default('material') == 'material' ? ' selected' : '' }}>Инвентарь</option>
                        <option value="periodic"{{ row.type|default('material') == 'periodic' ? ' selected' : '' }}>Расходник</option>
                    </select>
                </div>
            {% endif %}
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Срок окончания</label>
                <input type="date" name="{{ prefix }}[manualDueDate]" value="{{ row.manualDueDate|default('') }}" class="form-control">
            </div>
        </div>
        {% if requirementType != 'material' and instructionGroups|default([]) is not empty %}
            {% for grp in instructionGroups %}
                <div class="mt-2 p-2 rounded-3 bg-body-tertiary">
                    {% if grp.label %}<div class="small fw-semibold text-body-secondary mb-2">{{ grp.label }}</div>{% endif %}
                    <div class="row g-2">
                        {% for f in grp.fields %}
                            {% set ival = row.instruction[f.key]|default('') %}
                            <div class="col-12 col-md-6">
                                <label class="form-label small mb-1">{{ f.label }}{% if f.required %} <span class="text-danger">*</span>{% endif %}</label>
                                {% if f.kind == 'select' %}
                                    <select name="{{ prefix }}[instruction][{{ f.key }}]" class="form-select">
                                        <option value="">—</option>
                                        {% for opt in f.options %}<option value="{{ opt }}"{{ ival == opt ? ' selected' : '' }}>{{ opt }}</option>{% endfor %}
                                    </select>
                                {% elseif f.kind == 'date' %}
                                    <input type="date" name="{{ prefix }}[instruction][{{ f.key }}]" value="{{ ival }}" class="form-control">
                                {% elseif f.kind == 'text_list' %}
                                    <textarea name="{{ prefix }}[instruction][{{ f.key }}]" rows="2" class="form-control" placeholder="По одному на строку">{{ ival }}</textarea>
                                {% else %}
                                    <input type="text" name="{{ prefix }}[instruction][{{ f.key }}]" value="{{ ival }}" class="form-control">
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
        {% endif %}
        <button type="button" class="btn btn-sm btn-outline-danger mt-2" data-action="report-list-rows#remove"><i class="bi bi-trash"></i></button>
    </div>
{% endmacro %}

{% block title %}{{ parent() }} | Выдача — {{ requirementName }}{% endblock %}

{% block content %}
    {% set anchors = [{id: 'sec-doc', label: 'Документ'}, {id: 'sec-items', label: 'Позиции'}] %}
    {% if woPresent %}{% set anchors = anchors|merge([{id: 'sec-writeoff', label: 'Списание'}]) %}{% endif %}
    {% embed 'components/form_page.html.twig' with {
        title: 'Выдача — ' ~ requirementName,
        back_url: backUrl,
        save_enabled: false,
        save_form_id: 'issue-form',
        save_label: 'Записать выдачу',
        anchors: anchors,
        page_controller: 'issue-selection',
    } %}
        {% block sections %}
            {% if error is defined and error %}
                <div class="form-alert mb-3" role="alert">
                    <i class="bi bi-exclamation-octagon"></i>
                    <div><div class="form-alert-title">Не удалось сохранить</div><div>{{ error }}</div></div>
                </div>
            {% endif %}

            <form id="issue-form" method="post" novalidate
                  data-controller="norm-fill" data-norm-fill-next-due-url-value="{{ path('app_cabinet_compliance_next_due') }}">

                <div id="sec-doc" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                        <h2 class="h6 mb-0">Документ</h2>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_card_download', {profileId: profileId, requirementId: requirementId}) }}">
                                <i class="bi bi-file-earmark-word me-1"></i>Скачать бланк
                            </a>
                        </div>
                    </div>
                    <div class="form-text mb-2">Выдача пишется прямо в журнал и сразу становится действующей — черновика нет.</div>
                    <div class="text-body-secondary small mb-3">{{ fio }} · {{ profile.positionTitle }}</div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small mb-1">Дата документа</label>
                            <input type="date" name="documentDate" value="{{ documentDate }}" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-1">№ карточки СИЗ</label>
                            {% if cardNumber %}
                                {# Номер уже закреплён (первая выдача задала его) — readonly, дальше не меняется. #}
                                <input type="text" name="cardNumber" value="{{ cardNumber }}" class="form-control" readonly>
                            {% else %}
                                {# Первая выдача: номер ещё не закреплён — редактируемое поле, предзаполнено табельным. #}
                                <input type="text" name="cardNumber" value="{{ inputData.cardNumber|default(profile.personnelNumber) }}" class="form-control" required>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div id="sec-items" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                        <h2 class="h6 mb-0">Позиции</h2>
                        <div class="d-flex align-items-center gap-3">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="select-all"
                                       data-issue-selection-target="all" data-action="change->issue-selection#toggleAll">
                                <label class="form-check-label small" for="select-all">Выбрать все</label>
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-action="norm-fill#fill">
                                <i class="bi bi-magic me-1"></i>Заполнить по норме
                            </button>
                        </div>
                    </div>

                    {% if rows is empty %}
                        <div class="p-4 rounded-3 bg-body text-center text-body-secondary">Нет подошедших позиций.</div>
                    {% endif %}

                    {% for o in rows %}
                        {% if o.writeOffOnly %}
                            {# /issue — экран ТОЛЬКО действий (выдать/списать): позиция мягко убрана из нормы
                               требования, но держит held>0 — рендерится ПОЛНОЙ карточкой, как активная (имя,
                               периодичность/норма/последняя выдача, «на руках»), но ЗАМОРОЖЕННОЙ — замок вместо
                               статус-бейджа, без раскрытия полей выдачи/истории (нечего выдавать). Чекбокс выбора
                               остаётся: joins «Списать выбранные»/уже открытый черновик акта ({@see AddToWriteOffAction}),
                               исключена из «Выдать выбранные» (issue_selection_controller.js по data-writeoff-only).
                               «Восстановить» тут НЕТ — это действие нормы, доступно только в редакторе требования. #}
                            <div class="opacity-75">
                            {% embed 'admin/compliance/_item_card.html.twig' with {
                                name: o.label,
                                select_name: 'woItems[' ~ loop.index0 ~ '][selected]',
                                select_checked: false,
                                select_attrs: 'data-issue-selection-target="check" data-action="change->issue-selection#toggle" data-writeoff-only="1" data-key="' ~ o.key|e('html_attr') ~ '" data-label="' ~ o.label|e('html_attr') ~ '" data-held="' ~ o.held ~ '" data-unit-title="' ~ (o.unitTitle ?? '')|e('html_attr') ~ '"',
                            } %}
                                {% block meta %}
                                    <div class="text-body-secondary small">
                                        <i class="bi bi-clock-history me-1" title="Периодичность"></i>{{ o.cadenceLabel }}{% if o.quantityLabel %} · <i class="bi bi-box-seam me-1" title="Норма"></i>{{ o.quantityLabel }}{% endif %}{% if o.lastFulfilledAt %} · <i class="bi bi-calendar-check me-1" title="Последняя выдача"></i>{{ o.lastFulfilledAt }}{% endif %}
                                    </div>
                                {% endblock %}
                                {% block control %}
                                    <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                        <span class="badge text-bg-secondary fw-normal"><i class="bi bi-lock me-1"></i>удалено из нормы</span>
                                        <span class="badge text-bg-{{ o.heldTone }} fw-normal">на руках {{ o.held }}{% if o.quantityValue %} / {{ o.quantityValue }}{% endif %} {{ o.unitTitle }}</span>
                                    </div>
                                {% endblock %}
                                {% block footer %}
                                    {# Замороженная позиция (удалена из нормы): полей выдачи нет — выдавать нельзя,
                                       но ЛЕНИВАЯ история остаётся: по журналу выдач/списаний решают, что списать. Тот же
                                       механизм, что у активной карточки (obligation_history_controller + /obligation/history),
                                       ключ — o.key; эндпоинт фактовый, активность/удалённость позиции ему безразлична. #}
                                    <div class="w-100">
                                        <div class="small text-body-secondary d-inline-flex align-items-center gap-1 report-block-toggle" role="button"
                                             data-bs-toggle="collapse" data-bs-target="#hist-{{ loop.index0 }}" aria-expanded="false" aria-controls="hist-{{ loop.index0 }}">
                                            <i class="bi bi-clock-history"></i>История
                                            <i class="bi bi-chevron-down report-block-chevron"></i>
                                        </div>
                                        <div class="collapse mt-2" id="hist-{{ loop.index0 }}"
                                             data-controller="obligation-history"
                                             data-obligation-history-url-value="{{ path('app_cabinet_compliance_obligation_history', {profileId: profileId, requirementId: requirementId, key: o.key}) }}"
                                             data-action="show.bs.collapse->obligation-history#load">
                                            <div data-obligation-history-target="body">
                                                <div class="p-3 rounded-3 bg-body-tertiary text-center text-body-secondary small">
                                                    <i class="bi bi-hourglass-split me-1"></i>Загрузка…
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% endblock %}
                            {% endembed %}
                            </div>
                        {% else %}
                        {# Единая карточка позиции: EAGER-бейдж/норма/на руках/сроки (control) + EAGER-форма
                           выдачи и LAZY-история (footer) — см. IssueAction PHPDoc. #}
                        {% embed 'admin/compliance/_item_card.html.twig' with {
                            name: o.label,
                            attrs: 'data-row',
                            toggle: 'issue-' ~ loop.index0, expanded: o.selected,
                            select_name: 'items[' ~ loop.index0 ~ '][selected]',
                            select_checked: o.selected,
                            select_attrs: 'data-issue-selection-target="check" data-action="change->issue-selection#toggle click->issue-selection#stop" data-key="' ~ o.key|e('html_attr') ~ '" data-label="' ~ o.label|e('html_attr') ~ '" data-held="' ~ o.held ~ '" data-unit-title="' ~ (o.unitTitle ?? '')|e('html_attr') ~ '"',
                            o: o, i: loop.index0, units: units, documentDate: documentDate,
                            s: inputData.items[loop.index0]|default({}),
                            instructionGroups: instructionGroups|default([]),
                            savedInstruction: o.savedInstruction|default({}),
                        } %}
                            {% block meta %}
                                <div class="text-body-secondary small">
                                    <i class="bi bi-clock-history me-1" title="Периодичность"></i>{{ o.cadenceLabel }}{% if o.quantityLabel and not o.hideQuantity %} · <i class="bi bi-box-seam me-1" title="Норма"></i>{{ o.quantityLabel }}{% endif %}{% if o.lastFulfilledAt %} · <i class="bi bi-calendar-check me-1" title="Последняя выдача"></i>{{ o.lastFulfilledAt }}{% endif %}{% if o.nextDueAt %} · <i class="bi bi-arrow-repeat me-1" title="Следующая выдача"></i>{{ o.nextDueAt }}{% endif %}
                                </div>
                            {% endblock %}
                            {% block control %}
                                <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                    <span class="badge {{ bucketBadge[o.bucket] }} fw-normal"><i class="bi {{ bucketIcon[o.bucket] }} me-1"></i>{{ o.bucketLabel }}</span>
                                    {# Инструктаж (периодическая, норма 1 шт) — количество не несёт смысла, прячем «на руках». #}
                                    {% if o.quantityValue and not o.hideQuantity %}
                                        <span class="badge text-bg-{{ o.heldTone }} fw-normal">на руках {{ o.held }}{% if o.quantityValue %} / {{ o.quantityValue }}{% endif %} {{ o.unitTitle }}</span>
                                    {% endif %}
                                </div>
                            {% endblock %}
                            {% block footer %}
                                <input type="hidden" name="items[{{ i }}][obligationKey]" value="{{ o.key }}">
                                {% if o.origin == 'personal' %}
                                    {# Убрать личную (off-norm) позицию из учёта человека через общую модалку подтверждения
                                       (#deleteModal): ключ — query-параметр в data-bs-url, подтверждение шлёт POST с CSRF. #}
                                    <button type="button" class="btn btn-sm btn-outline-danger mb-2"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal"
                                            data-bs-title="позицию «{{ o.label|e('html_attr') }}» из учёта"
                                            data-bs-url="{{ path('app_cabinet_compliance_obligation_exclude', {profileId: profileId, requirementId: requirementId, obligationKey: o.key}) }}">
                                        <i class="bi bi-trash me-1"></i>Убрать позицию
                                    </button>
                                {% endif %}
                                {# Поля выдачи — сворачиваемы; шапка карточки кликабельна (тоггл в _item_card).
                                   По умолчанию раскрыто у позиций с данными (o.expanded). #}
                                <div class="collapse{{ o.selected ? ' show' : '' }}" id="issue-{{ i }}" data-issue-fields>
                                <div class="row g-2 w-100">
                                    <div class="col-12">
                                        <label class="form-label small mb-1">Наименование</label>
                                        <input type="text" name="items[{{ i }}][note]" value="{{ s.note|default(o.savedNote) }}" class="form-control" placeholder="Модель, марка, артикул, класс защиты">
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label small mb-1">Дата выдачи</label>
                                        <input type="date" name="items[{{ i }}][date]" value="{{ s.date|default(o.savedDate ?: documentDate) }}" class="form-control"
                                               data-issue-date data-action="change->norm-fill#nextDue"
                                               data-cadence-kind="{{ o.cadenceKind }}" data-cadence-number="{{ o.cadenceNumber }}" data-cadence-unit="{{ o.cadenceUnit }}">
                                        <div class="form-text">След. выдача: <span data-next-due>—</span></div>
                                    </div>
                                    {% if o.showAmountInput %}
                                        <div class="col-6 col-md-2">
                                            <label class="form-label small mb-1">Кол-во</label>
                                            <input type="number" min="0" step="any" inputmode="decimal" name="items[{{ i }}][amount]" class="form-control"
                                                   value="{{ s.amount|default(o.deficitValue) }}" placeholder="{{ o.quantityValue ?? '10' }}"
                                                   data-norm-amount="{{ o.quantityValue }}" data-action="input->norm-fill#check change->norm-fill#rowDue">
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label small mb-1">Ед.</label>
                                            {% if o.quantityUnit %}
                                                {# Единица задана обязанностью (норма из требования / персональная с кол-вом) — не меняется (UX), домен это проверяет. #}
                                                <select class="form-select" disabled aria-label="Единица измерения">
                                                    {% for u in units %}<option value="{{ u.value }}"{{ o.quantityUnit == u.value ? ' selected' : '' }}>{{ u.title }}</option>{% endfor %}
                                                </select>
                                                <input type="hidden" name="items[{{ i }}][unit]" value="{{ o.quantityUnit }}">
                                            {% else %}
                                                {# Персональная позиция без заданной единицы — выбираем. #}
                                                <select name="items[{{ i }}][unit]" class="form-select">
                                                    {% for u in units %}<option value="{{ u.value }}"{{ s.unit|default(o.savedUnit) == u.value ? ' selected' : '' }}>{{ u.title }}</option>{% endfor %}
                                                </select>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                    {% if o.type == 'material' %}
                                        <div class="col-6 col-md-2">
                                            <label class="form-label small mb-1">% износа</label>
                                            <input type="number" min="0" max="100" step="any" inputmode="decimal" name="items[{{ i }}][wearPercent]" class="form-control" value="{{ s.wearPercent|default(o.savedWear) }}" placeholder="0">
                                        </div>
                                    {% endif %}
                                    {% if o.cadenceKind == 'by_manufacturer_doc' %}
                                        <div class="col-6 col-md-3">
                                            <label class="form-label small mb-1">Срок годности (по документам)</label>
                                            <input type="date" name="items[{{ i }}][manualDueDate]" class="form-control" value="{{ s.manualDueDate|default(o.savedDueDate) }}">
                                        </div>
                                    {% endif %}
                                </div>
                                {% if o.type != 'material' and instructionGroups is not empty %}
                                    {# Поля инструктажа по схеме журнала (config-first), сгруппированы блоками (теор./практ. часть). #}
                                    {% for grp in instructionGroups %}
                                        <div class="w-100 mt-2 p-2 rounded-3 bg-body">
                                            {% if grp.label %}<div class="small fw-semibold text-body-secondary mb-2">{{ grp.label }}</div>{% endif %}
                                            <div class="row g-2">
                                                {% for f in grp.fields %}
                                                    {% set ival = savedInstruction[f.key]|default('') %}
                                                    <div class="col-12 col-md-6">
                                                        <label class="form-label small mb-1">{{ f.label }}{% if f.required %} <span class="text-danger">*</span>{% endif %}</label>
                                                        {% if f.kind == 'select' %}
                                                            <select name="items[{{ i }}][instruction][{{ f.key }}]" class="form-select">
                                                                <option value="">—</option>
                                                                {% for opt in f.options %}<option value="{{ opt }}"{{ ival == opt ? ' selected' : '' }}>{{ opt }}</option>{% endfor %}
                                                            </select>
                                                        {% elseif f.kind == 'date' %}
                                                            <input type="date" name="items[{{ i }}][instruction][{{ f.key }}]" value="{{ ival }}" class="form-control">
                                                        {% elseif f.kind == 'text_list' %}
                                                            <textarea name="items[{{ i }}][instruction][{{ f.key }}]" rows="2" class="form-control" placeholder="По одному на строку">{{ ival }}</textarea>
                                                        {% else %}
                                                            <input type="text" name="items[{{ i }}][instruction][{{ f.key }}]" value="{{ ival }}" class="form-control">
                                                        {% endif %}
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                                </div>{# /collapse #issue — поля выдачи #}

                                {# История позиции — LAZY: партиал фетчится на первое раскрытие (кэш в DOM), см.
                                   obligation_history_controller.js. Без рамок — оттенком (bg-body-tertiary внутри
                                   bg-body карточки) + report-block-toggle/chevron, как раскрытие актов ниже. #}
                                <div class="w-100 mt-2">
                                    <div class="small text-body-secondary d-inline-flex align-items-center gap-1 report-block-toggle" role="button"
                                         data-bs-toggle="collapse" data-bs-target="#hist-{{ i }}" aria-expanded="false" aria-controls="hist-{{ i }}">
                                        <i class="bi bi-clock-history"></i>История
                                        <i class="bi bi-chevron-down report-block-chevron"></i>
                                    </div>
                                    {# obligationKey содержит «requirementId|lower(label)» — в label бывает «/»
                                       (напр. «...до 1000В-1500В/50дж»), поэтому ключ — query-параметр `key`
                                       (любые символы, Twig сам URL-кодирует), не путь-сегмент. #}
                                    <div class="collapse mt-2" id="hist-{{ i }}"
                                         data-controller="obligation-history"
                                         data-obligation-history-url-value="{{ path('app_cabinet_compliance_obligation_history', {profileId: profileId, requirementId: requirementId, key: o.key}) }}"
                                         data-action="show.bs.collapse->obligation-history#load">
                                        <div data-obligation-history-target="body">
                                            <div class="p-3 rounded-3 bg-body-tertiary text-center text-body-secondary small">
                                                <i class="bi bi-hourglass-split me-1"></i>Загрузка…
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endblock %}
                        {% endembed %}
                        {% endif %}
                    {% endfor %}

                    {% import 'admin/compliance/person/issue.html.twig' as personal %}
                    <div class="mt-3 pt-3 border-top" data-controller="report-list-rows">
                        <label class="form-label fw-semibold">Добавить позицию (вне нормы)</label>
                        <div class="form-text mb-2">Персональная позиция сотрудника. Срок окончания обязателен.</div>
                        <div data-report-list-rows-target="rows">
                            {% for row in inputData.personalItems|default([]) %}{{ personal.personal_row('personalItems[' ~ loop.index0 ~ ']', row, requirementType, units, instructionGroups|default([]), requirementRequiresQuantity, requirementAllowsMixed|default(false)) }}{% endfor %}
                        </div>
                        <template data-report-list-rows-target="template">{{ personal.personal_row('personalItems[__i__]', {}, requirementType, units, instructionGroups|default([]), requirementRequiresQuantity, requirementAllowsMixed|default(false)) }}</template>
                        <button type="button" class="btn btn-soft-success btn-sm mt-1" data-action="report-list-rows#add"><i class="bi bi-plus-lg me-1"></i>Добавить позицию</button>
                    </div>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            </form>

            {# Списание — параллельный вход на той же странице. Показываем, когда есть что списывать/акты уже есть.
               Разбивка по позициям (что на руках, когда выдано) — в единой карточке выше + её истории; тут
               только точка входа «Списать» (по требованию, позицию выбирают на странице акта) + список актов. #}
            {% if woPresent %}
                <div id="sec-writeoff" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                        <h2 class="h6 mb-0">Списание</h2>
                        {% if canWriteOff %}
                            <form method="post" action="{{ path('app_cabinet_compliance_writeoff_open', {profileId: profileId, requirementId: requirementId}) }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-up me-1"></i>Списать</button>
                            </form>
                        {% endif %}
                    </div>

                    {# Только открытый черновик (корзина) — ссылка на оформление; оформленные акты — из истории позиции.
                       Черновик кросс-персон (один на требование×организацию): может держать позиции других сотрудников,
                       поэтому помечаем его как ОБЩИЙ, чтобы «позиций: N» не читалось как позиции этого человека. #}
                    {% if draftAct %}
                        <div class="d-flex flex-wrap align-items-center gap-2 p-3 rounded-3 bg-body">
                            <span class="badge text-bg-secondary"><i class="bi bi-people me-1"></i>Общий черновик акта (по организации)</span>
                            <span class="text-body-secondary small">позиций всего: {{ draftAct.itemCount }} — могут быть и других сотрудников</span>
                            <a class="btn btn-soft-success btn-sm ms-auto" href="{{ path('app_cabinet_compliance_writeoff_show', {actId: draftAct.id}) }}">
                                <i class="bi bi-pencil-square me-1"></i>Оформить
                            </a>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {# Подтверждение группового действия (выдача/списание): список выбранных позиций + кнопка. Один компонент
               (как delete_modal), наполняется контроллером issue-selection. #}
            {% include 'components/selection_confirm_modal.html.twig' %}

            {# «Убрать позицию» (личная, вне нормы) — общая модалка подтверждения #deleteModal; URL исключения (ключ
               позиции в query) приходит с триггер-кнопки строки через data-bs-url. #}
            {% include 'components/delete_modal.html.twig' %}

            {% if canWriteOff %}
                {# Скрытая форма «Списать выбранные»: контроллер issue-selection кладёт сюда keys[] выбранных позиций
                   и сабмитит (JS-улучшение; без JS списание — через «Списать» в секции ниже, на странице акта). #}
                <form id="writeoff-add-form" method="post" class="d-none"
                      action="{{ path('app_cabinet_compliance_writeoff_add', {profileId: profileId, requirementId: requirementId}) }}">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </form>
            {% endif %}
        {% endblock %}

        {% block savebar_extra %}
            {# Групповое действие над отмеченными позициями. type=submit form=issue-form — без JS сабмитит форму
               напрямую (бэк пишет только отмеченные). С JS контроллер перехватывает и сперва показывает подтверждение.
               Счётчик — ОТДЕЛЬНЫЙ target (issueCount): строки «только списать» (data-writeoff-only) выбираются
               тем же чекбоксом, что и обычные, но в выдачу не идут — общий count их бы завысил. #}
            <button type="submit" form="issue-form" class="btn btn-soft-success"
                    data-action="click->issue-selection#confirmIssue">
                <i class="bi bi-box-arrow-in-down me-1"></i>Выдать выбранные (<span data-issue-selection-target="issueCount">0</span>)
            </button>
            {% if canWriteOff %}
                {# Списание выбранных — наполнение корзины (черновик акта). JS-улучшение: без JS списание доступно
                   через «Списать» в секции ниже (страница акта). #}
                <button type="button" class="btn btn-outline-danger" data-action="issue-selection#confirmWriteoff">
                    <i class="bi bi-box-arrow-up me-1"></i>Списать выбранные (<span data-issue-selection-target="count">0</span>)
                </button>
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
