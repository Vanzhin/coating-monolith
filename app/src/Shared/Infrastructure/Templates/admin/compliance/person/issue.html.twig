{% extends '/cabinet/index.html.twig' %}

{% set fio = profile.lastName ~ ' ' ~ profile.firstName ~ (profile.middleName ? ' ' ~ profile.middleName : '') %}
{% set backUrl = path('app_cabinet_compliance_dashboard', {profile: profileId}) %}
{% set writeoff = mode == 'writeoff' %}
{% set act_view = mode == 'act' %}

{# Строка добавляемой персональной позиции (вне нормы). Один макрос на server-render существующих строк и на
   <template> новой — чтобы не дублировать разметку. Поля кол-ва/ед. — только для материального акта. #}
{% macro personal_row(prefix, row, requirementType, units) %}
    <div class="p-3 mb-2 rounded-3 bg-body" data-report-list-rows-target="row">
        <div class="row g-2">
            <div class="col-12 col-md-5">
                <label class="form-label small mb-1">Наименование</label>
                <input type="text" name="{{ prefix }}[label]" value="{{ row.label|default('') }}" class="form-control">
            </div>
            <div class="col-12">
                <label class="form-label small mb-1">Модель / марка / артикул</label>
                <input type="text" name="{{ prefix }}[note]" value="{{ row.note|default('') }}" class="form-control" placeholder="Модель, марка, артикул, класс защиты">
            </div>
            {% if requirementType == 'material' %}
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">Кол-во</label>
                    <input type="number" min="0" step="any" inputmode="decimal" name="{{ prefix }}[amount]" value="{{ row.amount|default('') }}" class="form-control">
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">Ед.</label>
                    <select name="{{ prefix }}[unit]" class="form-select">
                        {% for u in units %}<option value="{{ u.value }}"{{ row.unit|default('') == u.value ? ' selected' : '' }}>{{ u.title }}</option>{% endfor %}
                    </select>
                </div>
            {% endif %}
            <div class="col-6 col-md-3">
                <label class="form-label small mb-1">Срок окончания</label>
                <input type="date" name="{{ prefix }}[manualDueDate]" value="{{ row.manualDueDate|default('') }}" class="form-control">
            </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-danger mt-2" data-action="report-list-rows#remove"><i class="bi bi-trash"></i></button>
    </div>
{% endmacro %}

{# Под-строка разбивки «Действующих позиций» по актам выдачи: дата (ссылка на скан акта) + на руках + пометка списания. #}
{% macro wo_fact(f, unit, profileId) %}
    <div class="p-2 mb-1 rounded-3 bg-body-tertiary d-flex flex-wrap align-items-center gap-2">
        <div class="small">
            Выдан: {% if f.documentId %}<a href="{{ path('app_cabinet_compliance_document_download_scan', {profileId: profileId, documentId: f.documentId}) }}">{{ f.date }}</a>{% else %}{{ f.date }}{% endif %}
            {% if f.writeOffNote %}<span class="text-danger"> · {{ f.writeOffNote }}</span>{% endif %}
        </div>
        <div class="ms-auto small text-body-secondary">на руках <span class="fw-semibold text-body">{{ f.held }} {{ unit }}</span></div>
    </div>
{% endmacro %}

{% set page_verb = act_view ? 'Акт' : (writeoff ? 'Списание' : 'Оформить') %}
{% block title %}{{ parent() }} | {{ page_verb }} — {{ requirementName }}{% endblock %}

{% block content %}
    {% embed 'components/form_page.html.twig' with {
        title: page_verb ~ ' — ' ~ requirementName,
        back_url: backUrl,
        save_enabled: false,
        save_form_id: 'issue-form',
        save_label: 'Оформить',
        anchors: act_view ? [{id: 'sec-items', label: 'Позиции'}] : (writeoff ? [{id: 'sec-items', label: 'Позиции'}] : [{id: 'sec-doc', label: 'Документ'}, {id: 'sec-items', label: 'Позиции'}]),
    } %}
        {% block sections %}
            {% if error is defined and error %}
                <div class="form-alert mb-3" role="alert">
                    <i class="bi bi-exclamation-octagon"></i>
                    <div><div class="form-alert-title">Не удалось сохранить</div><div>{{ error }}</div></div>
                </div>
            {% endif %}

            {% if act_view %}
                <div class="p-3 mb-3 rounded-3 bg-body-tertiary fsec">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                        <h2 class="h6 mb-0">Акт выдачи{% if act.number %} № {{ act.number }}{% endif %}</h2>
                        <div class="d-flex flex-wrap gap-2">
                            <form method="post" action="{{ path('app_cabinet_compliance_writeoff_open', {profileId: profileId, requirementId: requirementId}) }}" class="m-0">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Списать</button>
                            </form>
                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_document_card_download', {profileId: profileId, requirementId: requirementId, documentId: documentId}) }}"><i class="bi bi-file-earmark-word me-1"></i>Скачать карточку</a>
                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_document_download_scan', {profileId: profileId, documentId: documentId}) }}"><i class="bi bi-download me-1"></i>Скан</a>
                            {% if is_granted('ROLE_ADMIN') %}
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-bs-title="этот акт выдачи и все связанные с ним списания"
                                        data-bs-url="{{ path('app_cabinet_compliance_document_delete', {profileId: profileId, documentId: documentId}) }}">
                                    <i class="bi bi-trash3 me-1"></i>Удалить акт
                                </button>
                            {% endif %}
                        </div>
                    </div>
                    <div class="text-body-secondary small">{{ fio }} · {{ profile.positionTitle }}</div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-4"><div class="small text-body-secondary">Дата выдачи</div><div class="fw-semibold">{{ act.date ?: '—' }}</div></div>
                        <div class="col-md-8"><div class="small text-body-secondary">Ответственное лицо</div><div class="fw-semibold">{{ act.responsible ?: '—' }}</div></div>
                    </div>
                </div>

                <div id="sec-items" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <h2 class="h6 mb-3">Позиции акта</h2>
                    {% if rows is empty %}
                        <div class="p-4 rounded-3 bg-body text-center text-body-secondary">В акте нет позиций.</div>
                    {% endif %}
                    {% for r in rows %}
                        <div class="p-3 mb-2 rounded-3 bg-body">
                            <div class="d-flex flex-wrap align-items-start gap-2">
                                <div class="me-auto">
                                    <div class="fw-semibold">{{ r.label }}</div>
                                    {% if r.model %}<div class="text-body-secondary small">{{ r.model }}</div>{% endif %}
                                    {% if r.meta %}<div class="text-body-secondary small">{{ r.meta }}</div>{% endif %}
                                    {% for off in r.writeOffs %}
                                        <a class="text-danger small d-block" href="{{ path('app_cabinet_compliance_writeoff_show', {profileId: profileId, actId: off.actId}) }}">{{ off.label }}</a>
                                    {% endfor %}
                                </div>
                                <div class="text-center px-2"><div class="small text-body-secondary">Выдано</div><div class="fw-semibold tnum">{{ r.issued ?: '—' }}</div></div>
                                <div class="text-center px-2"><div class="small text-body-secondary">Дата</div><div class="fw-semibold tnum">{{ r.date }}</div></div>
                                {% if r.due %}<div class="text-center px-2"><div class="small text-body-secondary">Срок</div><div class="fw-semibold tnum">{{ r.due }}</div></div>{% endif %}
                                {% if r.held %}<div class="text-center px-2"><div class="small text-body-secondary">На руках</div><div class="fw-semibold tnum">{{ r.held }}</div></div>{% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                {% include 'components/delete_modal.html.twig' %}
            {% elseif writeoff %}
                <div id="sec-items" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                        <h2 class="h6 mb-0">Действующие позиции</h2>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_card_download', {profileId: profileId, requirementId: requirementId}) }}">
                                <i class="bi bi-file-earmark-word me-1"></i>Скачать бланк
                            </a>
                            <form method="post" action="{{ path('app_cabinet_compliance_writeoff_open', {profileId: profileId, requirementId: requirementId}) }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                                <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-box-arrow-right me-1"></i>Списать</button>
                            </form>
                        </div>
                    </div>
                    <div class="text-body-secondary small mb-3">{{ fio }} · {{ profile.positionTitle }} — списание оформляется в акте списания</div>

                    {% if rows is empty %}
                        <div class="p-4 rounded-3 bg-body text-center text-body-secondary">Нет действующих материальных позиций.</div>
                    {% endif %}
                    {% import 'admin/compliance/person/issue.html.twig' as wo %}
                    {% for row in rows %}
                        {% set rid = 'wo-pos-' ~ loop.index0 %}
                        <div class="p-3 mb-2 rounded-3 bg-body">
                            <div class="d-flex flex-wrap align-items-center gap-2 report-block-toggle" role="button"
                                 data-bs-toggle="collapse" data-bs-target="#{{ rid }}" aria-expanded="false">
                                <div class="me-auto">
                                    <div class="fw-semibold">{{ row.label }}</div>
                                    {% if row.meta %}<div class="text-body-secondary small">{{ row.meta }}</div>{% endif %}
                                </div>
                                <div class="text-end">
                                    <div class="small text-body-secondary mb-1">На руках</div>
                                    <span class="badge text-bg-{{ row.tone }} fw-normal">{{ row.held }}{% if row.norm %} / {{ row.norm }}{% endif %} {{ row.unit }}</span>
                                </div>
                                <i class="bi bi-chevron-down ms-1 text-body-secondary report-block-chevron"></i>
                            </div>
                            <div class="collapse mt-2" id="{{ rid }}">
                                {% for f in row.facts %}{{ wo.wo_fact(f, row.unit, profileId) }}{% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if writeOffActs is not empty %}
                    <div class="p-3 mb-3 rounded-3 bg-body-tertiary fsec">
                        <h2 class="h6 mb-2">Акты списания</h2>
                        {% for a in writeOffActs %}
                            <div class="p-3 mb-2 rounded-3 bg-body">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <span class="badge {{ a.signed ? 'text-bg-success' : 'text-bg-secondary' }}">
                                        <i class="bi {{ a.signed ? 'bi-lock-fill' : 'bi-file-earmark-text' }} me-1"></i>{{ a.signed ? 'Оформлен' : 'Черновик' }}{% if a.actNumber %} · № {{ a.actNumber }}{% endif %}
                                    </span>
                                    <div class="ms-auto d-flex flex-wrap gap-2">
                                        <a class="btn btn-soft-success btn-sm" href="{{ path('app_cabinet_compliance_writeoff_show', {profileId: profileId, actId: a.id}) }}"><i class="bi bi-pencil-square me-1"></i>Открыть акт</a>
                                        <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_writeoff_download', {profileId: profileId, actId: a.id}) }}"><i class="bi bi-file-earmark-word me-1"></i>Скачать</a>
                                        {% if a.signed %}
                                            <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_writeoff_scan', {profileId: profileId, actId: a.id}) }}"><i class="bi bi-download me-1"></i>Скан</a>
                                        {% endif %}
                                    </div>
                                </div>
                                {% for it in a.items %}
                                    <div class="text-body-secondary small">{{ it.label }}{% if it.reason %} — {{ it.reason }}{% endif %}</div>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if signedActs is not empty %}
                    <div class="p-3 mb-3 rounded-3 bg-body-tertiary fsec">
                        <h2 class="h6 mb-2">Подписанные документы</h2>
                        {% for act in signedActs %}
                            <a class="btn btn-outline-secondary btn-sm me-2 mb-2" href="{{ path('app_cabinet_compliance_document_download_scan', {profileId: profileId, documentId: act.documentId}) }}">
                                <i class="bi bi-download me-1"></i>Скан{% if act.signedAt %} · {{ act.signedAt }}{% endif %}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            {% else %}
                <form id="issue-form" method="post" novalidate
                      data-controller="norm-fill" data-norm-fill-next-due-url-value="{{ path('app_cabinet_compliance_next_due') }}">
                    <input type="hidden" name="draftId" value="{{ draftId }}">

                    <div id="sec-doc" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section"
                         data-controller="staged-file" data-staged-file-stage-url-value="{{ path('app_cabinet_file_stage') }}">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-1">
                            <h2 class="h6 mb-0">Документ</h2>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" name="action" value="save" class="btn btn-soft-success btn-sm">
                                    <i class="bi bi-save me-1"></i>Сохранить черновик
                                </button>
                                <button type="submit" name="action" value="sign" class="btn btn-primary btn-sm">
                                    <i class="bi bi-check-lg me-1"></i>Оформить
                                </button>
                                <button type="button" class="btn btn-outline-danger btn-sm"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal"
                                        data-bs-title="черновик карточки"
                                        data-bs-url="{{ path('app_cabinet_compliance_draft_delete', {profileId: profileId, documentId: draftId}) }}">
                                    <i class="bi bi-trash3 me-1"></i>Удалить
                                </button>
                                <a class="btn btn-outline-secondary btn-sm" href="{{ path('app_cabinet_compliance_card_download', {profileId: profileId, requirementId: requirementId}) }}">
                                    <i class="bi bi-file-earmark-word me-1"></i>Скачать бланк
                                </a>
                            </div>
                        </div>
                        <div class="form-text mb-2">Сохраните черновик — тогда в бланк попадут № и ответственное лицо. Для оформления приложите скан и нажмите «Оформить».</div>
                        <div class="text-body-secondary small mb-3">{{ fio }} · {{ profile.positionTitle }}</div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Акт № <span class="text-danger">*</span></label>
                                <input type="text" name="cardNumber" value="{{ inputData.cardNumber|default('') }}" class="form-control">
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small mb-1">Ответственное лицо <span class="text-danger">*</span></label>
                                <input type="text" name="responsibleFio" value="{{ inputData.responsibleFio|default('') }}" class="form-control" placeholder="Фамилия И. О.">
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label small mb-1">Дата документа</label>
                                <input type="date" name="documentDate" value="{{ documentDate }}" class="form-control">
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small mb-1">Прикрепить скан</label>
                                <input type="file" class="form-control" data-action="change->staged-file#upload" accept=".pdf,.jpg,.jpeg,.png">
                                <div class="form-text">Подписанная карточка — нужна, чтобы оформить. Если скан уже приложен, повторно выбирать файл не нужно.</div>
                                <input type="hidden" name="stagedFileId" data-staged-file-target="hidden" value="{{ inputData.stagedFileId|default('') }}">
                                <input type="hidden" name="stagedFileName" data-staged-file-target="nameHidden" value="{{ inputData.stagedFileName|default('') }}">
                                <div class="small mt-1 text-success" data-staged-file-target="name">{{ inputData.stagedFileName|default('') }}</div>
                            </div>
                        </div>
                    </div>

                    <div id="sec-items" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <h2 class="h6 mb-0">Позиции</h2>
                            <button type="button" class="btn btn-outline-primary btn-sm" data-action="norm-fill#fill">
                                <i class="bi bi-magic me-1"></i>Заполнить по норме
                            </button>
                        </div>

                        {% if rows is empty %}
                            <div class="p-4 rounded-3 bg-body text-center text-body-secondary">Нет подошедших позиций.</div>
                        {% endif %}

                        {% for o in rows %}
                            {% embed 'admin/compliance/_item_card.html.twig' with {
                                name: o.label,
                                meta: o.cadenceLabel ~ (o.quantityLabel ? ' · норма ' ~ o.quantityLabel : ''),
                                attrs: 'data-row',
                                o: o, i: loop.index0, units: units, documentDate: documentDate,
                                s: inputData.items[loop.index0]|default({}),
                            } %}
                                {% block footer %}
                                    <input type="hidden" name="items[{{ i }}][obligationKey]" value="{{ o.key }}">
                                    {% if o.origin == 'personal' %}
                                        <button type="button" class="btn btn-sm btn-outline-danger mb-2" data-action="norm-fill#removeRow" title="Убрать позицию вне нормы из черновика">
                                            <i class="bi bi-trash me-1"></i>Убрать позицию
                                        </button>
                                    {% endif %}
                                    <div class="row g-2 w-100">
                                        <div class="col-12">
                                            <label class="form-label small mb-1">Модель / марка / артикул</label>
                                            <input type="text" name="items[{{ i }}][note]" value="{{ s.note|default(o.savedNote) }}" class="form-control" placeholder="Модель, марка, артикул, класс защиты">
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label small mb-1">Дата выдачи</label>
                                            <input type="date" name="items[{{ i }}][date]" value="{{ s.date|default(o.savedDate ?: documentDate) }}" class="form-control"
                                                   data-issue-date data-action="change->norm-fill#nextDue"
                                                   data-cadence-kind="{{ o.cadenceKind }}" data-cadence-number="{{ o.cadenceNumber }}" data-cadence-unit="{{ o.cadenceUnit }}">
                                            <div class="form-text">След. выдача: <span data-next-due>—</span></div>
                                        </div>
                                        {% if o.type == 'material' %}
                                            <div class="col-6 col-md-2">
                                                <label class="form-label small mb-1">Кол-во</label>
                                                <input type="number" min="0" step="any" inputmode="decimal" name="items[{{ i }}][amount]" class="form-control"
                                                       value="{{ s.amount|default(o.deficitValue) }}" placeholder="{{ o.quantityValue ?? '10' }}"
                                                       data-norm-amount="{{ o.quantityValue }}" data-action="input->norm-fill#check change->norm-fill#rowDue">
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label small mb-1">Ед.</label>
                                                {% if o.quantityUnit %}
                                                    {# Единица задана обязанностью (норма из требования / персональная с кол-вом) — не меняется (UX), домен это проверяет. #}
                                                    <select class="form-select" disabled aria-label="Единица измерения">
                                                        {% for u in units %}<option value="{{ u.value }}"{{ o.quantityUnit == u.value ? ' selected' : '' }}>{{ u.title }}</option>{% endfor %}
                                                    </select>
                                                    <input type="hidden" name="items[{{ i }}][unit]" value="{{ o.quantityUnit }}">
                                                {% else %}
                                                    {# Персональная позиция без заданной единицы — выбираем. #}
                                                    <select name="items[{{ i }}][unit]" class="form-select">
                                                        {% for u in units %}<option value="{{ u.value }}"{{ s.unit|default(o.savedUnit) == u.value ? ' selected' : '' }}>{{ u.title }}</option>{% endfor %}
                                                    </select>
                                                {% endif %}
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label small mb-1">% износа</label>
                                                <input type="number" min="0" max="100" step="any" inputmode="decimal" name="items[{{ i }}][wearPercent]" class="form-control" value="{{ s.wearPercent|default(o.savedWear) }}" placeholder="0">
                                            </div>
                                        {% endif %}
                                        {% if o.cadenceKind == 'by_manufacturer_doc' %}
                                            <div class="col-6 col-md-3">
                                                <label class="form-label small mb-1">Срок годности (по документам)</label>
                                                <input type="date" name="items[{{ i }}][manualDueDate]" class="form-control" value="{{ s.manualDueDate|default(o.savedDueDate) }}">
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endblock %}
                            {% endembed %}
                        {% endfor %}

                        {% import 'admin/compliance/person/issue.html.twig' as personal %}
                        <div class="mt-3 pt-3 border-top" data-controller="report-list-rows">
                            <label class="form-label fw-semibold">Добавить позицию (вне нормы)</label>
                            <div class="form-text mb-2">Персональная позиция сотрудника. Срок окончания обязателен.</div>
                            <div data-report-list-rows-target="rows">
                                {% for row in inputData.personalItems|default([]) %}{{ personal.personal_row('personalItems[' ~ loop.index0 ~ ']', row, requirementType, units) }}{% endfor %}
                            </div>
                            <template data-report-list-rows-target="template">{{ personal.personal_row('personalItems[__i__]', {}, requirementType, units) }}</template>
                            <button type="button" class="btn btn-soft-success btn-sm mt-1" data-action="report-list-rows#add"><i class="bi bi-plus-lg me-1"></i>Добавить позицию</button>
                        </div>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                </form>

                {% include 'components/delete_modal.html.twig' %}
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
