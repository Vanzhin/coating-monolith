{# Батч карточек покрытий (единая entity-карточка).
   Используется:
   - основным шаблоном index.html.twig для первой страницы;
   - ListAction в режиме ?partial=1 для догрузки следующих страниц через
     infinite-list Stimulus-контроллер — тогда возвращается ТОЛЬКО этот partial.

   Обязательные переменные:
     coatings          — list<CoatingDTO>
     canEdit           — bool
     selectedTagIdList — list<string>  (id уже активных tag-фильтров)

   Контракты (не ломать — их слушают Stimulus-контроллеры):
   - чекбокс сравнения: data-compare-id + change->compare-tray#toggle (+ data-compare-title для чипа);
   - превью по клику на заголовок/описание: click->coating-preview-loader#open + data-coating-id;
   - удаление: общий #deleteModal (data-bs-toggle=modal, data-bs-id/title) — как в edit_delete. #}
{% for coating in coatings %}
    {% set mono = coating.base ?? '—' %}{# монограм связующего = ISO-код как есть (EP/PUR/ESI/AK…) #}
    {# Колеруемые (isTintable = любой цвет) показываем ОДИНАКОВЫМ набором непривычных
       приглушённых оттенков (фиолетовый/бирюза/роза/олива/барвинок) — так сразу
       понятно, что это не реальные цвета, а «колеруемо». Обычные — своими possibleColors. #}
    {% set tintablePalette = ['#9b8bbf', '#6bb0a8', '#c090a8', '#a8b06b', '#8b9bbf'] %}
    {% set colorHexes = coating.isTintable ? tintablePalette : coating.possibleColors|map(c => c.hex)|slice(0, 5) %}
    <div class="ecard">
        {# Сравнение — ведущая колонка слева (не наезжает на kebab); контракт compare-tray сохранён. #}
        <div class="ecard-select">
            <input type="checkbox" class="form-check-input m-0"
                   data-compare-id="{{ coating.id }}"
                   data-compare-title="{{ coating.title }}"
                   data-action="change->compare-tray#toggle"
                   aria-label="Добавить к сравнению">
        </div>

        {# Медиа: монограм связующего + цветная полоса (несколько доступных цветов). #}
        <div class="ecard-mono">
            <span class="lbl">{{ mono }}</span>
            {% if coating.isZincRich %}<span class="zn">Zn</span>{% endif %}
            <span class="strip">
                {% if colorHexes|length > 0 %}
                    {% for hex in colorHexes %}<i style="background: {{ hex }}"></i>{% endfor %}
                {% else %}
                    <i style="background: var(--bs-border-color)"></i>
                {% endif %}
            </span>
        </div>

        <div class="ecard-body">
            <div class="ecard-head">
                {# Превью открывается кликом по заголовку (контракт сохранён). #}
                <div class="ecard-title" style="cursor: pointer;"
                     data-action="click->coating-preview-loader#open"
                     data-coating-id="{{ coating.id }}">{{ coating.title }}</div>
                {% if canEdit %}
                    <div class="ecard-kebab dropdown" data-controller="dropdown-portal">
                        <button class="btn btn-sm btn-link text-body-secondary p-1" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Действия">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="{{ path('app_cabinet_coating_coating_update', {id: coating.id}) }}">
                                    <i class="bi bi-pencil me-2"></i>Редактировать
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_cabinet_coating_coating_create', {from: coating.id}) }}">
                                    <i class="bi bi-files me-2"></i>Дублировать
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                {# Удаление через общий #deleteModal — тот же контракт, что в edit_delete. #}
                                <a class="dropdown-item text-danger"
                                   href="{{ path('app_cabinet_coating_coating_delete', {id: coating.id}) }}"
                                   data-bs-toggle="modal" data-bs-target="#deleteModal"
                                   data-bs-title="{{ coating.title }}" data-bs-id="{{ coating.id }}">
                                    <i class="bi bi-trash3 me-2"></i>Удалить
                                </a>
                            </li>
                        </ul>
                    </div>
                {% endif %}
            </div>

            {% if coating.description %}
                <div class="ecard-desc" style="cursor: pointer;"
                     data-action="click->coating-preview-loader#open"
                     data-coating-id="{{ coating.id }}">{{ coating.description }}</div>
            {% endif %}

            {% if not coating.isTintable and coating.possibleColors|length > 0 %}
                <div class="ecard-meta">{{ coating.possibleColors|length }} цветов</div>
            {% endif %}

            {% if coating.matchedSubstances is defined and coating.matchedSubstances|length > 0 %}
                {% set matches = coating.matchedSubstances %}
                <div class="ecard-badges">
                    <span class="b-ok-lbl">✓ Стойкое к:</span>
                    {% for m in matches|slice(0, 3) %}
                        <a href="#" class="b-ok text-decoration-none"
                           data-action="click->coating-preview-loader#open"
                           data-coating-id="{{ coating.id }}"
                           data-highlight-substance-id="{{ m.substanceId }}">{{ m.canonicalName }}</a>
                    {% endfor %}
                    {% if matches|length > 3 %}<span class="b-ok">+{{ matches|length - 3 }}</span>{% endif %}
                </div>
            {% endif %}

            {% if coating.tags|length > 0 %}
                <div class="ecard-tags" data-controller="scroll-fade">
                    {% for tag in coating.tags %}
                        {% set isActive = tag.id in selectedTagIdList %}
                        {% set newTagIds = isActive
                            ? selectedTagIdList|filter(id => id != tag.id)
                            : selectedTagIdList|merge([tag.id]) %}
                        {% set q = app.request.query.all|merge({tagIds: newTagIds, page: null})|filter(v => v is not null) %}
                        <a href="{{ path('app_cabinet_coating_coating_list', q) }}"
                           class="tag{{ isActive ? ' is-active' : '' }}"
                           title="{{ isActive ? 'Убрать «' ~ tag.title ~ '» из фильтра' : 'Отфильтровать по «' ~ tag.title ~ '»' }}">
                            {{ tag.title }}{%- if isActive %} ×{% endif -%}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
{% endfor %}
