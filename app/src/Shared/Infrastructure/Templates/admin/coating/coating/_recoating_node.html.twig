{# Параметры:
    - minNode (массив {default: {points: [...]}, branches: {...}}) — обязательно
    - maxNode (то же) — обязательно
    - level — 'root' | 'env' | 'base'
    - path — список ключей от корня до текущего узла, пустой для корня
    - envLabels — карта env-ключей в русские подписи (передаётся снаружи)
    - availableEnvKeys — список env-ключей, доступных к добавлению (только для root)
    - baseLabels — карта base-ключей (lower-ASCII) в русские названия CoatingBase->title()
#}
{% from '/components/duration_input.html.twig' import duration_input %}

{% set isRoot = level == 'root' %}
{% set isEnv  = level == 'env' %}
{% set isBase = level == 'base' %}

{% set minPrefix = 'minRecoatingInterval' %}
{% set maxPrefix = 'maxRecoatingInterval' %}
{% for key in path %}
    {% set minPrefix = minPrefix ~ '[branches][' ~ key ~ ']' %}
    {% set maxPrefix = maxPrefix ~ '[branches][' ~ key ~ ']' %}
{% endfor %}
{% set minPrefix = minPrefix ~ '[default][points]' %}
{% set maxPrefix = maxPrefix ~ '[default][points]' %}

{% set minPoints = minNode.default.points ?? [] %}
{% set maxPoints = maxNode.default.points ?? [] %}
{% set rowCount = max(minPoints|length, maxPoints|length, 1) %}

{% set nodeId = (path|length > 0 ? path|join('-') : 'root') %}

{# Корень: аккордеон по средам. «Общее» — статичная всегда-открытая секция,
   каждая среда — раскрывающаяся (Bootstrap collapse). data-контракты
   (data-env-tab / data-recoating-add-env / data-recoating-add-menu / id="recoating-pane-*")
   сохранены — coating-form (addEnv/removeEnv/addBase/_rebuildAddMenu) на них завязан. #}
{% if isRoot %}
{% set envBranchKeys = (minNode.branches ?? {})|merge(maxNode.branches ?? {}) %}
<div data-recoating-root
     data-available-bases="{{ baseLabels|json_encode|e('html_attr') }}">

    {# ─── «Общее» — всегда открыта, без переключателя ─── #}
    <div class="rec-sec">
        <div class="rec-sec-head rec-sec-head--static">
            <span class="rec-sec-title">Общее</span>
            <span class="text-body-secondary small">применяется ко всем основам ЛКМ</span>
        </div>
        <div class="rec-sec-body">
            {% include 'admin/coating/coating/_recoating_node.html.twig' with {
                minNode: minNode,
                maxNode: maxNode,
                level: 'env',
                path: [],
                envLabels: envLabels,
                baseLabels: baseLabels,
            } only %}
        </div>
    </div>

    {# ─── Среды — раскрывающиеся секции (union min+max, чтобы env из max тоже вышли) ─── #}
    {% for envKey in envBranchKeys|keys %}
        {% set envMinNode = (minNode.branches ?? {})[envKey] ?? {default: {points: []}, branches: {}} %}
        {% set envMaxNode = (maxNode.branches ?? {})[envKey] ?? {default: {points: []}, branches: {}} %}
        <div class="rec-sec" data-env-tab="{{ envKey }}">
            <div class="rec-sec-head-row">
                <button class="rec-sec-head" type="button" data-bs-toggle="collapse"
                        data-bs-target="#recoating-pane-{{ envKey }}" aria-expanded="true"
                        aria-controls="recoating-pane-{{ envKey }}">
                    <i class="bi bi-chevron-down rec-sec-caret"></i>
                    <span class="rec-sec-title">{{ envLabels[envKey] ?? envKey }}</span>
                </button>
                <button type="button" class="rec-sec-del"
                        data-action="click->coating-form#removeEnv"
                        data-coating-form-env-param="{{ envKey }}"
                        title="Удалить среду" aria-label="Удалить среду">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div id="recoating-pane-{{ envKey }}" class="collapse show">
                <div class="rec-sec-body">
                    {% include 'admin/coating/coating/_recoating_node.html.twig' with {
                        minNode: envMinNode,
                        maxNode: envMaxNode,
                        level: 'env',
                        path: [envKey],
                        envLabels: envLabels,
                        baseLabels: baseLabels,
                    } only %}
                </div>
            </div>
        </div>
    {% endfor %}

    {# ─── «+ Добавить» — единое tree-level меню: новая среда ИЛИ основа ЛКМ для среды.
          «+ Среда» и per-env «+ Правило» сведены сюда (concept «добавить ветку дерева»).
          data-recoating-add-env — якорь вставки новых сред (JS insertBefore перед ним);
          data-recoating-add-menu — контейнер пунктов, JS перестраивает после add/remove. ─── #}
    {% set usedEnvKeys = envBranchKeys|keys %}
    {% set freeEnvKeys = availableEnvKeys|filter(k => k not in usedEnvKeys) %}
    <div class="dropdown" data-recoating-add-env data-controller="dropdown-portal">
        <button class="btn btn-sm btn-soft-success dropdown-toggle" data-bs-toggle="dropdown"
                type="button" aria-expanded="false">
            <i class="bi bi-plus-lg"></i> Добавить
        </button>
        <ul class="dropdown-menu" data-recoating-add-menu style="max-height: 60vh; overflow-y: auto;">
            {% if freeEnvKeys is not empty %}
                <li><h6 class="dropdown-header">Среда</h6></li>
                {% for k in freeEnvKeys %}
                    <li><button type="button" class="dropdown-item"
                            data-action="click->coating-form#addEnv"
                            data-coating-form-env-param="{{ k }}">
                        {{ envLabels[k] ?? k }}
                    </button></li>
                {% endfor %}
            {% endif %}
            {% for env in usedEnvKeys %}
                {% set envMin = (minNode.branches ?? {})[env] ?? {branches: {}} %}
                {% set envMax = (maxNode.branches ?? {})[env] ?? {branches: {}} %}
                {% set usedBaseKeys = ((envMin.branches ?? {})|merge(envMax.branches ?? {}))|keys %}
                {% set freeBaseKeys = baseLabels|keys|filter(b => b not in usedBaseKeys) %}
                {% if freeBaseKeys is not empty %}
                    <li><h6 class="dropdown-header">Основа ЛКМ · {{ envLabels[env] ?? env }}</h6></li>
                    {% for b in freeBaseKeys %}
                        <li><button type="button" class="dropdown-item"
                                data-action="click->coating-form#addBase"
                                data-coating-form-env-param="{{ env }}" data-coating-form-base-param="{{ b }}">
                            {{ baseLabels[b] }}
                        </button></li>
                    {% endfor %}
                {% endif %}
            {% endfor %}
        </ul>
    </div>
</div>

{# Уровни env и base — одинаковая таблица серии + (для env) список base-правил.
   isBase — вложенное правило по основе ЛКМ, обёрнуто в тертиарную карточку,
   чтобы визуально отличаться от родительской белой env-подсекции. Внутри
   переопределяем --table-rows-cell-bg обратно на body-bg, чтобы строки таблицы
   были белыми на тертиарном фоне карточки (иначе всё бы стало серо-на-сером). #}
{% else %}
<div class="{% if isBase %}p-3 mt-3 rounded-3 bg-body-tertiary{% endif %}"
     {% if isBase %}style="--table-rows-cell-bg: var(--bs-body-bg);"{% endif %}
     data-recoating-node="{{ nodeId }}">
    {# Кнопка «Добавить точку» — в шапке блока справа (как в блоках сушки), не внизу. #}
    {% if isBase %}
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-semibold mb-0">Основа: {{ baseLabels[path|last] ?? path|last }}</h6>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        data-action="click->coating-form#addRow"
                        data-coating-form-tbody-param="recoating-{{ nodeId }}">Добавить точку</button>
                <button type="button" class="btn-close"
                        data-action="click->coating-form#removeBase"
                        data-coating-form-env-param="{{ path[0] }}"
                        data-coating-form-base-param="{{ path|last }}"
                        title="Удалить правило для основы"
                        aria-label="Удалить правило для основы"></button>
            </div>
        </div>
    {% else %}
        <div class="d-flex justify-content-end mb-2">
            <button type="button" class="btn btn-sm btn-outline-secondary"
                    data-action="click->coating-form#addRow"
                    data-coating-form-tbody-param="recoating-{{ nodeId }}">Добавить точку</button>
        </div>
    {% endif %}

    <div class="table-responsive">
    <table class="table table-sm align-middle mb-0 table-rows">
        <thead>
            <tr>
                <th class="text-muted fw-normal" style="width: 160px;">Температура</th>
                <th class="text-muted fw-normal">Минимальный</th>
                <th class="text-muted fw-normal">Максимальный</th>
                <th style="width: 60px;"></th>
            </tr>
        </thead>
        <tbody data-series="recoating-{{ nodeId }}"
               data-min-prefix="{{ minPrefix }}"
               data-max-prefix="{{ maxPrefix }}">
            {% for i in 0..(rowCount - 1) %}
                {% set minRow = minPoints[i] ?? {temperature_at: 20, days: 0, hours: 0, minutes: 0} %}
                {% set maxRow = maxPoints[i] ?? {} %}
                {% set temp = minRow.temperature_at ?? maxRow.temperature_at ?? 20 %}
                <tr>
                    <td>
                        <div class="input-group input-group-sm">
                            <input type="number"
                                   name="{{ minPrefix }}[{{ i }}][temperature_at]"
                                   value="{{ temp }}"
                                   class="form-control"
                                   data-row="{{ nodeId }}-{{ i }}"
                                   data-action="input->coating-form#syncTemperature"
                                   min="-50" max="100" required>
                            <span class="input-group-text">°C</span>
                        </div>
                        <input type="hidden" name="{{ maxPrefix }}[{{ i }}][temperature_at]"
                               value="{{ temp }}" data-temp-mirror="{{ nodeId }}-{{ i }}">
                    </td>
                    {% set tempSigned = temp > 0 ? '+' ~ temp : temp %}
                    <td>{{ duration_input(minPrefix ~ '[' ~ i ~ ']', minRow, true, 'Минимальный интервал перекрытия при ' ~ tempSigned ~ ' °C', false) }}</td>
                    <td>{{ duration_input(maxPrefix ~ '[' ~ i ~ ']', maxRow, false, 'Максимальный интервал перекрытия при ' ~ tempSigned ~ ' °C', true) }}</td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-danger"
                                data-action="click->coating-form#removeRow"
                                title="Удалить точку">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
    </div>
    {% if isEnv and path|length > 0 %}
        {# Union ключей min+max, чтобы base-ветви из max (без min) тоже отрисовались. #}
        {% set baseBranchKeys = (minNode.branches ?? {})|merge(maxNode.branches ?? {}) %}
        {% for baseKey in baseBranchKeys|keys %}
            {% set baseMinNode = (minNode.branches ?? {})[baseKey] ?? {default: {points: []}, branches: {}} %}
            {% set baseMaxNode = (maxNode.branches ?? {})[baseKey] ?? {default: {points: []}, branches: {}} %}
            {% include 'admin/coating/coating/_recoating_node.html.twig' with {
                minNode: baseMinNode,
                maxNode: baseMaxNode,
                level: 'base',
                path: path|merge([baseKey]),
                envLabels: envLabels,
                baseLabels: baseLabels,
            } only %}
        {% endfor %}
    {% endif %}
</div>
{% endif %}
