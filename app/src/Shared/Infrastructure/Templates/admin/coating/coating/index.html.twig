{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Покрытия{% endblock %}



{% block content %}
    {% set canEdit = is_granted('ROLE_ADMIN') %}
    {# id'ы активных tag-фильтров — раз собрать для переиспользования (проверки
       on/off, toggle-url'ы, empty-state chip-row'а внутри offcanvas'a). #}
    {% set selectedTagIdList = selectedTags|map(t => t.id) %}

    <div data-controller="compare-tray coating-preview-loader"
         data-compare-tray-storage-key-value="compare:Coating"
         data-compare-tray-compare-url-value="{{ path('app_cabinet_coating_coating_compare') }}"
         data-compare-tray-max-value="4"
         data-coating-preview-loader-endpoint-value="{{ path('app_cabinet_coating_coating_preview', {id: '00000000-0000-0000-0000-000000000000'}) }}">
    {% embed 'components/list_page.html.twig' with {
        title: 'Покрытия',
        create_route: 'app_cabinet_coating_coating_create',
        can_edit: canEdit,
        is_empty: result.coatings is empty,
    } %}
    {% block above_list %}
        {% set defaultSort = constant('App\\Coatings\\Domain\\Repository\\CoatingSort::DEFAULT') %}
        {% set selectedTagsJson = selectedTags|map(t => {id: t.id, title: t.title})|json_encode %}

        {# Активные состояния и summary/reset — на уровне above_list, чтобы их видели и chips, и drawer. #}
        {% set appMinTempActive = appMinTempFrom is not null or appMinTempTo is not null %}
        {% set volumeSolidActive = volumeSolidFrom is not null or volumeSolidTo is not null %}
        {% set minRecoat20Active = minRecoat20From is not null or minRecoat20To is not null %}
        {% set maxRecoat20Active = maxRecoat20From is not null or maxRecoat20To is not null %}
        {% set thermalActive = thermTemp is not null and thermEnv %}
        {% set activeFacetsCount = selectedManufacturerIds.count
            + (appMinTempActive ? 1 : 0)
            + (volumeSolidActive ? 1 : 0)
            + (minRecoat20Active ? 1 : 0)
            + (maxRecoat20Active ? 1 : 0)
            + (thermalActive ? 1 : 0)
            + selectedTags|length
            + selectedBaseValues.count %}
        {% set appMinSummary = appMinTempActive
            ? (appMinTempFrom is not null and appMinTempTo is not null ? appMinTempFrom ~ '…' ~ appMinTempTo ~ '°C'
               : (appMinTempFrom is not null ? '≥ ' ~ appMinTempFrom ~ '°C' : '≤ ' ~ appMinTempTo ~ '°C'))
            : null %}
        {% set vsSummary = volumeSolidActive
            ? (volumeSolidFrom is not null and volumeSolidTo is not null ? volumeSolidFrom ~ '…' ~ volumeSolidTo ~ '%'
               : (volumeSolidFrom is not null ? '≥ ' ~ volumeSolidFrom ~ '%' : '≤ ' ~ volumeSolidTo ~ '%'))
            : null %}
        {% set thSummary = thermalActive
            ? thermTemp ~ '°C ' ~ (thermEnv == 'immersion' ? 'погр.' : 'сух.') ~ (thermIncludingPeak ? ' +пик' : '')
            : null %}
        {% set minRecoat20Summary = minRecoat20Active
            ? (minRecoat20From is not null and minRecoat20To is not null
                ? minRecoat20From ~ '…' ~ minRecoat20To ~ ' ' ~ minRecoat20To|plural_ru('час', 'часа', 'часов')
                : (minRecoat20From is not null
                    ? '≥ ' ~ minRecoat20From ~ ' ' ~ minRecoat20From|plural_ru('час', 'часа', 'часов')
                    : '≤ ' ~ minRecoat20To ~ ' ' ~ minRecoat20To|plural_ru('час', 'часа', 'часов')))
            : null %}
        {% set maxRecoat20Summary = maxRecoat20Active
            ? (maxRecoat20From is not null and maxRecoat20To is not null
                ? maxRecoat20From ~ '…' ~ maxRecoat20To ~ ' ' ~ maxRecoat20To|plural_ru('день', 'дня', 'дней')
                : (maxRecoat20From is not null
                    ? '≥ ' ~ maxRecoat20From ~ ' ' ~ maxRecoat20From|plural_ru('день', 'дня', 'дней')
                    : '≤ ' ~ maxRecoat20To ~ ' ' ~ maxRecoat20To|plural_ru('день', 'дня', 'дней')))
            : null %}
        {% set appMinResetUrl = path('app_cabinet_coating_coating_list', app.request.query.all|merge({appMinTempFrom: null, appMinTempTo: null, page: null})|filter(v => v is not null)) %}
        {% set vsResetUrl = path('app_cabinet_coating_coating_list', app.request.query.all|merge({volumeSolidFrom: null, volumeSolidTo: null, page: null})|filter(v => v is not null)) %}
        {% set thResetUrl = path('app_cabinet_coating_coating_list', app.request.query.all|merge({thermTemp: null, thermEnv: null, thermPeak: null, page: null})|filter(v => v is not null)) %}
        {% set minRecoat20ResetUrl = path('app_cabinet_coating_coating_list', app.request.query.all|merge({minRecoat20From: null, minRecoat20To: null, page: null})|filter(v => v is not null)) %}
        {% set maxRecoat20ResetUrl = path('app_cabinet_coating_coating_list', app.request.query.all|merge({maxRecoat20From: null, maxRecoat20To: null, page: null})|filter(v => v is not null)) %}

        {% embed 'components/entity_search.html.twig' with {
            list_route: 'app_cabinet_coating_coating_list',
            form_id: 'coatingListForm',
            search_name: 'search',
            search_value: search,
            search_placeholder: 'По названию и описанию (3-50 символов)',
            sort_options: sortOptions|map(o => {value: o.value, label: o.label}),
            sort_current: sort.value,
            sort_default: defaultSort.value,
            active_count: activeFacetsCount,
            drawer_id: 'allFiltersOffcanvas',
            drawer_form_id: 'allFiltersForm',
        } %}
            {% block chips %}
                {# Preserve-state: hidden input'ы всех текущих query-параметров
                   (кроме search/page/partial). Multi-value → суффикс '[]'. #}
                {% for name, value in preservedParams %}
                    {% if value is iterable %}
                        {% for v in value %}
                            <input type="hidden" name="{{ name }}[]" value="{{ v }}">
                        {% endfor %}
                    {% else %}
                        <input type="hidden" name="{{ name }}" value="{{ value }}">
                    {% endif %}
                {% endfor %}

                {# --- Производитель (multi) — скрыт из chip-row.
                     Доступ через шторку «Все фильтры» (секция «Производитель»).
                     Активные производители видны там же + через chip-фасет
                     «Активные фильтры» в шапке шторки. Значения сохраняются в
                     форме через hidden manufacturerIds[] (см. блок preserve
                     выше в этой форме) и через селекторы шторки. #}
                {% if selectedManufacturerIds.count > 0 %}
                    {% for m in manufacturers|filter(m => m.id in selectedManufacturerIds.list) %}
                        {% set idsAfterRemove = selectedManufacturerIds.list|filter(id => id != m.id) %}
                        {% set removeUrl = path('app_cabinet_coating_coating_list', app.request.query.all|merge({manufacturerIds: idsAfterRemove, page: null})|filter(v => v is not null)) %}
                        <a href="{{ removeUrl }}"
                           class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                           title="Убрать «{{ m.title }}» из фильтра">
                            {{ m.title }} <i class="bi bi-x-lg"></i>
                        </a>
                    {% endfor %}
                {% endif %}

                {# --- Мин Т нанесения --- #}
                {% if appMinTempActive %}
                    <a href="{{ appMinResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр">
                        Мин Т нанесения: {{ appMinSummary }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="appMinTemp">
                        Мин Т нанесения
                    </button>
                {% endif %}

                {# --- Сухой остаток --- #}
                {% if volumeSolidActive %}
                    <a href="{{ vsResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр">
                        Сухой остаток: {{ vsSummary }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="volumeSolid">
                        Сухой остаток
                    </button>
                {% endif %}

                {# --- Температура эксплуатации --- #}
                {% if thermalActive %}
                    <a href="{{ thResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр">
                        Работает при {{ thSummary }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="thermal">
                        Температура эксплуатации
                    </button>
                {% endif %}

                {# --- Тип связующего (multi) --- #}
                {% if selectedBaseValues.count > 0 %}
                    {% for b in coatingBases|filter(b => b.value in selectedBaseValues.list) %}
                        {% set valsAfterRemove = selectedBaseValues.list|filter(v => v != b.value) %}
                        {% set removeUrl = path('app_cabinet_coating_coating_list', app.request.query.all|merge({baseValues: valsAfterRemove, page: null})|filter(v => v is not null)) %}
                        <a href="{{ removeUrl }}"
                           class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                           title="Убрать «{{ b.title }}» из фильтра">
                            {{ b.title }} <i class="bi bi-x-lg"></i>
                        </a>
                    {% endfor %}
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="base">
                        Тип связующего
                    </button>
                {% endif %}

                {# --- Мин перекрытие (20°C) --- #}
                {% if minRecoat20Active %}
                    <a href="{{ minRecoat20ResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр">
                        Мин перекрытие: {{ minRecoat20Summary }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="minRecoat20">
                        Мин перекрытие
                    </button>
                {% endif %}

                {# --- Макс перекрытие (20°C) --- #}
                {% if maxRecoat20Active %}
                    <a href="{{ maxRecoat20ResetUrl }}"
                       class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1"
                       title="Убрать фильтр">
                        Макс перекрытие: {{ maxRecoat20Summary }} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="maxRecoat20">
                        Макс перекрытие
                    </button>
                {% endif %}

            {% endblock %}


            {% block drawer %}
                    {# Активные фильтры сверху шторки — как у mvideo, для мгновенного обзора. #}
                    {% if activeFacetsCount > 0 %}
                        <div class="p-3 mb-2 rounded-3 bg-body-tertiary">
                            <div class="small text-muted mb-2">Активные фильтры</div>
                            <div class="d-flex flex-wrap gap-1">
                                {% for tag in selectedTags %}
                                    {% set idsAfterRemove = selectedTagIdList|filter(id => id != tag.id) %}
                                    {% set q = app.request.query.all|merge({tagIds: idsAfterRemove, page: null})|filter(v => v is not null) %}
                                    {# Инлайн чипа (не macro): _self внутри embed'а
                                       ссылается на partial'у components/list_page.html.twig,
                                       где макроса нет. #}
                                    <span class="badge text-bg-{{ tag.type|tag_bootstrap_color }} fw-normal d-inline-flex align-items-center gap-1">
                                        {{ tag.title }}
                                        <a href="{{ path('app_cabinet_coating_coating_list', q) }}"
                                           class="btn-close btn-close-white btn-close-sm"
                                           title="Убрать «{{ tag.title }}» из фильтра"
                                           aria-label="Убрать из фильтра"></a>
                                    </span>
                                {% endfor %}
                                {% for m in manufacturers|filter(m => m.id in selectedManufacturerIds.list) %}
                                    {% set mfIdsAfterRemove = selectedManufacturerIds.list|filter(id => id != m.id) %}
                                    {% set q = app.request.query.all|merge({manufacturerIds: mfIdsAfterRemove, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        {{ m.title }}
                                        <a href="{{ path('app_cabinet_coating_coating_list', q) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1"
                                           aria-label="Убрать"></a>
                                    </span>
                                {% endfor %}
                                {% for b in coatingBases|filter(b => b.value in selectedBaseValues.list) %}
                                    {% set valsAfterRemove = selectedBaseValues.list|filter(v => v != b.value) %}
                                    {% set q = app.request.query.all|merge({baseValues: valsAfterRemove, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        {{ b.title }}
                                        <a href="{{ path('app_cabinet_coating_coating_list', q) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1"
                                           aria-label="Убрать"></a>
                                    </span>
                                {% endfor %}
                                {% if appMinTempActive %}
                                    {% set q = app.request.query.all|merge({appMinTempFrom: null, appMinTempTo: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        Мин Т: {{ appMinTempFrom is not null ? appMinTempFrom : '−∞' }}…{{ appMinTempTo is not null ? appMinTempTo : '+∞' }} °C
                                        <a href="{{ path('app_cabinet_coating_coating_list', q) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1" aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if volumeSolidActive %}
                                    {% set q = app.request.query.all|merge({volumeSolidFrom: null, volumeSolidTo: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        Сухой остаток: {{ volumeSolidFrom is not null ? volumeSolidFrom : '−∞' }}…{{ volumeSolidTo is not null ? volumeSolidTo : '+∞' }} %
                                        <a href="{{ path('app_cabinet_coating_coating_list', q) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1" aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if thermalActive %}
                                    {% set q = app.request.query.all|merge({thermTemp: null, thermEnv: null, thermPeak: null, page: null})|filter(v => v is not null) %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        Работает при {{ thermTemp }} °C ({{ thermEnv == 'immersion' ? 'погр.' : 'сух.' }}{{ thermIncludingPeak ? ' +пик' : '' }})
                                        <a href="{{ path('app_cabinet_coating_coating_list', q) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1" aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if minRecoat20Active %}
                                    {% set q = app.request.query.all|merge({minRecoat20From: null, minRecoat20To: null, page: null})|filter(v => v is not null) %}
                                    {% set unitN = minRecoat20To is not null ? minRecoat20To : minRecoat20From %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        Мин перекр.: {{ minRecoat20From is not null ? minRecoat20From : '−∞' }}…{{ minRecoat20To is not null ? minRecoat20To : '+∞' }} {{ unitN|plural_ru('час', 'часа', 'часов') }}
                                        <a href="{{ path('app_cabinet_coating_coating_list', q) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1" aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                                {% if maxRecoat20Active %}
                                    {% set q = app.request.query.all|merge({maxRecoat20From: null, maxRecoat20To: null, page: null})|filter(v => v is not null) %}
                                    {% set unitN = maxRecoat20To is not null ? maxRecoat20To : maxRecoat20From %}
                                    <span class="badge text-bg-secondary fw-normal d-inline-flex align-items-center gap-1 py-1 px-2">
                                        Макс перекр.: {{ maxRecoat20From is not null ? maxRecoat20From : '−∞' }}…{{ maxRecoat20To is not null ? maxRecoat20To : '+∞' }} {{ unitN|plural_ru('день', 'дня', 'дней') }}
                                        <a href="{{ path('app_cabinet_coating_coating_list', q) }}"
                                           class="btn-close btn-close-white btn-close-sm ms-1" aria-label="Убрать"></a>
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                    {# === Секция: Температура нанесения === #}
                    {% include 'components/range_filter_card.html.twig' with {
                        title: 'Мин Т нанесения',
                        unit: '°C',
                        name_from: 'appMinTempFrom',
                        facet_id: 'appMinTemp',
                        name_to: 'appMinTempTo',
                        from: appMinTempFrom,
                        to: appMinTempTo,
                        presets: appMinTempPresets,
                        min: -30,
                        max: 50,
                        reset_label: 'Любая',
                    } only %}

                    {# === Секция: Сухой остаток === #}
                    {% include 'components/range_filter_card.html.twig' with {
                        title: 'Сухой остаток',
                        unit: '% об.',
                        name_from: 'volumeSolidFrom',
                        facet_id: 'volumeSolid',
                        name_to: 'volumeSolidTo',
                        from: volumeSolidFrom,
                        to: volumeSolidTo,
                        presets: volumeSolidPresets,
                        min: 10,
                        max: 100,
                        reset_label: 'Любой',
                    } only %}

                    {# === Секция: Мин интервал перекрытия при 20°C ===
                       UI-единица — часы (backend/RECOATING_AT_20C работают в минутах;
                       ListAction конвертит при построении CoatingsFilter). #}
                    {% include 'components/range_filter_card.html.twig' with {
                        title: 'Мин перекрытие (20°C)',
                        unit: 'ч',
                        name_from: 'minRecoat20From',
                        facet_id: 'minRecoat20',
                        name_to: 'minRecoat20To',
                        from: minRecoat20From,
                        to: minRecoat20To,
                        presets: minRecoat20Presets,
                        min: 0,
                        max: 168,
                        reset_label: 'Любой',
                    } only %}

                    {# === Секция: Макс интервал перекрытия при 20°C ===
                       UI-единица — сутки. #}
                    {% include 'components/range_filter_card.html.twig' with {
                        title: 'Макс перекрытие (20°C)',
                        unit: 'сут',
                        name_from: 'maxRecoat20From',
                        facet_id: 'maxRecoat20',
                        name_to: 'maxRecoat20To',
                        from: maxRecoat20From,
                        to: maxRecoat20To,
                        presets: maxRecoat20Presets,
                        min: 0,
                        max: 365,
                        reset_label: 'Любой',
                    } only %}

                    {# === Секция: Температура эксплуатации === #}
                    <div id="facet-thermal" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                        <h6 class="fw-semibold mb-2">Температура эксплуатации</h6>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">°C</label>
                                <input type="number" name="thermTemp" value="{{ thermTemp }}"
                                       class="form-control form-control-sm"
                                       min="-200" max="1000" step="5" placeholder="напр. 90">
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted mb-1">Среда</label>
                                {% set thermEnvEffective = thermEnv ?: 'dry_heat' %}
                                <select name="thermEnv" class="form-select form-select-sm">
                                    <option value="dry_heat" {% if thermEnvEffective == 'dry_heat' %}selected{% endif %}>Сухое тепло</option>
                                    <option value="immersion" {% if thermEnvEffective == 'immersion' %}selected{% endif %}>Погружение</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input"
                                           id="thermPeakOff" name="thermPeak" value="1"
                                           {% if thermIncludingPeak %}checked{% endif %}>
                                    <label class="form-check-label small" for="thermPeakOff">Включая пиковые нагрузки</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# === Секция: Тип связующего (пилюли-тогглы: выбранная — заливка) === #}
                    <div id="facet-base" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                        <h6 class="fw-semibold mb-2">Тип связующего</h6>
                        <div class="d-flex flex-wrap gap-1">
                            {% for b in coatingBases %}
                                <label class="facet-pill">
                                    <input type="checkbox" name="baseValues[]" value="{{ b.value }}"
                                           {% if b.value in selectedBaseValues.list %}checked{% endif %}>
                                    {{ b.title }}<span class="facet-pill-sub">({{ b.value }})</span>
                                </label>
                            {% endfor %}
                        </div>
                    </div>

                    {# === Секция: Производитель (пилюли-тогглы) === #}
                    <div class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                        <h6 class="fw-semibold mb-2">Производитель</h6>
                        <div class="d-flex flex-wrap gap-1">
                            {% for m in manufacturers %}
                                <label class="facet-pill">
                                    <input type="checkbox" name="manufacturerIds[]" value="{{ m.id }}"
                                           {% if m.id in selectedManufacturerIds.list %}checked{% endif %}>
                                    {{ m.title }}
                                </label>
                            {% endfor %}
                        </div>
                    </div>

                    {# === Секция: Теги ===
                         Отдельный Tagify-инстанс со своим data-coating-tags-group scope,
                         hidden-input'ы пишутся здесь и подхватываются только этой формой
                         (шторки), не пересекаясь с другим Tagify в chip-row (в другой форме). #}
                    <div class="p-3 mb-2 rounded-3 bg-body-tertiary" data-coating-tags-group>
                        <h6 class="fw-semibold mb-2">Теги</h6>
                        <input type="text"
                               data-controller="coating-tags"
                               data-coating-tags-existing-value="{{ selectedTagsJson }}"
                               data-coating-tags-suggest-url-value="{{ path('app_cabinet_coating_coating_tag_suggest') }}"
                               data-coating-tags-create-url-value="{{ path('app_cabinet_coating_coating_tag_create') }}"
                               data-coating-tags-hidden-input-name-value="tagIds[]"
                               data-coating-tags-allow-create-value="false"
                               class="form-control form-control-sm"
                               placeholder="Начните вводить тег...">
                    </div>
            {% endblock %}
        {% endembed %}

        {% if error %}
            <div class="alert alert-warning" role="alert">{{ error }}</div>
        {% endif %}
    {% endblock %}

    {% block list_content %}
        {# Счётчик над списком. Сортировка переехала в chip-row выше.
           Оформлен как inline-«pill» в тертиарном фоне — общий стиль тертиарных
           карточек, но компактный, чтобы не занимать много места над списком. #}
        <div class="d-inline-block p-2 px-3 mb-3 rounded-3 bg-body-tertiary small">
            Найдено: <strong>{{ result.pager.total_items }}</strong>
        </div>

        {# Infinite scroll через общий components/infinite_list.html.twig
                   partial + assets/controllers/infinite_list_controller.js. base_url
                   фильтруется от page/partial — Stimulus сам их добавит для догрузки.
                   Deep-link ?page=N всё равно работает (server-side render'ит нужную страницу),
                   но сам base_url для fetch-а ими не загрязняется. #}
                {% set totalPages = (result.pager.total_items / result.pager.perPage)|round(0, 'ceil') %}
                {% set baseQuery = app.request.query.all|filter((v, k) => v is not null and k != 'page' and k != 'partial') %}
                {% include 'components/infinite_list.html.twig' with {
                    items_template: 'admin/coating/coating/_coating_cards_batch.html.twig',
                    items_params: {
                        coatings: result.coatings,
                        canEdit: canEdit,
                        selectedTagIdList: selectedTagIdList,
                    },
                    total_pages: totalPages,
                    base_url: path('app_cabinet_coating_coating_list', baseQuery),
                    wrapper_class: 'ecard-grid',
                } only %}

                {# Fallback: обычный pager для случая когда JS выключен или Stimulus
                   не поднялся. При работающем JS контроллер скрывает его. #}
                <noscript>
                    {% include 'components/pager.html.twig' with {'pager': result.pager} %}
                </noscript>

                {% if canEdit %}
                    {% include 'components/delete_modal.html.twig' with {'delete':'app_cabinet_coating_coating_delete'} %}
                {% endif %}
    {% endblock %}

    {% block empty_state %}
        {% if search %}
            {# Специфичное сообщение для поискового empty-state: показываем
               исходный запрос + подсказку. На multi-word fuzzy не отрабатывает
               по дизайну (см. CoatingRepository::findByFilter, Option C).
               Тертиарная карточка в общем стиле (раньше был alert alert-warning
               с shadow — не совпадало с остальными тертиарными зонами). #}
            <div class="p-4 mt-3 rounded-3 bg-body-tertiary text-center" role="status">
                <i class="bi bi-search fs-1 d-block mb-2 text-body-secondary"></i>
                <h5 class="fw-semibold mb-2">Ничего не найдено</h5>
                <p class="mb-2">
                    По запросу «<strong>{{ search }}</strong>» совпадений нет.
                </p>
                <p class="small text-body-secondary mb-0">
                    Каждое слово должно встретиться в названии, описании или тегах.
                    Попробуйте сократить запрос или использовать другие слова.
                </p>
            </div>
        {% else %}
            {% include 'components/empty.html.twig' %}
        {% endif %}
    {% endblock %}
    {% endembed %}

        {# Floating tray «К сравнению». Общий стиль: bg-body + rounded-3 + shadow
           вместо старого .card chrome. Shadow нужен, чтобы плашка визуально
           отлипала от контента списка (она поверх). #}
        {# Плавающий трей сравнения: removable-чипы с названиями выбранных покрытий +
           «Сравнить». Позиция — над таб-панелью на мобиле (см. .compare-tray). #}
        <div class="compare-tray d-none" data-compare-tray-target="bar">
            <div class="compare-tray-inner">
                <div class="compare-tray-head">
                    <span class="ct-title">Сравнение</span>
                    <span class="ct-hint"><strong data-compare-tray-target="count">0</strong> из 4</span>
                    <button type="button" class="ct-clear" data-action="click->compare-tray#clear">Очистить</button>
                </div>
                <div class="compare-tray-body">
                    <div class="compare-tray-chips" data-compare-tray-target="chips"></div>
                    <button type="button" class="btn btn-sm btn-primary ct-go"
                            data-action="click->compare-tray#open"
                            data-compare-tray-target="openBtn" disabled>Сравнить</button>
                </div>
            </div>
        </div>

        {# FAB создания (мобайл; на десктопе — кнопка «+» в шапке списка). #}
        {% if canEdit %}
            <a class="fab-create" href="{{ path('app_cabinet_coating_coating_create') }}" aria-label="Новое покрытие">
                <i class="bi bi-plus"></i>
            </a>
        {% endif %}
    </div>

    {# Логика portal + viewport-adaptive живёт в assets/controllers/chip_facets_controller.js
       (data-controller="chip-facets" на <form> выше). #}
{% endblock %}
