{% extends '/cabinet/index.html.twig' %}
{% import 'admin/coating/coating/_audit_value.html.twig' as audit_value %}

{% block title %}{{ parent() }} | Журнал изменений: Покрытия{% endblock %}

{% block content %}
    {% set actionLabels = {
        created: 'Создано',
        updated: 'Изменено',
        deleted: 'Удалено',
    } %}

    <div class="p-2 p-md-3">
        <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-3 bg-body-tertiary">
            <h1 class="h3 mb-0">Журнал изменений: Покрытия</h1>
            <a href="{{ path('app_cabinet_coating_coating_list') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> К списку
            </a>
        </div>

        <form method="get" action="{{ path('app_cabinet_coating_coating_audit_journal') }}"
              class="d-flex flex-wrap align-items-center gap-2 mb-3 p-3 rounded-3 bg-body-tertiary">
            <label for="auditJournalActor" class="form-label small text-muted mb-0">Актор (id)</label>
            <input type="text" id="auditJournalActor" name="actor" value="{{ actorId }}"
                   class="form-control form-control-sm w-auto" placeholder="ulid пользователя или «system»">
            <button type="submit" class="btn btn-sm btn-primary">Показать</button>
            {% if actorId %}
                <a href="{{ path('app_cabinet_coating_coating_audit_journal') }}" class="btn btn-sm btn-outline-secondary">
                    Сбросить
                </a>
            {% endif %}
        </form>

        <div class="p-3 rounded-3 bg-body-tertiary">
            {% for entry in log %}
                <div class="audit-entry">
                    <div class="audit-entry__meta">
                        <a href="{{ path('app_cabinet_coating_coating_history', {id: entry.entityId}) }}"
                           class="audit-entry__actor text-decoration-none">{{ entityTitles[entry.entityId]|default(entry.entityId) }}</a>
                        <span class="audit-entry__sep">·</span>
                        <span class="audit-entry__actor">{{ entry.actorLabel }}</span>
                        <span class="audit-entry__sep">·</span>
                        <span class="audit-entry__date">{{ entry.occurredAt|date('d.m.Y H:i') }}</span>
                        <span class="audit-entry__sep">·</span>
                        <span class="audit-entry__action">{{ actionLabels[entry.action.value] ?? entry.action.value }}</span>
                    </div>
                    {% for change in entry.changes %}
                        <div class="audit-entry__field">
                            <span class="audit-entry__label">{{ change.label }}:</span>
                            {% if change.op.value == 'set' %}
                                <span class="audit-entry__old">{{ audit_value.display(change.old) }}</span>
                                <i class="bi bi-arrow-right audit-entry__arrow"></i>
                                <span class="audit-entry__new">{{ audit_value.display(change.new) }}</span>
                            {% elseif change.op.value == 'add' %}
                                <span class="audit-entry__add">+ {{ audit_value.display(change.new) }}</span>
                            {% else %}
                                <span class="audit-entry__remove">− {{ audit_value.display(change.old) }}</span>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-body-secondary mb-0">Изменений пока нет.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
