{% extends '/cabinet/index.html.twig' %}

{% set inputData = inputData|default({}) %}
{% set isUpdate = inputData.id is defined and inputData.id %}
{% set pageTitle = isUpdate ? 'Обновление покрытия' : 'Добавление покрытия' %}
{% set submitLabel = isUpdate ? 'Сохранить' : 'Добавить' %}
{% set actionUrl = isUpdate
    ? path('app_cabinet_coating_coating_update', {id: inputData.id})
    : path('app_cabinet_coating_coating_create') %}
{% set selectedTagIds = (inputData.tags ?? [])|map(t => t.id) %}
{% set listUrl = path('app_cabinet_coating_coating_list') %}
{% set formId = 'coating-form-el' %}
{% set anchors = [
    {id: 'sec-desc',   label: 'Описание'},
    {id: 'sec-class',  label: 'Классификация'},
    {id: 'sec-look',   label: 'Внешний вид'},
    {id: 'sec-compo',  label: 'Состав'},
    {id: 'sec-dft',    label: 'ТСП'},
    {id: 'sec-apply',  label: 'Нанесение'},
    {id: 'sec-limits', label: 'Пределы'},
    {id: 'sec-cure',   label: 'Отверждение'},
] %}

{% block title %}{{ parent() }} | {{ pageTitle }}{% endblock %}

{% block content %}
    {% embed 'components/form_page.html.twig' with {
        title: pageTitle,
        back_url: listUrl,
        save_form_id: formId,
        save_label: submitLabel,
        anchors: anchors,
    } %}
        {% block sections %}
        {# Импорт внутри блока: макросы, импортированные в начале шаблона, не видны внутри
           {% embed %}-блока (отдельный scope). #}
        {% from '/components/duration_input.html.twig' import duration_input %}
        {# data-controller на обёртке, а не на <form>, чтобы #durationModal был соседом формы (а не её
           потомком) — иначе скрытые number-инпуты модалки участвуют в HTML5-валидации формы и роняют
           submit с «An invalid form control with name='' is not focusable». #}
        <div data-controller="coating-form">
            {# novalidate — единый паттерн: валидирует бэк, форма рендерит .form-alert. Без novalidate
               браузер блокировал бы submit нативным tooltip'ом, который клипится overflow-hidden
               карточек и часто не виден. Атрибуты min/max на инпутах остаются как UX-хинт
               (up/down-стрелки в пределах диапазона), но не блокируют submit. #}
            <form id="{{ formId }}" method="post" action="{{ actionUrl }}" class="w-100" novalidate
                  data-action="submit->coating-form#validateBeforeSubmit">
                {% if error is defined and error %}
                    <div class="form-alert" role="alert">
                        <i class="bi bi-exclamation-octagon"></i>
                        <div>
                            <div class="form-alert-title">Не удалось сохранить</div>
                            <div>{{ error }}</div>
                        </div>
                    </div>
                {% endif %}

            {# 1. Описание #}
            <div id="sec-desc" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">Описание</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="inputTitle" class="form-label">Название</label>
                        <input type="text" value="{{ inputData.title }}" name="title" id="inputTitle"
                               class="form-control" required autofocus minlength="3" maxlength="100"
                               placeholder="Укажите название...">
                    </div>
                    <div class="col-md-6">
                        <label for="inputManufacturer" class="form-label">Производитель</label>
                        <select class="form-select" id="inputManufacturer" name="manufacturer[id]" required>
                            <option value="">Укажите производителя...</option>
                            {% for manufacturer in pagedManufacturers.manufacturers %}
                                <option value="{{ manufacturer.id }}"
                                        {% if manufacturer.id == inputData.manufacturer.id %} selected {% endif %}>
                                    {{ manufacturer.title }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <label for="inputDescription" class="form-label">Описание</label>
                        <textarea name="description" id="inputDescription" class="form-control"
                                  rows="3" maxlength="1500" required
                                  placeholder="Укажите описание...">{{ inputData.description }}</textarea>
                        <div class="form-text">до 1500 символов</div>
                    </div>
                </div>
            </div>

            {# 2. Классификация #}
            <div id="sec-class" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">Классификация</h6>
                <div class="row g-3">
                        <div class="col-12">
                            <label for="inputBase" class="form-label">Тип ЛКМ (основание)</label>
                            <select class="form-select" id="inputBase" name="base" required>
                                {% for b in coatingBases %}
                                    <option value="{{ b.value }}"
                                            {% if (inputData.base ?? 'EP') == b.value %} selected {% endif %}>
                                        {{ b.title }} ({{ b.iso }}{% if b.gost|length > 0 %} / {{ b.gost|join(', ') }}{% endif %})
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mb-3">
                                <input type="checkbox" class="form-check-input" role="switch" id="coating_is_zinc_rich"
                                       name="isZincRich" {% if inputData.isZincRich ?? false %}checked{% endif %}>
                                <label class="form-check-label" for="coating_is_zinc_rich">
                                    Цинкнаполненная грунтовка (Zn(R), ≥80% Zn)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-label">Вид покрытия</div>
                            {% for tag in pagedCoatingTags.coatingTags|filter(t => t.type == 'CoatingProtectionType') %}
                                <div class="form-check">
                                    <input name="tags[][id]" class="form-check-input" type="checkbox"
                                           value="{{ tag.id }}" id="protectionType-{{ tag.id }}"
                                            {% if tag.id in selectedTagIds %} checked {% endif %}>
                                    <label class="form-check-label" for="protectionType-{{ tag.id }}">
                                        {{ tag.title|trans() }}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="col-md-6">
                            <div class="form-label">Тип покрытия</div>
                            {% for tag in pagedCoatingTags.coatingTags|filter(t => t.type == 'CoatingCoatType') %}
                                <div class="form-check">
                                    <input name="tags[][id]" class="form-check-input" type="checkbox"
                                           value="{{ tag.id }}" id="coatType-{{ tag.id }}"
                                            {% if tag.id in selectedTagIds %} checked {% endif %}>
                                    <label class="form-check-label" for="coatType-{{ tag.id }}">
                                        {{ tag.title|trans() }}
                                    </label>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="col-12" data-coating-tags-group>
                            <label class="form-label">Теги</label>
                            <input type="text"
                                   data-controller="coating-tags"
                                   data-coating-tags-existing-value="{{ existingTagsJson|default('[]') }}"
                                   data-coating-tags-suggest-url-value="{{ path('app_cabinet_coating_coating_tag_suggest') }}"
                                   data-coating-tags-create-url-value="{{ path('app_cabinet_coating_coating_tag_create') }}"
                                   class="form-control"
                                   placeholder="Начните вводить тег...">
                            <div class="form-text">Привязанные general-теги. Начните вводить — autocomplete покажет похожие; если ничего не найдено — кликните «Создать "..."».</div>
                        </div>
                    </div>
            </div>

            {# 2b. Внешний вид — блеск, колеруемость, возможные цвета #}
            <div id="sec-look" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">Внешний вид</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="inputGloss" class="form-label">Блеск</label>
                        <select class="form-select" id="inputGloss" name="gloss">
                            <option value="">Не указан</option>
                            {% for g in glossOptions %}
                                <option value="{{ g.value }}" {% if (inputData.gloss ?? '') == g.value %} selected {% endif %}>
                                    {{ g.title }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" role="switch" id="inputIsTintable"
                                   name="isTintable" {% if inputData.isTintable ?? false %}checked{% endif %}>
                            <label class="form-check-label" for="inputIsTintable">
                                Колеруемое (можно получить любой цвет)
                            </label>
                        </div>
                        <div class="form-text">У колеруемого покрытия список возможных цветов можно не указывать.</div>
                    </div>
                    <div class="col-12" data-coating-colors-group>
                        <label class="form-label">Возможные цвета</label>
                        <input type="text"
                               data-controller="coating-colors"
                               data-coating-colors-existing-value="{{ (inputData.colors ?? [])|json_encode }}"
                               data-coating-colors-suggest-url-value="{{ path('app_cabinet_coating_color_suggest') }}"
                               class="form-control"
                               placeholder="Начните вводить название или код RAL...">
                        <div class="form-text">Autocomplete покажет похожие цвета со свотчами; если нужного нет — «+ Создать» откроет выбор из каталога RAL или кастомный цвет.</div>
                    </div>
                </div>
            </div>

            {# 3. Состав и упаковка #}
            <div id="sec-compo" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">Состав и упаковка</h6>
                <div class="row g-3">
                        <div class="col-md-3">
                            <label for="inputVolumeSolid" class="form-label">Сухой остаток</label>
                            <div class="input-group">
                                <input type="number" value="{{ inputData.volumeSolid }}" name="volumeSolid"
                                       id="inputVolumeSolid" class="form-control" required min="10" max="100">
                                <span class="input-group-text">об. %</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label for="inputMassDensity" class="form-label">Плотность</label>
                            <div class="input-group">
                                <input type="number" value="{{ inputData.massDensity }}" name="massDensity"
                                       id="inputMassDensity" class="form-control" required
                                       min="0" max="100" step="0.01">
                                <span class="input-group-text">кг/л</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label for="inputPack" class="form-label">Упаковка</label>
                            <div class="input-group">
                                <input type="number" value="{{ inputData.pack }}" name="pack"
                                       id="inputPack" class="form-control" required
                                       min="1" max="1000" step="0.01">
                                <span class="input-group-text">л</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label for="inputThinner" class="form-label">Разбавитель</label>
                            <input type="text" value="{{ inputData.thinner }}" name="thinner" id="inputThinner"
                                   class="form-control" maxlength="100" placeholder="Опционально">
                        </div>
                    </div>
            </div>

            {# 4. Толщина сухой плёнки (ТСП) #}
            <div id="sec-dft" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">
                    Толщина сухой плёнки (ТСП)
                    <span class="text-muted fw-normal small ms-1">мкм</span>
                </h6>
                <div class="row g-3">
                        <div class="col-md-4">
                            <label for="inputMinDft" class="form-label">Минимальная</label>
                            <input type="number" value="{{ inputData.minDft }}" name="minDft" id="inputMinDft"
                                   class="form-control" required min="10" max="9999">
                        </div>
                        <div class="col-md-4">
                            <label for="inputTdsDft" class="form-label">Целевая (по тех. карте)</label>
                            <input type="number" value="{{ inputData.tdsDft }}" name="tdsDft" id="inputTdsDft"
                                   class="form-control" required min="10" max="9999">
                        </div>
                        <div class="col-md-4">
                            <label for="inputMaxDft" class="form-label">Максимальная</label>
                            <input type="number" value="{{ inputData.maxDft }}" name="maxDft" id="inputMaxDft"
                                   class="form-control" required min="10" max="9999">
                        </div>
                    </div>
            </div>

            {# 5. Нанесение #}
            <div id="sec-apply" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">Нанесение</h6>
                <div class="row g-3">
                        <div class="col-md-4">
                            <label for="inputApplicationMinTemp" class="form-label">Мин температура нанесения</label>
                            <div class="input-group">
                                <input type="number" value="{{ inputData.applicationMinTemp }}" name="applicationMinTemp"
                                       id="inputApplicationMinTemp" class="form-control"
                                       required min="-30" max="50">
                                <span class="input-group-text">°C</span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <label for="inputDryingMaxTemp" class="form-label">Макс температура сушки</label>
                            <div class="input-group">
                                <input type="number" value="{{ inputData.dryingMaxTemp|default(50) }}" name="dryingMaxTemp"
                                       id="inputDryingMaxTemp" class="form-control"
                                       required min="0" max="250">
                                <span class="input-group-text">°C</span>
                            </div>
                            <div class="form-text">Все точки сушки/перекрытия должны быть в [мин нанесения, макс сушки].</div>
                        </div>
                    </div>
            </div>

            {# 6. Температурные пределы эксплуатации — сухое тепло и погружение.
                  Оба блока опциональные: если continuous_min/max пустые, VO не создаётся.
                  Все инварианты (min<max, peak>continuous_max, duration>0 только при peak)
                  проверяются в ThermalExposureLimits::__construct → AppException → форма. #}
            {% set dryHeat = inputData.dryHeatExposure ?? {continuous_min: '', continuous_max: '', peak_max: '', peak_duration_minutes: ''} %}
            {% set immersion = inputData.immersionExposure ?? {continuous_min: '', continuous_max: '', peak_max: '', peak_duration_minutes: ''} %}
            <div id="sec-limits" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">Пределы эксплуатации</h6>

                    {# ─── Сухое тепло ─── #}
                    <div class="p-3 mb-3 rounded-3 bg-body">
                        <h6 class="mb-2">Сухое тепло</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Мин, °C</label>
                                <input type="number" name="dryHeatExposure[continuous_min]"
                                       value="{{ dryHeat.continuous_min }}"
                                       class="form-control" min="-200" max="1000"
                                       placeholder="напр. -20">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Макс, °C</label>
                                <input type="number" name="dryHeatExposure[continuous_max]"
                                       value="{{ dryHeat.continuous_max }}"
                                       class="form-control" min="-200" max="1000"
                                       placeholder="напр. 120">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Пиковая, °C</label>
                                <input type="number" name="dryHeatExposure[peak_max]"
                                       value="{{ dryHeat.peak_max }}"
                                       class="form-control" min="-200" max="1000"
                                       placeholder="опционально">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Длительность пика, мин</label>
                                <input type="number" name="dryHeatExposure[peak_duration_minutes]"
                                       value="{{ dryHeat.peak_duration_minutes }}"
                                       class="form-control" min="1" max="1440"
                                       placeholder="по умолчанию 60">
                            </div>
                        </div>
                        <div class="form-text">Оставьте все поля пустыми, если данных нет. Мин и Макс обязательны в паре; пик — опционально.</div>
                    </div>

                    {# ─── Погружение ─── #}
                    <div class="p-3 rounded-3 bg-body">
                        <h6 class="mb-2">Погружение</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">Мин, °C</label>
                                <input type="number" name="immersionExposure[continuous_min]"
                                       value="{{ immersion.continuous_min }}"
                                       class="form-control" min="-200" max="1000"
                                       placeholder="напр. 0">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Макс, °C</label>
                                <input type="number" name="immersionExposure[continuous_max]"
                                       value="{{ immersion.continuous_max }}"
                                       class="form-control" min="-200" max="1000"
                                       placeholder="напр. 60">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Пиковая, °C</label>
                                <input type="number" name="immersionExposure[peak_max]"
                                       value="{{ immersion.peak_max }}"
                                       class="form-control" min="-200" max="1000"
                                       placeholder="опционально">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Длительность пика, мин</label>
                                <input type="number" name="immersionExposure[peak_duration_minutes]"
                                       value="{{ immersion.peak_duration_minutes }}"
                                       class="form-control" min="1" max="1440"
                                       placeholder="по умолчанию 60">
                            </div>
                        </div>
                        <div class="form-text">Оставьте пустым, если материал не рассчитан на погружение.</div>
                    </div>
            </div>

            {# 7. Время отверждения — общая группа температурно-зависимых параметров.
                  Каждая подсекция (dryToTouch / fullCure / recoatingInterval) редактируется
                  по одному и тому же принципу: таблица точек «температура → длительность»
                  + кнопка «Добавить точку» + модалка редактирования. Внешняя тертиарная
                  карточка группирует всё, каждая подсекция — белая карточка (bg-body).
                  Внутри белой карточки строки таблицы (table-rows) сливались бы с фоном —
                  поэтому переопределяем --table-rows-cell-bg на тертиарный, чтобы список
                  точек визуально выделялся серым внутри белой обёртки. Использовать
                  --bs-table-bg нельзя: Bootstrap перезаписывает её на .table и наш
                  override с родителя не доходит до ячеек. #}
            <div id="sec-cure" class="p-3 mb-3 rounded-3 bg-body-tertiary fsec" data-form-scrollspy-target="section">
                <h6 class="fw-semibold mb-3">Время отверждения</h6>

                {# ─── Сухой на отлип — белая подсекция ─── #}
                <div class="p-3 mb-3 rounded-3 bg-body" style="--table-rows-cell-bg: var(--bs-tertiary-bg);">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-semibold mb-0">Сухой на отлип</h6>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-series="dryToTouch"
                                data-action="click->coating-form#addRow">Добавить точку</button>
                    </div>
                    <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 table-rows">
                        <thead>
                            <tr>
                                <th class="text-muted fw-normal" style="width: 160px;">Температура</th>
                                <th class="text-muted fw-normal">Время</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody data-series="dryToTouch">
                            {% for i, row in inputData.dryToTouch ?? [{temperature_at: 20, days: 0, hours: 0, minutes: 0}] %}
                                <tr>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="dryToTouch[{{ i }}][temperature_at]"
                                                   value="{{ row.temperature_at ?? 20 }}"
                                                   class="form-control"
                                                   min="-50" max="100" required>
                                            <span class="input-group-text">°C</span>
                                        </div>
                                    </td>
                                    {% set tempAt = row.temperature_at ?? 20 %}
                                    <td>{{ duration_input('dryToTouch[' ~ i ~ ']', row, true, 'Сухой на отлип при ' ~ (tempAt > 0 ? '+' ~ tempAt : tempAt) ~ ' °C', false) }}</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-action="click->coating-form#removeRow"
                                                title="Удалить точку">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                </div>

                {# ─── Полное отверждение — белая подсекция ─── #}
                <div class="p-3 mb-3 rounded-3 bg-body" style="--table-rows-cell-bg: var(--bs-tertiary-bg);">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-semibold mb-0">Полное отверждение</h6>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                data-series="fullCure"
                                data-action="click->coating-form#addRow">Добавить точку</button>
                    </div>
                    <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 table-rows">
                        <thead>
                            <tr>
                                <th class="text-muted fw-normal" style="width: 160px;">Температура</th>
                                <th class="text-muted fw-normal">Время</th>
                                <th style="width: 60px;"></th>
                            </tr>
                        </thead>
                        <tbody data-series="fullCure">
                            {% for i, row in inputData.fullCure ?? [{temperature_at: 20, days: 0, hours: 0, minutes: 0}] %}
                                <tr>
                                    <td>
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="fullCure[{{ i }}][temperature_at]"
                                                   value="{{ row.temperature_at ?? 20 }}"
                                                   class="form-control"
                                                   min="-50" max="100" required>
                                            <span class="input-group-text">°C</span>
                                        </div>
                                    </td>
                                    {% set tempAt = row.temperature_at ?? 20 %}
                                    <td>{{ duration_input('fullCure[' ~ i ~ ']', row, true, 'Полное отверждение при ' ~ (tempAt > 0 ? '+' ~ tempAt : tempAt) ~ ' °C', false) }}</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                data-action="click->coating-form#removeRow"
                                                title="Удалить точку">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                </div>

                {# ─── Интервал перекрытия (дерево: общее → среда → основа ЛКМ) ─── #}
                {% set envLabels = {
                    atmospheric: 'Атмосферная',
                    immersion:   'Погружение',
                    special:     'Спец среды',
                } %}
                {% set defaultRecoatingNode = {default: {points: [{temperature_at: 20, days: 0, hours: 0, minutes: 0}]}, branches: {}} %}
                {% set minRecoatingNode = inputData.minRecoatingInterval ?? defaultRecoatingNode %}
                {% set maxRecoatingNode = inputData.maxRecoatingInterval ?? {default: {points: []}, branches: {}} %}
                {% set usedEnvKeys = (minRecoatingNode.branches ?? {})|keys %}
                {% set availableEnvKeys = ['atmospheric', 'immersion', 'special'] %}
                {# baseLabels: {key_lower => "Русское название (ISO)"} — для отображения; ключи остаются ASCII. #}
                {% set baseLabels = {} %}
                {% for b in coatingBases %}
                    {% set baseLabels = baseLabels|merge({(b.value|lower): b.title ~ ' (' ~ b.value ~ ')'}) %}
                {% endfor %}

                {# ─── Интервал перекрытия — белая подсекция ─── #}
                <div class="p-3 rounded-3 bg-body" style="--table-rows-cell-bg: var(--bs-tertiary-bg);">
                    <h6 class="fw-semibold mb-3">Интервал перекрытия</h6>
                    {% include 'admin/coating/coating/_recoating_node.html.twig' with {
                        minNode: minRecoatingNode,
                        maxNode: maxRecoatingNode,
                        level: 'root',
                        path: [],
                        envLabels: envLabels,
                        availableEnvKeys: availableEnvKeys,
                        baseLabels: baseLabels,
                    } only %}
                </div>
            </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            </form>

        {# ─── Общая модалка редактирования длительности (вне <form>, см. комментарий выше).
              Вариант «живой итог»: крупный результат сверху (пересчитывается при вводе),
              сегмент режима, компактные −значение+ пилюли. Логика — контроллер coating-form. ─── #}
        <div class="modal fade" tabindex="-1" id="durationModal" aria-hidden="true"
             aria-labelledby="durationModalLabel" data-coating-form-target="modal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content duration-modal">
                    <div class="modal-body">
                        <div class="dur-hd">
                            <div class="dur-kicker" id="durationModalLabel" data-coating-form-target="modalLabel">Значение</div>
                            <button type="button" class="dur-x" data-bs-dismiss="modal" aria-label="Закрыть">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <div class="dur-live">
                            <div class="dur-live-big" data-coating-form-target="liveTotal">0 мин</div>
                            <div class="dur-live-cap" data-coating-form-target="liveCap">длительность</div>
                        </div>
                        {# Сегмент режима поверх btn-check (сокращённые лейблы на <sm — iPhone SE 375px). #}
                        <div class="duration-seg mb-3" data-coating-form-target="kindGroup" aria-label="Тип значения">
                            <input type="radio" class="btn-check" name="durationModalKind" id="durationModalKind-duration"
                                   value="duration" data-coating-form-target="kindRadio"
                                   data-action="change->coating-form#onKindChange">
                            <label class="duration-seg-btn" for="durationModalKind-duration">Значение</label>

                            <input type="radio" class="btn-check" name="durationModalKind" id="durationModalKind-unlimited"
                                   value="unlimited" data-coating-form-target="kindRadio"
                                   data-action="change->coating-form#onKindChange">
                            <label class="duration-seg-btn" for="durationModalKind-unlimited"
                                   data-coating-form-target="kindUnlimitedLabel" title="Без ограничения">
                                <span class="d-sm-none">Без огр.</span>
                                <span class="d-none d-sm-inline">Без ограничения</span>
                            </label>

                            <input type="radio" class="btn-check" name="durationModalKind" id="durationModalKind-unknown"
                                   value="unknown" data-coating-form-target="kindRadio"
                                   data-action="change->coating-form#onKindChange">
                            <label class="duration-seg-btn" for="durationModalKind-unknown"
                                   data-coating-form-target="kindUnknownLabel">Нет данных</label>
                        </div>

                        <div class="dur-pills" data-coating-form-target="durationFields">
                            <div class="dur-pill">
                                <button type="button" class="dur-pbtn" aria-label="минус"
                                        data-action="click->coating-form#step"
                                        data-coating-form-field-param="days" data-coating-form-delta-param="-1">−</button>
                                <div class="dur-pill-mid">
                                    <input type="number" class="dur-pval" min="0" max="365" value="0" inputmode="numeric"
                                           data-coating-form-target="modalDays"
                                           data-action="input->coating-form#onDurationInput">
                                    <span class="dur-plabel">дн.</span>
                                </div>
                                <button type="button" class="dur-pbtn" aria-label="плюс"
                                        data-action="click->coating-form#step"
                                        data-coating-form-field-param="days" data-coating-form-delta-param="1">+</button>
                            </div>
                            <div class="dur-pill">
                                <button type="button" class="dur-pbtn" aria-label="минус"
                                        data-action="click->coating-form#step"
                                        data-coating-form-field-param="hours" data-coating-form-delta-param="-1">−</button>
                                <div class="dur-pill-mid">
                                    <input type="number" class="dur-pval" min="0" max="23" value="0" inputmode="numeric"
                                           data-coating-form-target="modalHours"
                                           data-action="input->coating-form#onDurationInput">
                                    <span class="dur-plabel">ч.</span>
                                </div>
                                <button type="button" class="dur-pbtn" aria-label="плюс"
                                        data-action="click->coating-form#step"
                                        data-coating-form-field-param="hours" data-coating-form-delta-param="1">+</button>
                            </div>
                            <div class="dur-pill">
                                <button type="button" class="dur-pbtn" aria-label="минус"
                                        data-action="click->coating-form#step"
                                        data-coating-form-field-param="minutes" data-coating-form-delta-param="-1">−</button>
                                <div class="dur-pill-mid">
                                    <input type="number" class="dur-pval" min="0" max="59" value="0" inputmode="numeric"
                                           data-coating-form-target="modalMinutes"
                                           data-action="input->coating-form#onDurationInput">
                                    <span class="dur-plabel">мин</span>
                                </div>
                                <button type="button" class="dur-pbtn" aria-label="плюс"
                                        data-action="click->coating-form#step"
                                        data-coating-form-field-param="minutes" data-coating-form-delta-param="1">+</button>
                            </div>
                        </div>

                        <button type="button" class="btn btn-primary w-100 mt-3"
                                data-action="click->coating-form#saveDuration">Применить</button>
                        <div class="d-flex justify-content-center gap-3 mt-2">
                            <button type="button" class="btn btn-link btn-sm text-muted text-decoration-none px-1"
                                    data-action="click->coating-form#clearDuration">Очистить</button>
                            <button type="button" class="btn btn-link btn-sm text-decoration-none px-1"
                                    data-action="click->coating-form#calculateDuration"
                                    data-coating-form-target="calcBtn"
                                    title="Рассчитать по соседним точкам" disabled>Рассчитать</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
            {% include 'components/color_create_modal.html.twig' %}
        </div>
        {% endblock %}
    {% endembed %}
{% endblock %}
