{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Сравнение покрытий{% endblock %}

{# Шапка столбца покрытия: мини-монограм связующего + имя/производитель + крестик
   «убрать из сравнения» (compare-remove читает id, чистит URL/localStorage и
   редиректит на compare?ids=… или /list, если осталось < 2). #}
{% macro col_head(subject) %}
    <div class="cmp-colhead-inner">
        <div class="ecard-mono ecard-mono--sm"><span class="lbl">{{ subject.base ?? '—' }}</span></div>
        <div class="nm">
            <div class="t">{{ subject.title }}</div>
            <div class="m">{{ subject.manufacturer.title }}</div>
        </div>
        <button type="button"
                class="btn-close btn-close-sm"
                data-controller="compare-remove"
                data-compare-remove-id-value="{{ subject.id }}"
                data-compare-remove-list-url-value="{{ path('app_cabinet_coating_coating_list') }}"
                data-action="click->compare-remove#remove"
                title="Убрать «{{ subject.title }}» из сравнения"
                aria-label="Убрать из сравнения"></button>
    </div>
{% endmacro %}

{# Per-field форматтер скалярных полей. #}
{% macro format_value(field, value) %}
    {% if value is null %}<span class="muted">—</span>{% else %}{{ value }}{% endif %}
{% endmacro %}

{% block content %}
    {% set fieldLabels = {
        'title':                  'Название',
        'manufacturer.title':     'Производитель',
        'base':                   'Тип ЛКМ (ISO)',
        'volumeSolid':            'Сухой остаток, %',
        'massDensity':            'Плотность, кг/л',
        'pack':                   'Упаковка, л',
        'thinner':                'Разбавитель',
        'applicationMinTemp':     'Мин Т нанесения, °C',
        'dryingMaxTemp':          'Макс Т сушки, °C',
        'dftRange.min':           'Мин ТСП, мкм',
        'dftRange.max':           'Макс ТСП, мкм',
        'dftRange.tds_dft':       'Целевая ТСП, мкм',
    } %}

    <div class="p-2 p-md-3" data-controller="compare-filter">
        <div class="d-flex justify-content-between align-items-center mb-3 p-3 rounded-3 bg-body-tertiary">
            <h1 class="h3 mb-0">Сравнение покрытий ({{ subjects|length }})</h1>
            <a href="{{ path('app_cabinet_coating_coating_list') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i> К списку
            </a>
        </div>

        <div class="row g-3">
            {# Панель: тумблер «только различия» + чекбоксы видимых полей.
               На <lg уходит ПОД таблицу (order-2), чтобы сразу видеть сравнение. #}
            <aside class="col-lg-3 order-2 order-lg-1">
                <div class="p-3 rounded-3 bg-body-tertiary">
                    <label class="form-check form-switch d-flex align-items-center gap-2 mb-3">
                        <input type="checkbox" class="form-check-input m-0" role="switch"
                               data-compare-filter-target="onlyDiff">
                        <span class="small fw-semibold">Только различия</span>
                    </label>
                    <h6 class="fw-semibold mb-2">Видимые поля</h6>
                    <div class="d-flex flex-column gap-2">
                        {% for field in fields %}
                            <label class="form-check d-flex align-items-center gap-2 mb-0">
                                <input type="checkbox" class="form-check-input m-0"
                                       data-compare-filter-target="checkbox"
                                       data-field="{{ field }}" checked>
                                <span class="small">{{ fieldLabels[field] ?? field }}</span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            </aside>

            <main class="col-lg-9 order-1 order-lg-2">
                <div class="p-3 rounded-3 bg-body-tertiary">
                    <div class="cmp-wrap">
                        <table class="cmp-table">
                            <thead>
                                <tr>
                                    <th class="cmp-field">Поле</th>
                                    {% for subject in subjects %}
                                        <th class="cmp-colhead">{{ _self.col_head(subject) }}</th>
                                    {% endfor %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in comparison.rows %}
                                    <tr data-compare-filter-target="row" data-field="{{ row.field }}"
                                        data-diff="{{ row.isDifferent ? '1' : '0' }}"
                                        class="{{ row.isDifferent ? 'cmp-row--diff' : '' }}">
                                        <th scope="row" class="cmp-field">{{ fieldLabels[row.field] ?? row.field }}</th>
                                        {% for value in row.values %}
                                            <td class="cmp-val">{{ _self.format_value(row.field, value) }}</td>
                                        {% endfor %}
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                {# ==== Время высыхания — per-interval сравнение. Одна матрица на интервал
                       (env → base ветки). Строки = покрытия, столбцы = union температур;
                       различающиеся между покрытиями столбцы подсвечены diff-токенами.
                       Разметка матрицы переиспользует .pv-drying/.pv-matrix из превью. ==== #}
                <h2 class="h4 mt-4 mb-3">Время высыхания</h2>
                {% set compareMatrix = coating_compare_matrix(subjects) %}
                {% for section in compareMatrix %}
                    <div class="pv-drying mb-3">
                        <div class="pv-group-title">{{ section.label }}</div>
                        <div class="pv-matrix-wrap">
                            <table class="pv-matrix">
                                <thead>
                                    <tr>
                                        <th class="stage-label">Покрытие</th>
                                        {% for t in section.columns %}
                                            <th class="text-center text-nowrap {% if section.diffColumns[t] is defined %}cmp-mx-diff{% endif %}">
                                                {{ t > 0 ? '+' ~ t : t }} °C
                                            </th>
                                        {% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in section.rows %}
                                        <tr>
                                            <th scope="row" class="stage-label fw-normal">{{ row.subject.title }}</th>
                                            {% for t in section.columns %}
                                                {% set cell = row.values[t] %}
                                                <td class="text-center text-nowrap
                                                    {% if section.diffColumns[t] is defined %}cmp-mx-diff{% endif %}
                                                    {% if cell.is_calculated %}calc{% endif %}">
                                                    {% if cell.minutes is null %}
                                                        <span class="text-body-secondary">—</span>
                                                    {% elseif cell.minutes == 0 %}
                                                        <i class="bi bi-infinity" title="без ограничения"></i>
                                                    {% else %}
                                                        {{ cell.minutes|duration_minutes_short }}
                                                    {% endif %}
                                                </td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% else %}
                    <p class="text-body-secondary">Нет данных по времени высыхания у сравниваемых покрытий.</p>
                {% endfor %}
                <p class="text-body-secondary small">
                    Выделены столбцы, где значения различаются между покрытиями.
                    Курсив — рассчитано интерполяцией. «—» — вне диапазона / нет данных.
                </p>
            </main>
        </div>
    </div>
{% endblock %}
