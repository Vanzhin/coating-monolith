{% extends '/cabinet/index.html.twig' %}

{% block title %}{{ parent() }} | Документы{% endblock %}

{% block content %}
    {# canEdit приходит из ListAction (единый источник — контроллер). #}
    {% set idPlaceholder = '00000000-0000-0000-0000-000000000000' %}
    {% set listRoute = 'app_cabinet_certificate_document_list' %}

    {# Активность фасетов #}
    {% set kindActive = kind != '' %}
    {% set issuerActive = issuerId != '' %}
    {% set statusActive = status != '' %}
    {% set testStandardActive = testStandard != '' %}

    <div data-controller="entity-preview"
         data-entity-preview-endpoint-value="{{ path('app_cabinet_certificate_document_preview', {id: idPlaceholder}) }}">

    {% embed 'components/list_page.html.twig' with {
        title: 'Документы',
        create_route: 'app_cabinet_certificate_document_create',
        can_edit: canEdit,
        is_empty: documents is empty,
    } %}
    {% block above_list %}
        {% set defaultSort = constant('App\\Certificates\\Domain\\Repository\\DocumentSort::DEFAULT') %}
        {% embed 'components/entity_search.html.twig' with {
            list_route: listRoute,
            form_id: 'documentListForm',
            search_name: 'q',
            search_value: q,
            search_placeholder: 'По номеру / теме / описанию (от 3 символов)',
            sort_options: sortOptions|map(o => {value: o.value, label: o.title()}),
            sort_current: sort.value,
            sort_default: defaultSort.value,
            active_count: activeFacetsCount,
            drawer_id: 'allDocsFiltersOffcanvas',
            drawer_form_id: 'allDocsFiltersForm',
        } %}
            {% block chips %}
                {# --- Вид (single) --- #}
                {% if kindActive %}
                    {% set removeUrl = path(listRoute, app.request.query.all|merge({kind: null, page: null})|filter(v => v is not null)) %}
                    <a href="{{ removeUrl }}" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" title="Убрать фильтр вида">
                        {% for k in kinds|filter(k => k.value == kind) %}{{ k.label }}{% endfor %} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="kind">Вид</button>
                {% endif %}

                {# --- Статус срока (single) --- #}
                {% if statusActive %}
                    {% set removeUrl = path(listRoute, app.request.query.all|merge({status: null, page: null})|filter(v => v is not null)) %}
                    <a href="{{ removeUrl }}" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" title="Убрать фильтр статуса">
                        {% for s in statusOptions|filter(s => s.value == status) %}{{ s.label }}{% endfor %} <i class="bi bi-x-lg"></i>
                    </a>
                {% else %}
                    <button type="button" class="btn btn-sm btn-outline-secondary"
                            data-action="click->facet-jump#jump" data-facet-jump-facet-param="status">Статус</button>
                {% endif %}

                {# --- Организация: выбор в шторке; здесь активный чип --- #}
                {% if issuerActive %}
                    {% set removeUrl = path(listRoute, app.request.query.all|merge({issuerId: null, page: null})|filter(v => v is not null)) %}
                    <a href="{{ removeUrl }}" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" title="Убрать фильтр организации">
                        {% for i in issuers|filter(i => i.id == issuerId) %}{{ i.title }}{% endfor %} <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}

                {# --- Стандарт испытания: выбор в шторке; здесь активный чип --- #}
                {% if testStandardActive %}
                    {% set removeUrl = path(listRoute, app.request.query.all|merge({testStandard: null, page: null})|filter(v => v is not null)) %}
                    <a href="{{ removeUrl }}" class="btn btn-sm btn-primary d-inline-flex align-items-center gap-1" title="Убрать фильтр стандарта">
                        {{ testStandard }} <i class="bi bi-x-lg"></i>
                    </a>
                {% endif %}
            {% endblock %}

            {% block drawer_hidden %}
                {% if sort != defaultSort %}<input type="hidden" name="sort" value="{{ sort.value }}">{% endif %}
            {% endblock %}

            {% block drawer %}
                {# Вид (пилюли-радио) #}
                <div id="facet-kind" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                    <h6 class="fw-semibold mb-2">Вид</h6>
                    <div class="d-flex flex-wrap gap-1">
                        <label class="facet-pill facet-pill--muted">
                            <input type="radio" name="kind" value="" {% if not kindActive %}checked{% endif %}>Любой
                        </label>
                        {% for k in kinds %}
                            <label class="facet-pill">
                                <input type="radio" name="kind" value="{{ k.value }}" {% if kind == k.value %}checked{% endif %}>{{ k.label }}
                            </label>
                        {% endfor %}
                    </div>
                </div>

                {# Статус срока (пилюли-радио) #}
                <div id="facet-status" class="facet-block p-3 mb-2 rounded-3 bg-body-tertiary">
                    <h6 class="fw-semibold mb-2">Статус срока</h6>
                    <div class="d-flex flex-wrap gap-1">
                        <label class="facet-pill facet-pill--muted">
                            <input type="radio" name="status" value="" {% if not statusActive %}checked{% endif %}>Любой
                        </label>
                        {% for s in statusOptions %}
                            <label class="facet-pill">
                                <input type="radio" name="status" value="{{ s.value }}" {% if status == s.value %}checked{% endif %}>{{ s.label }}
                            </label>
                        {% endfor %}
                    </div>
                </div>

                {# Организация #}
                <div class="p-3 mb-2 rounded-3 bg-body-tertiary">
                    <h6 class="fw-semibold mb-2">Организация</h6>
                    <select name="issuerId" class="form-select">
                        <option value="">Все организации</option>
                        {% for i in issuers %}
                            <option value="{{ i.id }}" {{ issuerId == i.id ? 'selected' : '' }}>{{ i.title }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Стандарт испытания #}
                <div class="p-3 mb-2 rounded-3 bg-body-tertiary">
                    <h6 class="fw-semibold mb-2">Стандарт испытания</h6>
                    <select name="testStandard" class="form-select">
                        <option value="">Любой</option>
                        {% for ts in testStandards %}
                            <option value="{{ ts }}" {{ testStandard == ts ? 'selected' : '' }}>{{ ts }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Покрытие: документы, привязанные к выбранным покрытиям (id в URL, имена — by-ids) #}
                <div class="p-3 mb-2 rounded-3 bg-body-tertiary" data-coating-tags-group>
                    <h6 class="fw-semibold mb-2">Покрытие</h6>
                    <input type="text"
                           data-controller="coating-tags"
                           data-coating-tags-existing-value="[]"
                           data-coating-tags-suggest-url-value="{{ path('app_cabinet_coating_coating_suggest') }}"
                           data-coating-tags-create-url-value=""
                           data-coating-tags-hidden-input-name-value="coatingIds[]"
                           data-coating-tags-allow-create-value="false"
                           data-coating-tags-preselected-ids-value="{{ coatingIds|json_encode }}"
                           data-coating-tags-resolve-url-value="{{ path('app_cabinet_coating_coating_by_ids') }}"
                           class="form-control form-control-sm"
                           placeholder="Начните вводить покрытие...">
                </div>
            {% endblock %}
        {% endembed %}
    {% endblock %}

    {% block list_content %}
        <div class="d-inline-block p-2 px-3 mb-3 rounded-3 bg-body-tertiary small">
            Найдено: <strong>{{ total }}</strong>
        </div>

        {% set totalPages = (total / perPage)|round(0, 'ceil') %}
        {% set baseQuery = app.request.query.all|filter((v, k) => v is not null and k != 'page' and k != 'partial') %}

        {% include 'components/infinite_list.html.twig' with {
            items_template: 'admin/certificate/document/_list_cards.html.twig',
            items_params: {documents: documents, canEdit: canEdit},
            total_pages: totalPages,
            base_url: path(listRoute, baseQuery),
            wrapper_class: 'ecard-grid',
        } only %}

        <noscript>
            {% include 'components/pager.html.twig' with {pager: {total_items: total, page: page, perPage: perPage}} %}
        </noscript>

        {% if canEdit %}
            {% include 'components/delete_modal.html.twig' with {'delete': 'app_cabinet_certificate_document_delete'} %}
        {% endif %}
    {% endblock %}

    {% block empty_state %}
        <div class="p-4 mt-3 rounded-3 bg-body-tertiary text-center" role="status">
            <i class="bi bi-file-earmark-text fs-1 d-block mb-2 text-body-secondary"></i>
            <h5 class="fw-semibold mb-2">Документы не найдены</h5>
            {% if q or kindActive or issuerActive or statusActive or testStandardActive or coatingIds|length > 0 %}
                <p class="text-body-secondary mb-0">По запросу с заданными фильтрами совпадений нет. Измените параметры поиска.</p>
            {% endif %}
        </div>
    {% endblock %}
    {% endembed %}

    </div>{# /data-controller="entity-preview" #}
{% endblock %}
