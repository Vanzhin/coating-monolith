{# Батч карточек документов (единая entity-карточка). Используется index.html.twig
   (первая страница) и ListAction в режиме ?partial=1 (догрузка ленты).

   Обязательные переменные:
     documents — list<DocumentDTO>
     canEdit   — bool

   Контракты (не ломать): data-document-id на карточке; превью — click->entity-preview#open
   + data-entity-id; скачивание — app_cabinet_certificate_document_download. Тегов у DTO нет. #}
{% set canEdit = canEdit|default(false) %}

{% for doc in documents %}
    {% set isValid = doc.expiresAt is null or not doc.isExpired %}
    <div class="ecard" data-document-id="{{ doc.id }}">
        <div class="ecard-media{{ isValid ? ' is-ok' : '' }}" role="button"
             data-action="click->entity-preview#open" data-entity-id="{{ doc.id }}">
            <i class="bi bi-file-earmark-text"></i>
        </div>

        <div class="ecard-body">
            <div class="ecard-head">
                <div class="ecard-title" role="button"
                     data-action="click->entity-preview#open" data-entity-id="{{ doc.id }}">{{ doc.title }}</div>
                {% if canEdit or doc.hasFile %}
                    <div class="ecard-kebab dropdown" data-controller="dropdown-portal">
                        <button class="btn btn-sm btn-link text-body-secondary p-1" type="button"
                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Действия">
                            <i class="bi bi-three-dots-vertical"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            {% if doc.hasFile %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_cabinet_certificate_document_download', {id: doc.id}) }}">
                                        <i class="bi bi-file-earmark-arrow-down me-2"></i>Скачать PDF
                                    </a>
                                </li>
                            {% endif %}
                            {% if canEdit %}
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_cabinet_certificate_document_update', {id: doc.id}) }}">
                                        <i class="bi bi-pencil me-2"></i>Редактировать
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger"
                                       href="{{ path('app_cabinet_certificate_document_delete', {id: doc.id}) }}"
                                       data-bs-toggle="modal" data-bs-target="#deleteModal"
                                       data-bs-title="{{ doc.title }}" data-bs-id="{{ doc.id }}">
                                        <i class="bi bi-trash3 me-2"></i>Удалить
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                {% endif %}
            </div>

            {% if doc.subject %}
                <div class="ecard-desc" role="button"
                     data-action="click->entity-preview#open" data-entity-id="{{ doc.id }}">{{ doc.subject }}</div>
            {% endif %}

            <div class="ecard-meta">
                {{ doc.issuerTitle ?? '—' }} · {{ doc.issuedAt|date('d.m.Y') }}
                {%- if doc.testStandard %} · {{ doc.testStandard }}{% endif %}
            </div>

            <div class="ecard-badges">
                {% if doc.expiresAt is null %}
                    <span class="b-iso">Бессрочный</span>
                {% elseif doc.isExpired %}
                    <span class="b-ok" style="color: var(--danger-strong); background: var(--danger-subtle);">Просрочен · {{ doc.expiresAt|date('m.Y') }}</span>
                {% else %}
                    <span class="b-ok">Действует до {{ doc.expiresAt|date('m.Y') }}</span>
                {% endif %}
                <span class="b-iso">{{ doc.kindLabel }}</span>
            </div>
        </div>
    </div>
{% endfor %}
