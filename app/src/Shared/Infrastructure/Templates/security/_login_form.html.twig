{# Форма входа по паролю. Переиспользуется на /login и на лендинге (в свап-панели).
   Поля/роут/CSRF не менять — на них завязан security-guard. Переменные (обе опц.):
     error         — AuthenticationException|null (показываем сообщение)
     last_username — предзаполнение email
   Альт-ссылки (регистрация / вход по ссылке) живут в вызывающем шаблоне: на /login — это
   переходы, на лендинге — переключатели свап-панели. autofocus не ставим: на лендинге
   форма — одна из трёх в DOM. #}
<form method="post" action="{{ path('app_login') }}">
    {% if error is defined and error %}
        <div class="auth-alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    <div class="auth-field">
        <input type="email" name="email" id="inputEmail" value="{{ last_username|default('') }}"
               autocomplete="email" required placeholder="you@example.com">
        <label for="inputEmail">Email</label>
    </div>
    <div class="auth-field">
        <input type="password" name="password" id="inputPassword"
               autocomplete="current-password" required placeholder="Пароль">
        <label for="inputPassword">Пароль</label>
    </div>

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    {# Куда вернуть после входа — исходная страница, если пришли по ссылке «Войти» с _target_path. #}
    <input type="hidden" name="_target_path" value="{{ app.request.query.get('_target_path') }}">

    <button class="auth-btn auth-btn-primary" type="submit">
        <i class="bi bi-box-arrow-in-right"></i> Войти
    </button>
</form>
