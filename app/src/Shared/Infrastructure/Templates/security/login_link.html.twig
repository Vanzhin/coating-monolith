{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} · Вход по ссылке{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class="authshell">
        <div class="auth-wrap">
            <a href="{{ path('app_login') }}" class="auth-back" aria-label="Ко входу с паролем"><i class="bi bi-arrow-left"></i></a>

            {% if app.user %}
                <div class="auth-alert ok">
                    Вы вошли как <strong>{{ app.user.userIdentifier }}</strong>. <a href="{{ path('app_logout') }}">Выйти</a>
                </div>
            {% else %}
                <div class="auth-logo-mark md auth-logo-center">{{ app_name|first }}</div>

                <div class="auth-card">
                    <h1 class="auth-h">Вход по ссылке</h1>
                    <p class="auth-s">Введите email — пришлём ссылку для одноразового входа. Пароль не нужен.</p>

                    {% if error is defined and error %}
                        <div class="auth-alert">{{ error }}</div>
                    {% endif %}

                    <form method="post" action="{{ path('app_login_link') }}">
                        <div class="auth-field">
                            <input type="email" name="email" id="inputEmail" value="{{ email }}"
                                   autocomplete="email" required autofocus placeholder="you@example.com">
                            <label for="inputEmail">Email</label>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('login_link') }}">

                        <button class="auth-btn auth-btn-primary" type="submit">
                            <i class="bi bi-send"></i> Отправить ссылку
                        </button>
                    </form>

                    <div class="auth-mini"><a href="{{ path('app_login') }}">Вернуться ко входу с паролем</a></div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
