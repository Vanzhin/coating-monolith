{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} · Подтверждение входа{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class="authshell">
        <div class="auth-wrap">
            {% if app.user %}
                <div class="auth-alert ok">
                    Вы уже вошли как <strong>{{ app.user.userIdentifier }}</strong>. <a href="{{ path('app_logout') }}" data-controller="logout" data-action="click->logout#run">Выйти</a>
                </div>
            {% endif %}

            <a href="{{ path('app_homepage') }}" class="auth-logo-mark md auth-logo-center" title="На главную">{{ app_name|first }}</a>

            <div class="auth-card auth-sent">
                <div class="ok-ic"><i class="bi bi-shield-check"></i></div>
                <h1 class="auth-h">Подтверждение входа</h1>
                <p class="auth-s">Нажмите кнопку, чтобы завершить вход по ссылке.</p>

                <form method="POST" action="{{ path('app_login_check') }}">
                    <input type="hidden" name="expires" value="{{ expires }}">
                    <input type="hidden" name="user" value="{{ user }}">
                    <input type="hidden" name="hash" value="{{ hash }}">
                    <button class="auth-btn auth-btn-primary" type="submit">
                        <i class="bi bi-box-arrow-in-right"></i> Войти
                    </button>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
