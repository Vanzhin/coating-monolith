{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} · Вход{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class="authshell">
        <div class="auth-wrap">
            <a href="{{ path('app_homepage') }}" class="auth-back" aria-label="На главную"><i class="bi bi-arrow-left"></i></a>

            {% if app.user %}
                <div class="auth-alert ok">
                    Вы вошли как <strong>{{ app.user.userIdentifier }}</strong>. <a href="{{ path('app_logout') }}">Выйти</a>
                </div>
            {% endif %}

            <a href="{{ path('app_homepage') }}" class="auth-logo-mark md auth-logo-center" title="На главную">{{ app_name|first }}</a>

            <div class="auth-card">
                <h1 class="auth-h">Вход</h1>
                <p class="auth-s">Введите email и пароль от аккаунта.</p>
                {% include 'security/_login_form.html.twig' %}

                <div class="auth-alt">Нет аккаунта? <a href="{{ path('app_sign_up') }}">Зарегистрироваться</a></div>
                <div class="auth-mini"><a href="{{ path('app_login_link') }}">Вход по ссылке без пароля</a></div>
            </div>
        </div>
    </div>
{% endblock %}
