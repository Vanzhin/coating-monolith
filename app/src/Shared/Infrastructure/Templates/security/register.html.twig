{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} · Регистрация{% endblock %}

{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block body %}
    <div class="authshell">
        <div class="auth-wrap">
            <a href="{{ path('app_login') }}" class="auth-back" aria-label="Ко входу"><i class="bi bi-arrow-left"></i></a>

            {% if app.user %}
                <div class="auth-alert ok">
                    Вы вошли как <strong>{{ app.user.userIdentifier }}</strong>. <a href="{{ path('app_logout') }}">Выйти</a>
                </div>
            {% endif %}

            <div class="auth-logo-mark md auth-logo-center">{{ app_name|first }}</div>

            <div class="auth-card">
                <h1 class="auth-h">Регистрация</h1>
                <p class="auth-s">Создайте аккаунт по email и паролю.</p>

                {% for message in app.flashes('register_failure') %}
                    <div class="auth-alert">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('register_success') %}
                    <div class="auth-alert ok">{{ message }}</div>
                {% endfor %}

                {# Symfony Form: name="registration_form[...]" + свой CSRF. Стиль — свой,
                   поэтому inputs пишем руками, беря name/id/value/errors из FormView. #}
                <form method="post" action="{{ path('app_sign_up') }}">
                    <div class="auth-field">
                        <input type="email"
                               id="{{ registrationForm.email.vars.id }}"
                               name="{{ registrationForm.email.vars.full_name }}"
                               value="{{ registrationForm.email.vars.value }}"
                               class="{% if not registrationForm.email.vars.valid %}is-invalid{% endif %}"
                               autocomplete="email" required autofocus placeholder="you@example.com">
                        <label for="{{ registrationForm.email.vars.id }}">Email</label>
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="auth-field">
                        <input type="password"
                               id="{{ registrationForm.plainPassword.vars.id }}"
                               name="{{ registrationForm.plainPassword.vars.full_name }}"
                               class="{% if not registrationForm.plainPassword.vars.valid %}is-invalid{% endif %}"
                               autocomplete="new-password" required placeholder="Пароль">
                        <label for="{{ registrationForm.plainPassword.vars.id }}">Пароль</label>
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    {{ form_widget(registrationForm._token) }}

                    <button class="auth-btn auth-btn-primary" type="submit">
                        <i class="bi bi-person-plus"></i> Зарегистрироваться
                    </button>
                </form>

                <div class="auth-alt">Уже есть аккаунт? <a href="{{ path('app_login') }}">Войти</a></div>
            </div>
        </div>
    </div>
{% endblock %}
