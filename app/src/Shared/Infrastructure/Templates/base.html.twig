<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ app_name }} — инструменты, которые помогают в повседневной работе">
    {# Кросс-документные native-переходы (View Transitions API); включение — в app-shell.css. #}
    <meta name="view-transition" content="same-origin">

    {# PWA: цвет системной панели по теме, iOS-standalone. Манифест — ниже в head. #}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="1helper">

    <title>{% block title %}{{ app_name }} | {% endblock %}</title>

    {# FOUC-safe theme init — ставим data-bs-theme на <html> ДО того как браузер
       начнёт применять Bootstrap CSS, чтобы не «моргнуть» светлой темой при
       загрузке. Bootstrap 5.3+ читает атрибут и применяет соответствующие
       CSS-переменные (--bs-body-bg / --bs-body-color / border-color / etc). #}
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('theme');
                var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) { /* localStorage может быть заблокирован — оставляем дефолт */ }
        })();
    </script>

    {# Favicon и манифест #}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('icons/apple-touch-icon.png') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('icons/favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('icons/favicon-16x16.png') }}">
    <link rel="icon" href="{{ asset('icons/favicon.ico') }}" sizes="16x16 32x32"/>
    <link rel="manifest" href="{{ asset('icons/site.webmanifest') }}">

    {# Bootstrap Icons бандлятся локально через assets/styles/bootstrap-icons.css
       (импортируется из app.css). CDN-линк убран — он грузил иконки повторно
       поверх локального бандла. #}

    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
</head>
{# data-controller="back-to-top" — кнопка «Наверх». has-app-shell (для авторизованных)
   включает app-shell: десктоп-сайдбар, нижнюю таб-панель и отступы под них. #}
<body data-controller="back-to-top"{% if app.user %} class="has-app-shell"{% endif %}>

{# Пункты основной навигации — единый источник для сайдбара и таб-панели.
   Задаём в base: included-партиалы наследуют контекст родителя, но свои `set`
   наружу НЕ экспортируют, поэтому переменная должна жить здесь. #}
{% set current_route = app.request.attributes.get('_route') %}
{% set nav_items = [
    { key: 'coatings',  label: 'Покрытия',  icon: 'bi-grid',
      route: 'app_cabinet_coating_coating_list', prefix: 'app_cabinet_coating_coating' },
    { key: 'systems',   label: 'Системы',   icon: 'bi-layers',
      route: 'app_cabinet_coating_system_list',  prefix: 'app_cabinet_coating_system' },
    { key: 'documents', label: 'Документы', icon: 'bi-file-earmark-text',
      route: 'app_cabinet_certificate_document_list', prefix: 'app_cabinet_certificate_document' },
    { key: 'chem',      label: 'Химстойкость', icon: 'bi-droplet',
      route: 'app_cabinet_coating_coating_by_substance', prefix: 'app_cabinet_coating_coating_by_substance' },
] %}
{# Активна вкладка с САМЫМ длинным совпавшим префиксом: иначе by-substance
   (префикс «…coating_coating_by_substance») подсветил бы и «Покрытия»
   (префикс «…coating_coating»). Длину лучшего совпадения берём одним
   выражением — {% set %} внутри {% for %} в Twig наружу не вытекает. #}
{% set matchedPrefixLengths = nav_items|filter(item => current_route starts with item.prefix)|map(item => item.prefix|length) %}
{% set matchLen = matchedPrefixLengths is empty ? 0 : max(matchedPrefixLengths) %}
{% set nav_items = nav_items|map(item => item|merge({
    active: (current_route starts with item.prefix) and (item.prefix|length == matchLen)
})) %}

{# Десктоп-сайдбар — навигация для авторизованных (d-none d-lg-flex). #}
{% if app.user %}
    {% include '_shell/_sidebar.html.twig' %}
{% endif %}

{# Основной контент. На десктопе (lg+) смещается вправо под сайдбар (см. app-shell.css). #}
<div class="app-content">
{% block header %}
    {# Шапка-карточка с логотипом — только на мобиле (.app-header-mobile);
       на десктопе бренд — в сайдбаре. #}
    <header class="blog-header app-header-mobile py-3">
        <div class="container-fluid">
            <div class="p-3 rounded-3 bg-body-tertiary d-flex align-items-center justify-content-center blog-header-bar">
                <a class="blog-header-logo text-body text-decoration-none"
                   href="{{ path('app_homepage') }}">
                    {{ app_name }}
                </a>
            </div>
        </div>
    </header>
{% endblock %}

{# Flash-тосты. data-controller="flash" — авто-скрытие (success 5с, прочее 10с).
   Иконка-бокс по типу + сообщение; borderless (surface + тень). #}
{% set flashIcons = {success: 'check-circle', danger: 'exclamation-octagon', error: 'exclamation-octagon', warning: 'exclamation-triangle', info: 'info-circle'} %}
{% set flashKinds = {success: 'ok', danger: 'err', error: 'err', warning: 'warn', info: 'info'} %}
<div class="flash-messages" data-controller="flash">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-toast flash-toast--{{ flashKinds[type] ?? 'info' }}" role="alert"
                 data-flash-target="toast" data-flash-type="{{ type }}">
                <span class="flash-toast-ic"><i class="bi bi-{{ flashIcons[type] ?? 'info-circle' }}"></i></span>
                <div class="flash-toast-body">{{ message }}</div>
                <button type="button" class="flash-toast-x" aria-label="Закрыть"
                        data-action="click->flash#dismiss"><i class="bi bi-x-lg"></i></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% if is_granted('IS_IMPERSONATOR') %}
        <div class="alert alert-warning alert-dismissible fade show shadow" role="alert">
            Вы находитесь в режиме исполнения роли
            <a href="{{ impersonation_exit_path(path('app_homepage')) }}" class="alert-link">Выйти из режима</a>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}
</div>

{# Шаблон клиентского flash-тоста (клонируется в assets/flash_toast.js — чтобы не
   дублировать разметку тоста в JS). Иконка/тип-класс/текст проставляются в JS. #}
<template id="tpl-flash-toast">
    <div class="flash-toast" role="alert">
        <span class="flash-toast-ic"><i class="bi"></i></span>
        <div class="flash-toast-body"></div>
        <button type="button" class="flash-toast-x" aria-label="Закрыть"><i class="bi bi-x-lg"></i></button>
    </div>
</template>

<main class="container-fluid py-4">
    {% block body %}{% endblock %}
</main>

{# Кнопка "Наверх" — target контроллера back-to-top (показ по скроллу, клик = вверх). #}
<button class="btn btn-primary back-to-top shadow" title="Наверх"
        data-back-to-top-target="button"
        data-action="click->back-to-top#top">
    <i class="bi bi-arrow-up"></i>
</button>

{# Футер убран: © выглядел неуместно, «Наверх» дублировал плавающую кнопку.
   Блок оставлен пустым — страницы могут переопределить при необходимости. #}
{% block footer %}{% endblock %}
</div>{# /.app-content #}

{# «Ещё» (offcanvas) и нижняя таб-панель — только для авторизованных. Гостям
   (лендинг/вход/регистрация) навигация не нужна — страницы самодостаточны. #}
{% if app.user %}
    {# offcanvas «Ещё»: аккаунт, тема, админ-справочники. Первичная навигация
       (Покрытия/Системы/Документы) — в таб-панели/сайдбаре. Открывается вкладкой
       «Ещё» таб-панели. data-controller="offcanvas-autoclose" — закрытие по клику. #}
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mainMenu" aria-labelledby="mainMenuLabel"
         data-controller="offcanvas-autoclose">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="mainMenuLabel">Ещё</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>
        </div>
        <div class="offcanvas-body p-3 d-flex flex-column gap-2">
            {# Пользователь. #}
            <div class="p-3 rounded-3 bg-body-tertiary">
                <div class="d-flex align-items-center">
                    <div class="user-avatar me-3"><i class="bi bi-person"></i></div>
                    <div class="user-email">{{ app.user.email }}</div>
                </div>
            </div>

            {# Разделы — те же, что в нижней таб-панели: делаем «Ещё» полноценным
               меню (паритет с десктоп-сайдбаром). #}
            <div class="p-3 rounded-3 bg-body-tertiary">
                <div class="list-group list-group-flush">
                    {% for item in nav_items %}
                        <a href="{{ path(item.route) }}"
                           class="list-group-item list-group-item-action{{ item.active ? ' active' : '' }}"
                           data-action="click->offcanvas-autoclose#close">
                            <i class="bi {{ item.icon }} me-2"></i>{{ item.label }}
                        </a>
                    {% endfor %}
                </div>
            </div>

            {# Администрирование — только админ. #}
            {% if is_granted('ROLE_ADMIN') %}
                <div class="p-3 rounded-3 bg-body-tertiary">
                    <div class="px-2 py-1 text-body-secondary fw-semibold small text-uppercase">Администрирование</div>
                    <div class="list-group list-group-flush">
                        <a href="{{ path('app_cabinet_surface_treatment_list') }}" class="list-group-item list-group-item-action"
                           data-action="click->offcanvas-autoclose#close">
                            <i class="bi bi-chevron-bar-contract me-2"></i>Подготовка поверхности
                        </a>
                        <a href="{{ path('app_cabinet_coating_manufacturer_list') }}" class="list-group-item list-group-item-action"
                           data-action="click->offcanvas-autoclose#close">
                            <i class="bi bi-building me-2"></i>Производители
                        </a>
                        <a href="{{ path('app_cabinet_chemical_resistance_substance_list') }}" class="list-group-item list-group-item-action"
                           data-action="click->offcanvas-autoclose#close">
                            <i class="bi bi-eyedropper me-2"></i>Вещества
                        </a>
                    </div>
                </div>
            {% endif %}

            {# Аккаунт. #}
            <div class="p-3 rounded-3 bg-body-tertiary">
                <div class="list-group list-group-flush">
                    <a href="{{ path('app_cabinet') }}" class="list-group-item list-group-item-action"
                       data-action="click->offcanvas-autoclose#close">
                        <i class="bi bi-person-circle me-2"></i>Личный кабинет
                    </a>
                    <a href="{{ path('app_logout') }}" class="list-group-item list-group-item-action text-danger"
                       data-action="click->offcanvas-autoclose#close">
                        <i class="bi bi-box-arrow-right me-2"></i>Выйти из аккаунта
                    </a>
                </div>
            </div>

            {# Тема. НЕ .list-group-item — клик не закрывает шторку. #}
            <div class="p-3 rounded-3 bg-body-tertiary">
                <button type="button" class="btn btn-outline-secondary w-100"
                        id="themeToggle" aria-label="Переключить тему"
                        data-controller="theme-toggle"
                        data-action="click->theme-toggle#toggle">
                    <i class="bi bi-sun-fill me-2" data-theme-toggle-target="light"></i>
                    <i class="bi bi-moon-stars-fill me-2 d-none" data-theme-toggle-target="dark"></i>
                    Переключить тему
                </button>
            </div>

            {# Установка приложения — появляется, когда браузер предлагает установку. #}
            <div class="p-3 rounded-3 bg-body-tertiary">
                {% include '_shell/_install_button.html.twig' with { class: 'w-100' } %}
            </div>
        </div>
    </div>

    {% include '_shell/_bottom_nav.html.twig' %}
{% endif %}
</body>
</html>
