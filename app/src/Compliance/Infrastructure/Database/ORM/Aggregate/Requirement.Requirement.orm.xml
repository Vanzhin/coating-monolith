<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Compliance\Domain\Aggregate\Requirement\Requirement" table="compliance_requirement">
        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="name" type="string" length="255" column="name"/>
        <field name="type" type="string" length="32" column="type"
               enum-type="App\Compliance\Domain\Type\ComplianceType"/>
        <field name="positionIds" type="string_collection" column="position_ids"/>
        <field name="items" type="compliance_requirement_items" column="items"/>
        <field name="templateFileId" type="string" length="36" column="template_file_id" nullable="true"/>
        <field name="journalKind" column="journal_kind" length="32" nullable="true"
               enum-type="App\Compliance\Domain\Type\JournalKind"/>
        <field name="version" type="integer" column="version" version="true"/>
    </entity>

</doctrine-mapping>
