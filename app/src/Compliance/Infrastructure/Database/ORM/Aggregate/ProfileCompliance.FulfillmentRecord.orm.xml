<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Compliance\Domain\Aggregate\ProfileCompliance\FulfillmentRecord" table="compliance_fulfillment_record">
        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="obligationKey" type="string" length="1100" column="obligation_key"/>
        <field name="fulfilledAt" type="datetime_immutable" column="fulfilled_at"/>
        <field name="quantity" type="compliance_quantity" column="quantity" nullable="true"/>
        <field name="wearPercent" type="float" column="wear_percent" nullable="true"/>
        <field name="note" type="text" column="note" nullable="true"/>
        <field name="manualDueDate" type="datetime_immutable" column="manual_due_date" nullable="true"/>
        <field name="returnedQuantity" type="float" column="returned_quantity"/>
        <field name="documentId" type="string" length="36" column="document_id" nullable="true"/>

        <many-to-one field="profileCompliance"
                     target-entity="App\Compliance\Domain\Aggregate\ProfileCompliance\ProfileCompliance"
                     inversed-by="records" fetch="LAZY">
            <join-column name="profile_compliance_id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>

</doctrine-mapping>
