<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Compliance\Domain\Aggregate\WriteOffAct\WriteOffAct" table="compliance_writeoff_act">
        <id name="id" type="uuid" column="id">
            <generator strategy="NONE"/>
        </id>
        <field name="requirementId" type="string" length="64" column="requirement_id"/>
        <field name="organizationId" type="string" length="64" column="organization_id"/>
        <field name="status" type="string" length="16" column="status"
               enum-type="App\Compliance\Domain\Type\DocumentStatus"/>
        <field name="commission" type="compliance_writeoff_commission" column="commission" nullable="true"/>
        <field name="actNumber" type="string" length="64" column="act_number" nullable="true"/>
        <field name="actDate" type="datetime_immutable" column="act_date" nullable="true"/>
        <field name="orderNumber" type="string" length="64" column="order_number" nullable="true"/>
        <field name="orderDate" type="datetime_immutable" column="order_date" nullable="true"/>
        <field name="representativePosition" type="string" length="255" column="representative_position" nullable="true"/>
        <field name="representativeFio" type="string" length="255" column="representative_fio" nullable="true"/>
        <field name="scanFileId" type="string" length="64" column="scan_file_id" nullable="true"/>
        <field name="signedAt" type="datetime_immutable" column="signed_at" nullable="true"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>
        <field name="version" type="integer" column="version" version="true"/>

        <one-to-many field="lines"
                     target-entity="App\Compliance\Domain\Aggregate\WriteOffAct\WriteOffActLine"
                     mapped-by="writeOffAct" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>

</doctrine-mapping>
