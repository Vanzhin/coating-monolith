includes:
	# baseline: оставшиеся находки v2, которые не чистим (защитные is_array/instanceof, PHPUnit-тесты, property-типы).
	# Механические (compact/array_values/nullsafe) вычищены в коде, PHPDoc-производные сняты treatPhpDocTypesAsCertain.
	- phpstan-baseline.neon

parameters:
	level: 6
	paths:
		- ./src
		- ./tests
	# @var/PHPDoc-типы НЕ считаем железным фактом: гасит ложные "alreadyNarrowed/impossible" на защитных
	# проверках (Assert::notNull после /** @var X $u */ и т.п.) — код защитный, удалять его не надо.
	treatPhpDocTypesAsCertain: false
	# phpstan 2: checkGenericClassInNonGenericObjectType убран. Дженерик-типы не форсим — игнорим missingType.generics.
	ignoreErrors:
		-
			identifier: missingType.generics
