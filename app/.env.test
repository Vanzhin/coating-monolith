# Оверрайды для APP_ENV=test поверх каскада .env / .env.local.
# Дефолты всех переменных живут в app/.env.example (в CI копируется в app/.env,
# см. .github/workflows/tests.yml). Здесь только то, что должно быть тестовым.

KERNEL_CLASS='App\Shared\Infrastructure\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# Инфраструктура тестового окружения (docker-compose.test.yml).
# Локально можно перекрыть в .env.test.local (например, если БД пробрасывается на localhost).
DATABASE_URL="postgresql://app_test:app_test@test_db:5432/app_test?serverVersion=17&charset=utf8"
REDIS_HOST=test_redis

# auto_setup=1 — таблица messenger_messages создастся при первом обращении, без миграции.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1

# JWT passphrase для ключей, которые CI генерирует шагом `Generate JWT keypair`.
# Пути JWT_SECRET_KEY / JWT_PUBLIC_KEY наследуются из .env / .env.example.
JWT_PASSPHRASE=test
