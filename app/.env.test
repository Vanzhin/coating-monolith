# define your env variables for the test env here
KERNEL_CLASS='App\Shared\Infrastructure\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots

# Инфраструктура тестового окружения (docker-compose.test.yml).
# Локально можно перекрыть в .env.test.local (например, если БД пробрасывается на localhost).
DATABASE_URL="postgresql://app_test:app_test@test_db:5432/app_test?serverVersion=17&charset=utf8"
REDIS_HOST=test_redis

# auto_setup=1 — таблица messenger_messages создастся при первом обращении, без миграции.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1

# Пустые дефолты для всех env, которые резолвятся в services.yaml/packages/*.yaml.
# В тестах внешние интеграции (Telegram/Elastic/SMTP) не задействованы, поэтому важно
# только чтобы EnvVarProcessor не падал при компиляции контейнера или рендере twig.
APP_NAME=CoatingMonolithTest
LOG_TELEGRAM_BOT_KEY=
LOG_TELEGRAM_CHANNEL=
DEFAULT_FROM_ADDR=noreply@test.local
DEFAULT_FROM_NAME=Test
MAILER_DSN=null://null
JWT_PASSPHRASE=test
ELASTIC_DSN=http://localhost:9200
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
TELEGRAM_NOTIFICATION_BOT_TOKEN=
TELEGRAM_NOTIFICATION_BOT_USERNAME=
TELEGRAM_NOTIFICATION_BOT_SECRET=
TELEGRAM_NOTIFICATION_BOT_WEBHOOK=http://localhost/webhook
